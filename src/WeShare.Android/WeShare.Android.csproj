    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <ZLibResourceCompression>true</ZLibResourceCompression>
    <Nullable>enable</Nullable>
    <AndroidEnableSGen>true</AndroidEnableSGen>
    <AndroidSdkDirectory>D:\PROJECTS\WE SHARE\android-sdk</AndroidSdkDirectory>
