<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WeShare.UI.Views"
             xmlns:models="using:WeShare.Core.Models"
             xmlns:views="using:WeShare.UI.Views"
             x:Class="WeShare.UI.Views.MainView"
             x:DataType="views:MainView"
             FontFamily="Sora, Inter, Segoe UI Variable Display, sans-serif">

  <UserControl.Resources>
    <local:ProgressToWidthConverter x:Key="ProgressToWidthConverter"/>
    <local:FileSizeConverter x:Key="FileSizeConverter"/>
    <local:RadarPositionConverter x:Key="RadarPos"/>

    <!-- Dynamic Theme-Aware Brushes -->
    <SolidColorBrush x:Key="DeepSlateBrush" Color="{DynamicResource DeepSlate}"/>
    <SolidColorBrush x:Key="ElectricIndigoBrush" Color="{DynamicResource ElectricIndigo}"/>
    <SolidColorBrush x:Key="ElectricIndigoDimBrush" Color="{DynamicResource ElectricIndigoDim}"/>
    <SolidColorBrush x:Key="TealSuccessBrush" Color="{DynamicResource TealAccent}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondary}"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Sidebar Items -->
    <Style Selector="Button.SidebarItem">
      <Setter Property="Background"          Value="Transparent"/>
      <Setter Property="Padding"             Value="20,14"/>
      <Setter Property="Margin"              Value="0,2"/>
      <Setter Property="CornerRadius"        Value="8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.SidebarItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0AFFFFFF"/>
    </Style>
    <Style Selector="Button.SidebarItem.Active /template/ ContentPresenter">
      <Setter Property="Background"     Value="#156366f1"/>
      <Setter Property="BorderBrush"    Value="{StaticResource ElectricIndigoBrush}"/>
      <Setter Property="BorderThickness" Value="4,0,0,0"/>
    </Style>
    <Style Selector="Button.SidebarItem TextBlock">
       <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="FontSize" Value="13"/>
       <Setter Property="LetterSpacing" Value="0.5"/>
    </Style>
    <Style Selector="Button.SidebarItem.Active TextBlock">
       <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    </Style>
    <Style Selector="Button.SidebarItem Rectangle.IconTint">
       <Setter Property="Opacity" Value="0.6"/>
       <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Button.SidebarItem.Active Rectangle.IconTint">
       <Setter Property="Opacity" Value="1"/>
       <Setter Property="Fill" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- Glass Cards -->
    <Style Selector="Border.GlassCard">
        <Setter Property="Background" Value="{DynamicResource GlassBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="BoxShadow" Value="0 8 24 0 #0A000000"/>
    </Style>

    <!-- Buttons -->
    <Style Selector="Button.PrimaryBtn">
       <Setter Property="Background" Value="{StaticResource ElectricIndigoBrush}"/>
       <Setter Property="Foreground" Value="White"/>
       <Setter Property="Padding" Value="20,14"/>
       <Setter Property="CornerRadius" Value="12"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="FontSize" Value="13"/>
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Setter Property="Transitions">
          <Transitions>
             <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
             <BrushTransition Property="Background" Duration="0:0:0.1"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Button.PrimaryBtn:pointerover /template/ ContentPresenter">
       <Setter Property="Background" Value="{StaticResource ElectricIndigoDimBrush}"/>
       <Setter Property="RenderTransform" Value="scale(1.03)"/>
    </Style>
    <Style Selector="Button.PrimaryBtn:pressed">
       <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>

    <!-- Circular Action Buttons -->
    <Style Selector="Button.CircleAction">
       <Setter Property="Background" Value="{DynamicResource GlassBackgroundBrush}"/>
       <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
       <Setter Property="BorderThickness" Value="1"/>
       <Setter Property="Width" Value="120"/>
       <Setter Property="Height" Value="120"/>
       <Setter Property="Padding" Value="0"/>
       <Setter Property="CornerRadius" Value="60"/>
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Setter Property="HorizontalContentAlignment" Value="Center"/>
       <Setter Property="VerticalContentAlignment" Value="Center"/>
       <Setter Property="Template">
         <ControlTemplate>
           <Border x:Name="RootBorder"
                   Background="{TemplateBinding Background}"
                   BorderBrush="{TemplateBinding BorderBrush}"
                   BorderThickness="{TemplateBinding BorderThickness}"
                   CornerRadius="{TemplateBinding CornerRadius}"
                   ClipToBounds="True">
             <ContentPresenter x:Name="PART_ContentPresenter"
                               Content="{TemplateBinding Content}"
                               ContentTemplate="{TemplateBinding ContentTemplate}"
                               Padding="{TemplateBinding Padding}"
                               HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                               VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
           </Border>
         </ControlTemplate>
       </Setter>
       <Setter Property="Transitions">
          <Transitions>
             <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="QuarticEaseOut"/>
             <BrushTransition Property="Background" Duration="0:0:0.2"/>
          </Transitions>
       </Setter>
    </Style>

    <Style Selector="Button.CircleAction:pointerover">
       <Setter Property="Background" Value="#156366f1"/>
       <Setter Property="RenderTransform" Value="scale(1.1)"/>
    </Style>
    <Style Selector="Button.CircleAction:pressed">
       <Setter Property="RenderTransform" Value="scale(0.92)"/>
    </Style>

    <!-- Signal Panels -->
    <Style Selector="Grid.SignalPanel">
       <Setter Property="Opacity" Value="0"/>
       <Setter Property="ClipToBounds" Value="False"/>
       <Setter Property="Transitions">
          <Transitions>
             <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="QuarticEaseOut"/>
             <ThicknessTransition Property="Margin" Duration="0:0:0.5" Easing="QuarticEaseOut"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Grid.SignalPanel[IsVisible=True]">
       <Setter Property="Opacity" Value="1"/>
       <Setter Property="Margin" Value="48,32,48,48"/>
    </Style>
    <Style Selector="Grid.SignalPanel[IsVisible=False]">
       <Setter Property="Margin" Value="48,64,48,16"/>
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- GLOBAL BACKGROUND -->
    <Panel Background="{DynamicResource BaseBackgroundBrush}"/>

    <Grid ColumnDefinitions="280, *" x:Name="MainLayout">
      <!-- SIDEBAR -->
      <Border Grid.Column="0" x:Name="Sidebar" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto, *, Auto" Margin="0,48,0,32">

          <!-- Brand -->
          <StackPanel Grid.Row="0" Margin="32,0,32,48" Spacing="8">
             <StackPanel Orientation="Horizontal" Spacing="12">
                <Image Source="/Assets/logo.png" Width="32" Height="32" Stretch="Uniform" Opacity="1"/>
                <TextBlock Text="WE SHARE" FontSize="14" FontWeight="Bold" LetterSpacing="3"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                           FontFamily="Sora, sans-serif"/>
             </StackPanel>
             <Rectangle Height="1" Fill="{DynamicResource GlassBorderBrush}" Margin="0,16,0,0"/>
          </StackPanel>

          <!-- Navigation -->
          <StackPanel Grid.Row="1" Spacing="4">
            <Button Classes="SidebarItem" x:Name="NavHomeBtn" Click="NavHome_Click">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Rectangle Classes="IconTint" Width="18" Height="18">
                   <Rectangle.OpacityMask>
                      <ImageBrush Source="/Assets/Icons/HOME.png"/>
                   </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Text="HOME"/>
              </StackPanel>
            </Button>
            <Button Classes="SidebarItem" x:Name="NavFilesBtn" Click="NavFiles_Click">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Rectangle Classes="IconTint" Width="18" Height="18">
                   <Rectangle.OpacityMask>
                      <ImageBrush Source="/Assets/Icons/LIBRARY.png"/>
                   </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Text="LIBRARY"/>
              </StackPanel>
            </Button>
            <Button Classes="SidebarItem" x:Name="NavWebBtn" Click="NavMobile_Click">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Rectangle Classes="IconTint" Width="18" Height="18">
                   <Rectangle.OpacityMask>
                      <ImageBrush Source="/Assets/Icons/WEBSITE.png"/>
                   </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Text="WEB SHARING"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Bottom Status -->
          <StackPanel Grid.Row="2" Margin="24,0" Spacing="16">
            <Button Classes="SidebarItem" x:Name="NavSettBtn" Click="NavSettings_Click" Padding="8,8">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Rectangle Classes="IconTint" Width="18" Height="18">
                   <Rectangle.OpacityMask>
                      <ImageBrush Source="/Assets/Icons/SETTINGS.png"/>
                   </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Text="SETTINGS" FontSize="11"/>
              </StackPanel>
            </Button>
            <Border Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="16,14" CornerRadius="12">
               <StackPanel Spacing="6">
                  <TextBlock Text="DEVICE IDENTITY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"
                             LetterSpacing="2"/>
                  <TextBlock x:Name="SidebarDeviceName" Text="SOWMIYAN-S" FontSize="13"
                             FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
               </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- CONTENT AREA -->
      <Grid Grid.Column="1" RowDefinitions="Auto, *" x:Name="ContentArea">
        
        <!-- Activity Bar -->
        <Border x:Name="GlobalActivityBorder" IsVisible="False" Height="3" Background="Transparent" VerticalAlignment="Top" ZIndex="1000">
           <ProgressBar x:Name="GlobalProgressBar" IsIndeterminate="False" Height="3" Foreground="{StaticResource ElectricIndigoBrush}" Background="Transparent" BorderThickness="0"/>
        </Border>

        <!-- Header -->
        <Border Grid.Row="0" Height="100" Padding="48,0" Background="Transparent"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1">
           <Grid ColumnDefinitions="*, Auto">
              <StackPanel VerticalAlignment="Center" Spacing="4">
                 <TextBlock x:Name="PageTitle" Text="HOME" FontSize="26" FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}" LetterSpacing="1"/>
              </StackPanel>
           </Grid>
        </Border>

        <!-- Drag Overlay -->
        <Border x:Name="DragOverlay" IsVisible="False" Background="{DynamicResource BaseBackgroundBrush}" Opacity="0.9" ZIndex="5000">
           <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="32">
              <Border Width="160" Height="160" BorderBrush="{StaticResource ElectricIndigoBrush}" BorderThickness="2" CornerRadius="24">
                 <Rectangle Width="80" Height="80" Fill="{DynamicResource TextPrimary}">
                    <Rectangle.OpacityMask>
                       <ImageBrush Source="/Assets/Icons/SEND FILE.png"/>
                    </Rectangle.OpacityMask>
                 </Rectangle>
              </Border>
              <TextBlock Text="DROP TO SEND" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
           </StackPanel>
        </Border>

        <!-- Dynamic Content -->
        <Grid Grid.Row="1">
            
            <!-- Wizard Progress Indicator -->
            <StackPanel x:Name="SendStepWizard" IsVisible="False" Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" ZIndex="100">
               <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock x:Name="Step1Indicator" Text="1. SELECT FILES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ElectricIndigoBrush}"/>
                  <Rectangle Width="40" Height="1" Fill="{DynamicResource GlassBorderBrush}" VerticalAlignment="Center"/>
               </StackPanel>
               <TextBlock x:Name="Step2Indicator" Text="2. CHOOSE RECEIVER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>

          <!-- HOME PANEL -->
          <Grid x:Name="HomePanel" Classes="SignalPanel" VerticalAlignment="Center" ClipToBounds="False">
             <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="80" ClipToBounds="False">
                <!-- Send File Circle -->
                <StackPanel Spacing="32" ClipToBounds="False">
                    <Button Classes="CircleAction" Click="HomeSend_Click"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                       <Rectangle Width="60" Height="60" Fill="{DynamicResource TextPrimary}">
                          <Rectangle.OpacityMask>
                             <ImageBrush Source="/Assets/Icons/SEND FILE.png"/>
                          </Rectangle.OpacityMask>
                       </Rectangle>
                    </Button>
                   <TextBlock Text="SEND FILE" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" LetterSpacing="2"/>
                </StackPanel>

                <!-- Receive File Circle -->
                <StackPanel Spacing="32" ClipToBounds="False">
                   <Button Classes="CircleAction" Click="HomeReceive_Click"
                           HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                      <Rectangle Width="100" Height="100" Fill="{DynamicResource TextPrimary}">
                         <Rectangle.OpacityMask>
                            <ImageBrush Source="/Assets/Icons/RECEIVE FILE.png"/>
                         </Rectangle.OpacityMask>
                      </Rectangle>
                   </Button>
                   <TextBlock Text="RECEIVE FILE" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" LetterSpacing="2"/>
                </StackPanel>
             </StackPanel>
          </Grid>

          <!-- RECEIVE RADAR -->
          <Grid x:Name="ReceiveModePanel" IsVisible="False" Classes="SignalPanel">
             <Grid>
                <Panel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520" Height="520">
                   <!-- Ambient Glow -->
                   <Ellipse Width="400" Height="400">
                      <Ellipse.Fill>
                         <RadialGradientBrush Center="50%,50%" Radius="0.5">
                            <GradientStop Offset="0" Color="{StaticResource ElectricIndigo}"/>
                            <GradientStop Offset="1" Color="Transparent"/>
                         </RadialGradientBrush>
                      </Ellipse.Fill>
                      <Ellipse.Opacity>0.1</Ellipse.Opacity>
                   </Ellipse>
                   
                   <!-- Outer Ring -->
                   <Ellipse Width="520" Height="520" Stroke="{DynamicResource RadarRingBrush}" StrokeThickness="1" Opacity="0.5"/>
                   
                   <!-- Dashed Rings -->
                   <Ellipse Width="420" Height="420" Stroke="{DynamicResource GlassBorderBrush}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.3"/>
                   <Ellipse Width="180" Height="180" Stroke="{DynamicResource GlassBorderBrush}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.3"/>
                   
                   <!-- Sweep -->
                   <Border Width="520" Height="520" CornerRadius="260" Classes="RadarScan">
                      <Border.RenderTransform><RotateTransform/></Border.RenderTransform>
                      <Panel Width="520" Height="520">
                         <Path Data="M 0,0 L 260,0 A 260,260 0 0 0 212.9,-149.1 Z"
                               Fill="{StaticResource ElectricIndigoBrush}" Opacity="0.2">
                            <Path.RenderTransform>
                               <TranslateTransform X="260" Y="260"/>
                            </Path.RenderTransform>
                         </Path>
                         <Rectangle Width="260" Height="1" Fill="White" Opacity="0.5" 
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    StrokeDashArray="4,4"/>
                      </Panel>
                   </Border>

                   <!-- Center Hub with Pulse -->
                   <Ellipse Classes="RadarPulse" Width="100" Height="100" Fill="{StaticResource ElectricIndigoBrush}"/>
                   <Border Width="100" Height="100" Background="{StaticResource ElectricIndigoBrush}" CornerRadius="50" BoxShadow="0 0 50 0 #606366f1">
                      <Rectangle Width="44" Height="44" Fill="White">
                         <Rectangle.OpacityMask>
                            <ImageBrush Source="/Assets/Icons/SCAN.png"/>
                         </Rectangle.OpacityMask>
                      </Rectangle>
                   </Border>
                </Panel>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,48" Spacing="24">
                   <TextBlock Text="READY TO RECEIVE" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" LetterSpacing="4" HorizontalAlignment="Center"/>
                   <TextBlock Text="Visible to devices on your network" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Opacity="0.7"/>
                   <Button Classes="PrimaryBtn" Content="CANCEL BROADCAST" Click="NavHome_Click" Width="200" Margin="0,16,0,0"/>
                </StackPanel>
             </Grid>
          </Grid>

          <!-- SEND STEP 1: Files -->
          <Grid x:Name="SendFilesPanel" IsVisible="False" Classes="SignalPanel" RowDefinitions="*, Auto" DragDrop.AllowDrop="True">
             <ScrollViewer Grid.Row="0">
               <StackPanel Spacing="32">
                  <Grid ColumnDefinitions="*, Auto">
                     <TextBlock Text="QUEUE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                     <Button Grid.Column="1" Classes="PrimaryBtn" Content="+ ADD FILES" Click="BrowseFiles_Click"/>
                  </Grid>

                  <!-- File List -->
                  <Border Classes="GlassCard" MinHeight="340">
                     <Grid>
                        <ItemsControl x:Name="SendQueueList">
                           <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="views:QueueItem">
                                 <Border BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="24,18">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                       <Rectangle Classes="IconTint" Width="18" Height="18" Margin="0,0,20,0">
                                          <Rectangle.OpacityMask>
                                             <ImageBrush Source="/Assets/Icons/LIBRARY.png"/>
                                          </Rectangle.OpacityMask>
                                       </Rectangle>
                                       <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                      FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                          <TextBlock Text="{Binding Size, Converter={StaticResource FileSizeConverter}}"
                                                      FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                       </StackPanel>
                                       <Button Grid.Column="2" Content="X" Click="RemoveFromQueue_Click"
                                               Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontSize="14"/>
                                    </Grid>
                                 </Border>
                              </DataTemplate>
                           </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="QueueEmptyLabel" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Opacity="0.4" Spacing="16">
                           <Rectangle Classes="IconTint" Width="48" Height="48" Opacity="0.3">
                              <Rectangle.OpacityMask>
                                 <ImageBrush Source="/Assets/Icons/LIBRARY.png"/>
                              </Rectangle.OpacityMask>
                           </Rectangle>
                           <TextBlock Text="SELECT FILES TO BEGIN" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                        </StackPanel>
                     </Grid>
                  </Border>

                  <!-- Mini Progress -->
                  <Border x:Name="SendProgressBorder" IsVisible="False" Classes="GlassCard" Background="#206366f1" Padding="28">
                     <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*, Auto">
                           <TextBlock x:Name="SendProgressFile" Text="Processing..." FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14"/>
                           <TextBlock Grid.Column="1" x:Name="SendProgressPct" Text="0%" FontWeight="Bold" Foreground="{StaticResource ElectricIndigoBrush}"/>
                        </Grid>
                        <ProgressBar x:Name="SendProgressBar" Height="6" CornerRadius="3"
                                     Foreground="{StaticResource ElectricIndigoBrush}" Background="#20FFFFFF"/>
                        <TextBlock x:Name="SendProgressSpeed" Text="0 MB/s" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                     </StackPanel>
                  </Border>
               </StackPanel>
             </ScrollViewer>

             <!-- Footer -->
             <Border Grid.Row="1" Margin="0,24,0,0" x:Name="SendFooter" IsVisible="False"
                     Classes="GlassCard" Background="{DynamicResource CardBackgroundBrush}" Padding="24,20">
                <Grid ColumnDefinitions="*, Auto">
                   <StackPanel VerticalAlignment="Center">
                      <TextBlock x:Name="SendSummaryText" Text="0 files selected" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="14"/>
                      <TextBlock Text="Ready for next step" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                   </StackPanel>
                   <Button Grid.Column="1" Classes="PrimaryBtn" Content="CHOOSE RECEIVER ->"
                           Width="220" Click="NavSendDiscovery_Click"/>
                </Grid>
             </Border>
          </Grid>

          <!-- SEND STEP 2: Discovery (Immersive Radar) -->
          <Grid x:Name="SendDiscoveryPanel" IsVisible="False" Classes="SignalPanel">
             <Grid>
                <Panel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520" Height="520" ClipToBounds="False">
                   <!-- Ambient Glow -->
                   <Ellipse Width="400" Height="400">
                      <Ellipse.Fill>
                         <RadialGradientBrush Center="50%,50%" Radius="0.5">
                            <GradientStop Offset="0" Color="{StaticResource ElectricIndigo}"/>
                            <GradientStop Offset="1" Color="Transparent"/>
                         </RadialGradientBrush>
                      </Ellipse.Fill>
                      <Ellipse.Opacity>0.1</Ellipse.Opacity>
                   </Ellipse>

                   <!-- Rings -->
                   <Ellipse Width="520" Height="520" Stroke="{DynamicResource RadarRingBrush}" StrokeThickness="1" Opacity="0.5"/>
                   <Ellipse Width="420" Height="420" Stroke="{DynamicResource GlassBorderBrush}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.3"/>
                   <Ellipse Width="180" Height="180" Stroke="{DynamicResource GlassBorderBrush}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.3"/>
                   
                   <!-- Sweep -->
                   <Border Width="520" Height="520" CornerRadius="260" Classes="RadarScan">
                      <Border.RenderTransform><RotateTransform/></Border.RenderTransform>
                      <Panel Width="520" Height="520">
                         <Path Data="M 0,0 L 260,0 A 260,260 0 0 0 212.9,-149.1 Z"
                               Fill="{StaticResource ElectricIndigoBrush}" Opacity="0.2">
                            <Path.RenderTransform>
                               <TranslateTransform X="260" Y="260"/>
                            </Path.RenderTransform>
                         </Path>
                         <Rectangle Width="260" Height="1" Fill="White" Opacity="0.5" 
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    StrokeDashArray="4,4"/>
                      </Panel>
                   </Border>

                   <!-- Center Hub -->
                   <Ellipse Classes="RadarPulse" Width="90" Height="90" Fill="{StaticResource ElectricIndigoBrush}"/>
                   <Border Width="90" Height="90" Background="{StaticResource ElectricIndigoBrush}" CornerRadius="45" BoxShadow="0 0 50 0 #606366f1">
                      <Rectangle Width="36" Height="36" Fill="White">
                         <Rectangle.OpacityMask>
                            <ImageBrush Source="/Assets/Icons/SCAN.png"/>
                         </Rectangle.OpacityMask>
                      </Rectangle>
                   </Border>

                    <!-- Empty State Hint -->
                    <StackPanel x:Name="RadarEmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Opacity="0.5">
                       <TextBlock Text="LOOKING FOR DEVICES..." FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="4" HorizontalAlignment="Center"/>
                       <TextBlock Text="Ensure other devices are on the same WiFi" FontSize="9" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                    </StackPanel>

                   <!-- Discovered Devices on Radar Rings -->
                   <ItemsControl ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=views:MainView}}">
                      <ItemsControl.ItemsPanel>
                         <ItemsPanelTemplate>
                            <Canvas Width="520" Height="520" Background="Transparent"/>
                         </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                         <DataTemplate x:DataType="models:DeviceModel">
                            <Button Click="SendFile_Click" Background="Transparent" Padding="0" BorderThickness="0" ClipToBounds="False">
                               <Button.Styles>
                                  <Style Selector="Button:pointerover /template/ ContentPresenter">
                                     <Setter Property="Background" Value="Transparent"/>
                                  </Style>
                               </Button.Styles>
                               <StackPanel Spacing="10" HorizontalAlignment="Center" ClipToBounds="False">
                                  <Border Classes="DeviceMarker" Width="64" Height="64" Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{StaticResource ElectricIndigoBrush}" BorderThickness="2" CornerRadius="32" BoxShadow="0 8 25 0 #30000000">
                                     <Rectangle Width="28" Height="28" Fill="{StaticResource ElectricIndigoBrush}">
                                        <Rectangle.OpacityMask>
                                           <ImageBrush Source="/Assets/Icons/SEND FILE.png"/>
                                        </Rectangle.OpacityMask>
                                     </Rectangle>
                                  </Border>
                                  <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                               </StackPanel>
                            </Button>
                         </DataTemplate>
                      </ItemsControl.ItemTemplate>
                      <ItemsControl.Styles>
                         <Style Selector="ContentPresenter">
                            <Setter Property="Canvas.Left">
                               <MultiBinding Converter="{StaticResource RadarPos}">
                                  <Binding />
                                  <Binding Path="Devices" RelativeSource="{RelativeSource AncestorType=views:MainView}"/>
                                  <Binding Source="X"/>
                               </MultiBinding>
                            </Setter>
                            <Setter Property="Canvas.Top">
                               <MultiBinding Converter="{StaticResource RadarPos}">
                                  <Binding />
                                  <Binding Path="Devices" RelativeSource="{RelativeSource AncestorType=views:MainView}"/>
                                  <Binding Source="Y"/>
                               </MultiBinding>
                            </Setter>
                            <Setter Property="Transitions">
                               <Transitions>
                                  <DoubleTransition Property="Canvas.Left" Duration="0:0:1.5" Easing="QuarticEaseOut"/>
                                  <DoubleTransition Property="Canvas.Top" Duration="0:0:1.5" Easing="QuarticEaseOut"/>
                               </Transitions>
                            </Setter>
                         </Style>
                      </ItemsControl.Styles>
                   </ItemsControl>
                </Panel>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,32" Spacing="24">
                   <TextBlock Text="SCANNING FOR DEVICES" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ElectricIndigoBrush}" LetterSpacing="6" HorizontalAlignment="Center" Opacity="0.9"/>
                   <Button Content="BACK TO QUEUE" Click="HomeSend_Click" Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontSize="11" HorizontalAlignment="Center" Padding="16"/>
                </StackPanel>
             </Grid>
          </Grid>

          <!-- LIBRARY PANEL -->
          <Grid x:Name="FilesPanel" IsVisible="False" Classes="SignalPanel">
             <ScrollViewer>
               <StackPanel Spacing="24">
                  <Grid ColumnDefinitions="*, Auto, Auto">
                     <TextBlock Text="RECEIVED FILES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2" VerticalAlignment="Center"/>
                     <TextBox Grid.Column="1" Width="200" x:Name="FileSearchBox" 
                                Watermark="Filter..." Background="{DynamicResource GlassBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}"
                                Padding="12,8" FontSize="12" Margin="16,0" CornerRadius="8"
                                TextChanged="FileSearch_TextChanged"/>
                     <Button Grid.Column="2" Classes="PrimaryBtn" Content="OPEN FOLDER" Click="OpenDownloadFolder_Click"/>
                  </Grid>

                  <ItemsControl x:Name="ReceivedFilesList"
                                ItemsSource="{Binding ReceivedFiles, RelativeSource={RelativeSource AncestorType=views:MainView}}">
                     <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:FileTransferState">
                           <Border Classes="GlassCard" Padding="20" Margin="0,0,0,12">
                              <Grid ColumnDefinitions="Auto, *, Auto">
                                 <Border Width="44" Height="44" Background="{DynamicResource GlassBackgroundBrush}" CornerRadius="10">
                                    <Rectangle Classes="IconTint" Width="20" Height="20">
                                       <Rectangle.OpacityMask>
                                          <ImageBrush Source="/Assets/Icons/LIBRARY.png"/>
                                       </Rectangle.OpacityMask>
                                    </Rectangle>
                                 </Border>
                                 <StackPanel Grid.Column="1" Margin="20,0">
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14"/>
                                    <TextBlock Text="{Binding FileSizeDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                 </StackPanel>
                                 <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                                    <Button Content="VIEW" Click="OpenFileInList_Click" Tag="{Binding}"
                                            Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11" Padding="16,8" CornerRadius="6"/>
                                    <Button Content="DEL" Click="DeleteFileInList_Click" Tag="{Binding}"
                                            Background="Transparent" Foreground="#FF5555" FontSize="11"/>
                                 </StackPanel>
                              </Grid>
                           </Border>
                        </DataTemplate>
                     </ItemsControl.ItemTemplate>
                  </ItemsControl>
               </StackPanel>
             </ScrollViewer>
          </Grid>

          <!-- ACTIVE RECEIVE PANEL -->
          <Grid x:Name="ReceivePanel" IsVisible="False" Classes="SignalPanel">
             <StackPanel Spacing="24">
                <TextBlock Text="ACTIVE TRANSFERS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                
                <Border Classes="GlassCard" MinHeight="200">
                   <Grid>
                      <ListBox x:Name="IncomingList" Background="Transparent" BorderThickness="0">
                         <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:FileTransferState">
                               <Border BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="24,18">
                                  <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto">
                                     <Border Grid.RowSpan="2" Width="40" Height="40" Background="{DynamicResource GlassBackgroundBrush}" CornerRadius="8" Margin="0,0,20,0">
                                        <Rectangle Classes="IconTint" Width="18" Height="18">
                                           <Rectangle.OpacityMask>
                                              <ImageBrush Source="/Assets/Icons/RECEIVE FILE.png"/>
                                           </Rectangle.OpacityMask>
                                        </Rectangle>
                                     </Border>
                                     <TextBlock Grid.Column="1" Text="{Binding FileName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14"/>
                                     <TextBlock Grid.Column="2" Text="{Binding ProgressPercentage, StringFormat=\{0:F0\}%}" Foreground="{StaticResource ElectricIndigoBrush}" FontWeight="Bold"/>
                                     
                                     <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="4" Margin="0,12,0,0"
                                                  Value="{Binding ProgressPercentage}" Foreground="{StaticResource ElectricIndigoBrush}" Background="#10FFFFFF" CornerRadius="2"/>
                                  </Grid>
                               </Border>
                            </DataTemplate>
                         </ListBox.ItemTemplate>
                      </ListBox>
                      
                      <StackPanel x:Name="RecvEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4" Spacing="16">
                         <Rectangle Classes="IconTint" Width="48" Height="48" Opacity="0.3">
                            <Rectangle.OpacityMask>
                               <ImageBrush Source="/Assets/Icons/RECEIVE FILE.png"/>
                            </Rectangle.OpacityMask>
                         </Rectangle>
                         <TextBlock Text="NO ACTIVE TRANSFERS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                      </StackPanel>
                   </Grid>
                </Border>
             </StackPanel>
          </Grid>

          <!-- SETTINGS PANEL -->
          <Grid x:Name="SettingsPanel" IsVisible="False" Classes="SignalPanel">
             <StackPanel Spacing="32" MaxWidth="600" HorizontalAlignment="Left">
                <Border Classes="GlassCard" Padding="32">
                   <StackPanel Spacing="32">
                      <StackPanel Spacing="12">
                         <TextBlock Text="NAME ON NETWORK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                         <TextBox x:Name="SettingsDeviceName" Background="{DynamicResource GlassBackgroundBrush}"
                                  BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}" Padding="16"
                                  CornerRadius="12" Foreground="{DynamicResource TextPrimary}" FontSize="14"/>
                      </StackPanel>

                      <StackPanel Spacing="12">
                         <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                         <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="DARK THEME" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                            <ToggleSwitch Grid.Column="1" x:Name="ThemeToggle" IsChecked="True" OffContent="" OnContent="" IsCheckedChanged="ThemeSwitch_Changed"/>
                         </Grid>
                      </StackPanel>
                      
                      <StackPanel Spacing="12">
                         <TextBlock Text="DOWNLOAD DIRECTORY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                         <Grid ColumnDefinitions="*, Auto">
                            <TextBlock x:Name="SettingsSaveLocationLabel" Text="..."
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" FontSize="13"/>
                            <Button Grid.Column="1" Content="BROWSE" Click="ChangeSaveLocation_Click"
                                    Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="16,10" CornerRadius="8" Margin="16,0,0,0"/>
                         </Grid>
                      </StackPanel>

                      <StackPanel Spacing="12">
                         <TextBlock Text="WIFI HOTSPOT NAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                         <TextBox x:Name="HotspotNameInput" Text="WeShare-Direct" Background="{DynamicResource GlassBackgroundBrush}"
                                  BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}" Padding="16"
                                  CornerRadius="12" Foreground="{DynamicResource TextPrimary}" FontSize="14"/>
                      </StackPanel>
                   </StackPanel>
                </Border>
             </StackPanel>
          </Grid>

          <!-- WEB SHARING PANEL -->
          <Grid x:Name="MobileConnectPanel" IsVisible="False" Classes="SignalPanel" ColumnDefinitions="*, 400">
             <StackPanel Grid.Column="0" Spacing="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="FAST SYNC" FontSize="12" FontWeight="Bold" LetterSpacing="4"
                           Foreground="{StaticResource ElectricIndigoBrush}" HorizontalAlignment="Center"/>
                
                <Border Width="260" Height="260" Background="White" Padding="16" CornerRadius="20" BoxShadow="0 10 40 0 #40000000">
                   <Image x:Name="BigQrCode" Stretch="Uniform"/>
                </Border>

                <StackPanel Spacing="12" HorizontalAlignment="Center">
                   <TextBlock x:Name="ConnectUrlText" Text="http://weshare.local:8080" FontSize="20" FontWeight="Bold" 
                              Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                   <TextBlock x:Name="ConnectIpText" Text="..." FontSize="12" 
                              Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>
                
                <Button Classes="PrimaryBtn" Content="COPY ACCESS LINK" Click="CopyUrl_Click" Width="200" HorizontalAlignment="Center"/>
             </StackPanel>

             <!-- Secondary Actions -->
             <Border Grid.Column="1" Classes="GlassCard" Background="{DynamicResource CardBackgroundBrush}" Margin="24,0,0,0" Padding="32">
                <StackPanel Spacing="32">
                   <TextBlock Text="WIFI HOTSPOT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                   
                   <Button Classes="PrimaryBtn" Content="CREATE HOTSPOT" Click="StartHotspot_Click" HorizontalAlignment="Stretch"/>

                   <Border x:Name="HotspotInfoPanel" IsVisible="False" Background="{DynamicResource GlassBackgroundBrush}" CornerRadius="12" Padding="20">
                      <StackPanel Spacing="16">
                         <StackPanel Spacing="4">
                            <TextBlock Text="NETWORK" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="HotspotNameText" Text="..." FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                         </StackPanel>
                         <StackPanel Spacing="4">
                            <TextBlock Text="PASSWORD" FontSize="9" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="HotspotPassText" Text="..." FontSize="14" FontWeight="Bold" Foreground="{StaticResource ElectricIndigoBrush}"/>
                         </StackPanel>
                      </StackPanel>
                   </Border>

                   <Rectangle Height="1" Fill="{DynamicResource GlassBorderBrush}"/>
                   
                   <StackPanel Spacing="16">
                      <TextBlock Text="NETWORK FIX" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                      <TextBlock Text="Grant firewall access if phone cannot connect." 
                                 FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" Opacity="0.8"/>
                      <Button Content="PATCH FIREWALL (ADMIN)" Click="FixFirewall_Click" 
                              Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch" Padding="12" FontSize="10" CornerRadius="8"/>
                   </StackPanel>
                </StackPanel>
             </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- MOBILE NAVIGATION -->
    <Border Height="80" VerticalAlignment="Bottom" x:Name="BottomNav" IsVisible="False" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0">
       <Grid ColumnDefinitions="*, *, *">
          <Button Grid.Column="0" Click="NavHome_Click" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
             <Rectangle Classes="IconTint" Width="24" Height="24" HorizontalAlignment="Center">
                <Rectangle.OpacityMask>
                   <ImageBrush Source="/Assets/Icons/HOME.png"/>
                </Rectangle.OpacityMask>
             </Rectangle>
          </Button>
          <Button Grid.Column="1" Click="HomeReceive_Click" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
             <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource ElectricIndigoBrush}">
                <Rectangle Width="24" Height="24" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                   <Rectangle.OpacityMask>
                      <ImageBrush Source="/Assets/Icons/RECEIVE FILE.png"/>
                   </Rectangle.OpacityMask>
                </Rectangle>
             </Border>
          </Button>
          <Button Grid.Column="2" Click="NavFiles_Click" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
             <Rectangle Classes="IconTint" Width="24" Height="24" HorizontalAlignment="Center">
                <Rectangle.OpacityMask>
                   <ImageBrush Source="/Assets/Icons/LIBRARY.png"/>
                </Rectangle.OpacityMask>
             </Rectangle>
          </Button>
       </Grid>
    </Border>

    <!-- SPLASH -->
    <Grid x:Name="SplashGrid" Background="{DynamicResource BaseBackgroundBrush}" ZIndex="5000">
       <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="32">
          <Image Source="/Assets/logo.png" Width="80" Height="80" Stretch="Uniform"/>
          <TextBlock Text="WE SHARE" FontSize="22" FontWeight="Bold" LetterSpacing="6" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
          <ProgressBar IsIndeterminate="True" Width="140" Height="2" Foreground="{StaticResource ElectricIndigoBrush}" Background="{DynamicResource GlassBackgroundBrush}" BorderThickness="0"/>
       </StackPanel>
    </Grid>

    <!-- REQUEST OVERLAY -->
    <Border x:Name="AcceptRejectPanel" IsVisible="False" ZIndex="6000"
            VerticalAlignment="Center" HorizontalAlignment="Center" 
            Width="420" Padding="32" CornerRadius="24"
            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{StaticResource ElectricIndigoBrush}" BorderThickness="2"
            BoxShadow="0 20 60 0 #80000000">
       <Grid RowDefinitions="Auto, Auto">
          <StackPanel Spacing="24">
             <TextBlock Text="INCOMING REQUEST" FontSize="11" FontWeight="Bold" LetterSpacing="3" 
                        Foreground="{StaticResource ElectricIndigoBrush}"/>
             <StackPanel Spacing="6">
                <TextBlock x:Name="IncomingFileName" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="IncomingPeerName" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock x:Name="IncomingFileSize" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
             </StackPanel>
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="*, 16, *" Margin="0,40,0,0">
             <Button Grid.Column="0" Content="REJECT" Click="RejectTransfer_Click" 
                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16"
                     Background="Transparent" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Foreground="{DynamicResource TextSecondary}" CornerRadius="12"/>
             <Button Grid.Column="2" Classes="PrimaryBtn" Content="ACCEPT" Click="AcceptTransfer_Click" 
                     HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16"/>
          </Grid>
       </Grid>
    </Border>

     <!-- TOAST -->
     <Border x:Name="ToastBorder" IsVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="48" Padding="16,10" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{StaticResource ElectricIndigoBrush}" BorderThickness="1" CornerRadius="16" BoxShadow="0 8 24 0 #40000000">
        <Grid ColumnDefinitions="Auto, *">
             <Border Width="4" Height="20" Background="{StaticResource ElectricIndigoBrush}" CornerRadius="2" VerticalAlignment="Center"/>
            <TextBlock x:Name="ToastMessage" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="8,0,0,0"/>
        </Grid>
     </Border>

  </Grid>
</UserControl>
