<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WeShare.UI.Views"
             xmlns:models="using:WeShare.Core.Models"
             xmlns:views="using:WeShare.UI.Views"
             xmlns:controls="clr-namespace:WeShare.UI.Controls"
             x:Class="WeShare.UI.Views.MainView"
             x:DataType="views:MainView"
             FontFamily="CircularSp, Inter, Plus Jakarta Sans, Segoe UI, sans-serif"
             Background="#090A0F">

  <UserControl.Resources>
    <local:ProgressToWidthConverter x:Key="ProgressToWidthConverter"/>
    <local:FileSizeConverter x:Key="FileSizeConverter"/>
    <local:RadarPositionConverter x:Key="RadarPos"/>
    <local:DeviceTypeToIconConverter x:Key="DeviceTypeToIconConverter"/>

    <!-- Obsidian Violet Theme Brushes -->
    <SolidColorBrush x:Key="BrandVioletBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="BrandVioletHoverBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="BrandVioletDimBrush" Color="#6D28D9"/>
    <SolidColorBrush x:Key="BaseBackgroundBrush" Color="#090A0F"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#11131C"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#161824"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1C1F2E"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#222638"/>
    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#11131C"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    
    <!-- Compatibility Aliases -->
    <SolidColorBrush x:Key="ObsidianGreenBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="ObsidianGreenHoverBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="ObsidianGreenPressedBrush" Color="#6D28D9"/>
    <SolidColorBrush x:Key="ElectricIndigoBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="ElectricIndigoDimBrush" Color="#6D28D9"/>
    <SolidColorBrush x:Key="TealSuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="DeepSlateBrush" Color="#090A0F"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Sidebar Navigation Item -->
    <Style Selector="Button.SidebarItem">
      <Setter Property="Background"          Value="Transparent"/>
      <Setter Property="Padding"             Value="16,10"/>
      <Setter Property="Margin"              Value="8,2"/>
      <Setter Property="CornerRadius"        Value="4"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.SidebarItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#161824"/>
    </Style>
    <Style Selector="Button.SidebarItem.Active /template/ ContentPresenter">
      <Setter Property="Background"     Value="#1C1F2E"/>
    </Style>
    <Style Selector="Button.SidebarItem TextBlock">
       <Setter Property="Foreground" Value="#B3B3B3"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="FontSize" Value="13"/>
       <Setter Property="LetterSpacing" Value="0.3"/>
    </Style>
    <Style Selector="Button.SidebarItem:pointerover TextBlock">
       <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.SidebarItem.Active TextBlock">
       <Setter Property="Foreground" Value="#FFFFFF"/>
       <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.SidebarItem Rectangle.IconTint">
       <Setter Property="Opacity" Value="0.6"/>
       <Setter Property="Fill" Value="#B3B3B3"/>
    </Style>
    <Style Selector="Button.SidebarItem:pointerover Rectangle.IconTint">
       <Setter Property="Opacity" Value="1"/>
       <Setter Property="Fill" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.SidebarItem.Active Rectangle.IconTint">
       <Setter Property="Opacity" Value="1"/>
       <Setter Property="Fill" Value="#7C3AED"/>
    </Style>

    <!-- Obsidian Violet Glassmorphic Card (Acrylic Glass & Glowing Borders) -->
    <Style Selector="Border.GlassCard">
        <Setter Property="Background" Value="#B0121420"/>
        <Setter Property="BorderBrush" Value="#1E2336"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="BoxShadow" Value="0 8 32 0 #50000000"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.25"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.GlassCard:pointerover">
        <Setter Property="Background" Value="#C5181B2C"/>
        <Setter Property="BorderBrush" Value="#507C3AED"/>
        <Setter Property="BoxShadow" Value="0 12 36 0 #257C3AED"/>
    </Style>

        <!-- Radar Continuous Animations -->
    <Style Selector="Border.RadarPulseRing1">
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Style.Animations>
            <Animation Duration="0:0:3" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="ScaleTransform.ScaleX" Value="0.2"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="0.2"/>
                    <Setter Property="Opacity" Value="0.85"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                    <Setter Property="Opacity" Value="0.0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Border.RadarPulseRing2">
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Style.Animations>
            <Animation Duration="0:0:3" Delay="0:0:1" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="ScaleTransform.ScaleX" Value="0.2"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="0.2"/>
                    <Setter Property="Opacity" Value="0.85"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                    <Setter Property="Opacity" Value="0.0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Border.RadarPulseRing3">
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Style.Animations>
            <Animation Duration="0:0:3" Delay="0:0:2" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="ScaleTransform.ScaleX" Value="0.2"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="0.2"/>
                    <Setter Property="Opacity" Value="0.85"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                    <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                    <Setter Property="Opacity" Value="0.0"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="Border.RadarSweepBeam">
        <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
        <Style.Animations>
            <Animation Duration="0:0:4" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0"/>
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360"/>
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Apple Developer Grade Primary Button (No clipping, smooth scaling on Button directly) -->
    <Style Selector="Button.PrimaryBtn">
       <Setter Property="Background" Value="#7C3AED"/>
       <Setter Property="Foreground" Value="#FFFFFF"/>
       <Setter Property="Padding" Value="22,11"/>
       <Setter Property="CornerRadius" Value="10"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="FontSize" Value="13"/>
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Setter Property="ClipToBounds" Value="False"/>
       <Setter Property="Margin" Value="0,3"/>
       <Setter Property="Transitions">
          <Transitions>
             <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
             <BrushTransition Property="Background" Duration="0:0:0.18"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Button.PrimaryBtn:pointerover">
       <Setter Property="Background" Value="#8B5CF6"/>
       <Setter Property="RenderTransform" Value="scale(1.03)"/>
    </Style>
    <Style Selector="Button.PrimaryBtn:pressed">
       <Setter Property="Background" Value="#6D28D9"/>
       <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>

    <!-- Apple Developer Grade Ghost Button (No clipping, smooth scaling on Button directly) -->
    <Style Selector="Button.GhostBtn">
       <Setter Property="Background" Value="#161824"/>
       <Setter Property="Foreground" Value="#F8FAFC"/>
       <Setter Property="BorderBrush" Value="#222638"/>
       <Setter Property="BorderThickness" Value="1"/>
       <Setter Property="Padding" Value="18,10"/>
       <Setter Property="CornerRadius" Value="10"/>
       <Setter Property="FontWeight" Value="Medium"/>
       <Setter Property="FontSize" Value="12"/>
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Setter Property="ClipToBounds" Value="False"/>
       <Setter Property="Margin" Value="0,3"/>
       <Setter Property="Transitions">
          <Transitions>
             <BrushTransition Property="BorderBrush" Duration="0:0:0.18"/>
             <BrushTransition Property="Background" Duration="0:0:0.18"/>
             <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Button.GhostBtn:pointerover">
       <Setter Property="BorderBrush" Value="#7C3AED"/>
       <Setter Property="Background" Value="#1C1F2E"/>
       <Setter Property="RenderTransform" Value="scale(1.03)"/>
    </Style>
    <Style Selector="Button.GhostBtn:pressed">
       <Setter Property="Background" Value="#11131C"/>
       <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>

    <!-- Circular Play / Action Button -->
    <Style Selector="Button.CircularPlay">
       <Setter Property="Background" Value="#7C3AED"/>
       <Setter Property="Foreground" Value="#FFFFFF"/>
       <Setter Property="Width" Value="48"/>
       <Setter Property="Height" Value="48"/>
       <Setter Property="CornerRadius" Value="24"/>
       <Setter Property="Padding" Value="0"/>
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Setter Property="HorizontalContentAlignment" Value="Center"/>
       <Setter Property="VerticalContentAlignment" Value="Center"/>
       <Setter Property="ClipToBounds" Value="False"/>
       <Setter Property="Margin" Value="2"/>
       <Setter Property="Transitions">
          <Transitions>
             <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
             <BrushTransition Property="Background" Duration="0:0:0.15"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Button.CircularPlay:pointerover">
       <Setter Property="Background" Value="#8B5CF6"/>
       <Setter Property="RenderTransform" Value="scale(1.06)"/>
    </Style>
    <Style Selector="Button.CircularPlay:pressed">
       <Setter Property="Background" Value="#6D28D9"/>
       <Setter Property="RenderTransform" Value="scale(0.95)"/>
    </Style>

    <!-- Dashboard Action Card -->
    <Style Selector="Button.DashboardActionBtn">
       <Setter Property="Background" Value="Transparent"/>
       <Setter Property="Padding" Value="0"/>
       <Setter Property="BorderThickness" Value="0"/>
       <Setter Property="HorizontalAlignment" Value="Stretch"/>
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Setter Property="Transitions">
          <Transitions>
             <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Button.DashboardActionBtn:pointerover">
       <Setter Property="RenderTransform" Value="translateY(-4px)"/>
    </Style>
    <Style Selector="Button.DashboardActionBtn:pointerover Border.GlassCard">
       <Setter Property="Background" Value="#161824"/>
       <Setter Property="BorderBrush" Value="#333333"/>
       <Setter Property="BoxShadow" Value="0 16 32 0 #60000000"/>
    </Style>

    <!-- Filter Chips -->
    <Style Selector="Button.FilterChip">
       <Setter Property="Background" Value="#161824"/>
       <Setter Property="Foreground" Value="#FFFFFF"/>
       <Setter Property="CornerRadius" Value="9999"/>
       <Setter Property="Padding" Value="16,8"/>
       <Setter Property="FontSize" Value="11"/>
       <Setter Property="FontWeight" Value="Bold"/>
       <Setter Property="Transitions">
          <Transitions>
             <BrushTransition Property="Background" Duration="0:0:0.15"/>
             <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Button.FilterChip:pointerover /template/ ContentPresenter">
       <Setter Property="Background" Value="#2E2E2E"/>
    </Style>
    <Style Selector="Button.FilterChip.ActiveChip /template/ ContentPresenter">
       <Setter Property="Background" Value="#FFFFFF"/>
       <Setter Property="Foreground" Value="#000000"/>
    </Style>
    <Style Selector="Button.FilterChip.ActiveChip TextBlock">
       <Setter Property="Foreground" Value="#000000"/>
       <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Tracklist Table Row -->
    <Style Selector="Border.TrackRow">
       <Setter Property="Background" Value="Transparent"/>
       <Setter Property="CornerRadius" Value="6"/>
       <Setter Property="Transitions">
          <Transitions>
             <BrushTransition Property="Background" Duration="0:0:0.15"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Border.TrackRow:pointerover">
       <Setter Property="Background" Value="#2A2A2A"/>
    </Style>
  </UserControl.Styles>

  <Grid x:Name="RootBorder" Background="#090A0F" RowDefinitions="*, Auto">
    <!-- Ambient Cityscape & Starry Night Sky Background -->
    <Image Grid.RowSpan="2" Source="avares://WeShare.UI/Assets/background.png" Stretch="UniformToFill" Opacity="0.38" IsHitTestVisible="False"/>
    <Border Grid.RowSpan="2" Background="#D0090A0F" IsHitTestVisible="False"/>
    
    <!-- MAIN APPLICATION GRID (Sidebar + Main Content Canvas) -->
    <Grid Grid.Row="0" x:Name="MainLayout" ColumnDefinitions="260, *" Margin="8,8,8,0">
      
      <!-- ========================================== -->
      <!-- WE SHARE DUAL-CARD LEFT SIDEBAR             -->
      <!-- ========================================== -->
      <Grid Grid.Column="0" x:Name="Sidebar" RowDefinitions="Auto, 8, *" Margin="0,0,8,0">
        
        <!-- CARD 1: MAIN NAVIGATION CARD -->
        <Border Grid.Row="0" Background="#C811131C" BorderBrush="#1E2232" BorderThickness="1" CornerRadius="12" Padding="12,14" BoxShadow="0 4 16 0 #40000000">
          <StackPanel Spacing="4">
            <!-- Obsidian We Share Brand Header -->
            <Grid ColumnDefinitions="Auto, *" Margin="8,6,8,16">
              <Border Width="34" Height="34" CornerRadius="10" Background="#161824" BorderBrush="#222638" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center" ClipToBounds="True">
                <Image Source="avares://WeShare.UI/Assets/app-icon.png" Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="We Share" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" LetterSpacing="0.4"/>
                <TextBlock Text="Local File Sharing" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"/>
              </StackPanel>
            </Grid>

            <!-- Navigation Buttons -->
            <Button Classes="SidebarItem Active" x:Name="NavHomeBtn" Click="NavHome_Click">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Rectangle Classes="IconTint" Width="18" Height="18">
                  <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/HOME.png"/></Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Text="Home" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button Classes="SidebarItem" x:Name="NavTransfersBtn" Click="NavTransfers_Click">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Rectangle Classes="IconTint" Width="18" Height="18">
                  <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/SCAN.png"/></Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Text="Transfers" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button Classes="SidebarItem" x:Name="NavFilesBtn" Click="NavFiles_Click">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Rectangle Classes="IconTint" Width="18" Height="18">
                  <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/LIBRARY.png"/></Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Text="Library" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button Classes="SidebarItem" x:Name="NavWebSharedBtn" Click="NavWebShared_Click">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Rectangle Classes="IconTint" Width="18" Height="18">
                  <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/WEBSITE.png"/></Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Text="Web Transfer" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- CARD 2: NETWORK, DISCOVERED PEERS & UTILITIES -->
        <Border Grid.Row="2" Background="#C811131C" BorderBrush="#1E2232" BorderThickness="1" CornerRadius="12" Padding="12,14" BoxShadow="0 4 16 0 #40000000">
          <Grid RowDefinitions="Auto, *, Auto">
            
            <!-- Library Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="12,0,12,12">
              <TextBlock Text="YOUR NETWORK" FontSize="11" FontWeight="Bold" Foreground="#B3B3B3" LetterSpacing="1.2" VerticalAlignment="Center"/>
              <Border Grid.Column="1" Classes="NetworkSignalPulse" VerticalAlignment="Center"/>
            </Grid>

            <!-- Discovered Devices Quick List -->
            <ScrollViewer Grid.Row="1" Margin="0,0,0,12">
              <StackPanel Spacing="4">
                
                <!-- Local Host Card with Profile Avatar -->
                <Border Background="#161824" BorderBrush="#222638" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="2,2">
                  <Grid ColumnDefinitions="Auto, *, Auto">
                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True">
                      <Image Source="avares://WeShare.UI/Assets/profile.png" Width="30" Height="30" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <TextBlock x:Name="SidebarDeviceName" Text="DESKTOP-PEER" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="SidebarNetworkInfo" Text="192.168.1.100" FontSize="10" Foreground="#94A3B8"/>
                    </StackPanel>
                    <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" Background="#10B981" BoxShadow="0 0 8 0 #10B981" VerticalAlignment="Center" ToolTip.Tip="Network Online"/>
                  </Grid>
                </Border>

                <!-- Discovered Peers in Sidebar -->
                <ItemsControl ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=views:MainView}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DeviceModel">
                      <Button Click="SendFile_Click" Background="Transparent" Padding="8,6" CornerRadius="6" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                          <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#207C3AED" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name, Converter={StaticResource DeviceTypeToIconConverter}}" FontSize="9" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Type}" FontSize="9" Foreground="#B3B3B3"/>
                          </StackPanel>
                          <Border Grid.Column="2" Background="#7C3AED" CornerRadius="9999" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="SEND" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF"/>
                          </Border>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>

            <!-- Bottom App Utilities -->
            <StackPanel Grid.Row="2" Spacing="2">
              <Button Classes="SidebarItem" x:Name="NavSettBtn" Click="NavSettings_Click">
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <Rectangle Classes="IconTint" Width="16" Height="16"><Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/SETTINGS.png"/></Rectangle.OpacityMask></Rectangle>
                  <TextBlock Text="Settings" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Classes="SidebarItem" x:Name="NavAboutBtn" Click="NavAbout_Click">
                <StackPanel Orientation="Horizontal" Spacing="14">
                  <Rectangle Classes="IconTint" Width="16" Height="16"><Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/WEBSITE.png"/></Rectangle.OpacityMask></Rectangle>
                  <TextBlock Text="About" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>

          </Grid>
        </Border>

      </Grid>

      <!-- ========================================== -->
      <!-- WE SHARE MAIN CONTENT CANVAS                -->
      <!-- ========================================== -->
      <Border Grid.Column="1" Background="#B0090A0F" BorderBrush="#1E2232" BorderThickness="1" CornerRadius="12" BoxShadow="0 8 32 0 #50000000" ClipToBounds="True">
        <Grid RowDefinitions="Auto, *" x:Name="ContentArea">
          
          <!-- Global Activity Progress Line -->
          <Border x:Name="GlobalActivityBorder" IsVisible="False" Height="2" Background="Transparent" VerticalAlignment="Top" ZIndex="1000">
             <ProgressBar x:Name="GlobalProgressBar" IsIndeterminate="False" Height="2" Foreground="#7C3AED" Background="Transparent" BorderThickness="0"/>
          </Border>

          <!-- Top App Bar -->
          <Border Grid.Row="0" Padding="32,18,32,14" Background="#B011131C" PointerPressed="TitleBar_PointerPressed" BorderBrush="#1E2232" BorderThickness="0,0,0,1">
             <Grid ColumnDefinitions="*, Auto">
                
                <!-- Page Title -->
                <StackPanel VerticalAlignment="Center" Spacing="2">
                   <TextBlock x:Name="PageTitle" Text="HOME" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" LetterSpacing="0.5"/>
                </StackPanel>

                <!-- Network Status Pill on Right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                   <Border Classes="GlassCard" CornerRadius="9999" Padding="12,6" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                         <Border Classes="NetworkSignalPulse" VerticalAlignment="Center"/>
                         <TextBlock x:Name="HomeNetworkInfoText" Text="Wi-Fi Ready" FontSize="11" FontWeight="Bold" Foreground="#B3B3B3"/>
                      </StackPanel>
                   </Border>

                   <!-- Live Transfer Speed Badge -->
                    <Border IsVisible="{Binding #HomeSpeedBadge.IsVisible}" Background="#7C3AED" CornerRadius="9999" Padding="12,6" VerticalAlignment="Center">
                       <TextBlock x:Name="HomeSpeedBadge" IsVisible="False" Text="↑ 0.0 MB/s" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                    </Border>
                </StackPanel>
             </Grid>
          </Border>

          <!-- Dynamic Panel Area -->
          <Grid Grid.Row="1" Margin="32,24,32,24">
              
              <!-- Send Wizard Step Indicator (Hidden) -->
              <StackPanel x:Name="SendStepWizard" IsVisible="False">
                 <TextBlock x:Name="Step1Indicator" IsVisible="False"/>
                 <TextBlock x:Name="Step2Indicator" IsVisible="False"/>
              </StackPanel>

            <!-- ========================================== -->
            <!-- 1. HOME DASHBOARD                          -->
            <!-- ========================================== -->
            <Grid x:Name="HomePanel" Classes="SignalPanel" RowDefinitions="Auto, 24, *">
               
               <!-- Welcome Header -->
               <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                  <StackPanel Spacing="4">
                     <TextBlock Text="Welcome back" FontSize="13" FontWeight="SemiBold" Foreground="#B3B3B3"/>
                     <TextBlock x:Name="HomeDeviceNameText" Text="Ready to share files" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>
                  </StackPanel>
                  <Button Grid.Column="1" Classes="GhostBtn" Content="RADAR SCAN" Click="RefreshDiscovery_Click" VerticalAlignment="Center"/>
               </Grid>

               <!-- Action Cards Grid -->
               <Grid Grid.Row="2" ColumnDefinitions="*, 24, 320">
                  
                  <!-- Left: Featured Action Cards + Recent Transfers -->
                  <Grid Grid.Column="0" RowDefinitions="Auto, 24, *">
                     
                     <!-- Featured Send & Receive Cards -->
                     <Grid Grid.Row="0" ColumnDefinitions="*, 16, *">
                        
                        <!-- SEND CARD -->
                        <Button Grid.Column="0" Classes="DashboardActionBtn" Click="HomeSend_Click">
                           <Border Classes="GlassCard" Padding="24" CornerRadius="8" Height="160">
                              <Grid RowDefinitions="*, Auto">
                                 <StackPanel Grid.Row="0" Spacing="6">
                                    <TextBlock Text="SEND FILES" FontSize="11" FontWeight="Bold" Foreground="#7C3AED" LetterSpacing="1.5"/>
                                    <TextBlock Text="Select &amp; Send" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Fast direct transfer to PC or mobile devices" FontSize="12" Foreground="#B3B3B3" TextWrapping="Wrap"/>
                                 </StackPanel>
                                 <Grid Grid.Row="1" HorizontalAlignment="Right">
                                    <Button Classes="CircularPlay" Click="HomeSend_Click">
                                       <Polygon Points="0,0 16,10 0,20" Fill="#000000" Margin="4,0,0,0"/>
                                    </Button>
                                 </Grid>
                              </Grid>
                           </Border>
                        </Button>

                        <!-- RECEIVE CARD -->
                        <Button Grid.Column="2" Classes="DashboardActionBtn" Click="NavReceiveMode_Click">
                           <Border Classes="GlassCard" Padding="24" CornerRadius="8" Height="160">
                              <Grid RowDefinitions="*, Auto">
                                 <StackPanel Grid.Row="0" Spacing="6">
                                    <TextBlock Text="RECEIVE MODE" FontSize="11" FontWeight="Bold" Foreground="#7C3AED" LetterSpacing="1.5"/>
                                    <TextBlock Text="Be Discoverable" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Accept files automatically or on demand" FontSize="12" Foreground="#B3B3B3" TextWrapping="Wrap"/>
                                 </StackPanel>
                                 <Grid Grid.Row="1" HorizontalAlignment="Right">
                                    <Button Classes="CircularPlay" Click="NavReceiveMode_Click">
                                       <Rectangle Width="16" Height="16" Fill="#000000"><Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/RECEIVE FILE.png"/></Rectangle.OpacityMask></Rectangle>
                                    </Button>
                                 </Grid>
                              </Grid>
                           </Border>
                        </Button>

                     </Grid>

                     <!-- Recent Transfers Table (Transfer Table Style) -->
                     <Border Grid.Row="2" Classes="GlassCard" CornerRadius="8" Padding="20">
                        <Grid RowDefinitions="Auto, 12, *">
                           <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                              <TextBlock Text="RECENT TRANSFERS" FontSize="11" FontWeight="Bold" Foreground="#B3B3B3" LetterSpacing="1.2" VerticalAlignment="Center"/>
                              <Button Grid.Column="1" Content="SHOW ALL" Click="NavFiles_Click" Background="Transparent" Foreground="#7C3AED" FontSize="11" FontWeight="Bold"/>
                           </Grid>

                           <!-- Empty Label -->
                           <TextBlock x:Name="HomeEmptyHistoryLabel" Grid.Row="2" Text="No transfers yet. Drop files anywhere to start sharing." FontSize="12" Foreground="#7C7C7C" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                           <!-- Recent Transfers List -->
                           <ScrollViewer Grid.Row="2">
                              <ItemsControl ItemsSource="{Binding ReceivedFiles, RelativeSource={RelativeSource AncestorType=views:MainView}}">
                                 <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileTransferState">
                                       <Border Classes="TrackRow" Padding="12,8">
                                          <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                             <Border Grid.Column="0" Width="36" Height="36" Classes="GlassCard" CornerRadius="4" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Rectangle Width="16" Height="16" Fill="#B3B3B3"><Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/LIBRARY.png"/></Rectangle.OpacityMask></Rectangle>
                                             </Border>
                                             <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PeerName, StringFormat='From: {0}'}" FontSize="11" Foreground="#B3B3B3"/>
                                             </StackPanel>
                                             <TextBlock Grid.Column="2" Text="{Binding FileSizeDisplay}" FontSize="11" Foreground="#7C7C7C" VerticalAlignment="Center" Margin="16,0"/>
                                             <Button Grid.Column="3" Content="OPEN" Click="OpenFileInList_Click" Tag="{Binding}" Classes="GhostBtn" Padding="12,6" FontSize="10" VerticalAlignment="Center"/>
                                          </Grid>
                                       </Border>
                                    </DataTemplate>
                                 </ItemsControl.ItemTemplate>
                              </ItemsControl>
                           </ScrollViewer>
                        </Grid>
                     </Border>

                  </Grid>

                  <!-- Right Column: Web Portal & Hotspot Card -->
                  <Border Grid.Column="2" Classes="GlassCard" BorderBrush="#252A3E" BorderThickness="1" CornerRadius="8" Padding="20" BoxShadow="0 4 24 0 #30000000">
                     <ScrollViewer>
                        <StackPanel Spacing="20">
                           <TextBlock Text="MOBILE WEB PORTAL" FontSize="11" FontWeight="Bold" Foreground="#7C3AED" LetterSpacing="1.2"/>
                           
                           <!-- QR Code in Obsidian Card -->
                           <Border Background="#FFFFFF" CornerRadius="8" Padding="12" HorizontalAlignment="Center" Width="160" Height="160">
                              <Image x:Name="HomeQrImage" Stretch="Uniform"/>
                           </Border>

                           <TextBlock Text="Scan to open WeShare directly on your iPhone, Android, or tablet without installing any app." FontSize="11" Foreground="#B3B3B3" TextWrapping="Wrap" TextAlignment="Center"/>

                           <!-- Web Portal Address Pill -->
                           <Border x:Name="HomeWebPortalPanel" Classes="GlassCard" CornerRadius="9999" Padding="14,10">
                              <Grid ColumnDefinitions="*, Auto">
                                 <TextBlock x:Name="HomeWebPortalText" Text="http://192.168.1.100:8080" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                 <Button Grid.Column="1" x:Name="CopyWebLinkBtn" Content="COPY" Click="CopyWebLink_Click" Classes="GhostBtn" Padding="8,4" FontSize="9"/>
                              </Grid>
                           </Border>

                           <!-- Wi-Fi Hotspot / Desert Mode section -->
                           <StackPanel Spacing="8">
                              <TextBlock Text="DESERT MODE (HOTSPOT)" FontSize="10" FontWeight="Bold" Foreground="#7C7C7C" LetterSpacing="1"/>
                              <Button x:Name="StartHotspotBtn" Content="START DESERT HOTSPOT" Click="ManualStartHotspot_Click" Classes="PrimaryBtn" HorizontalAlignment="Stretch" Padding="16,10"/>
                              
                              <Border x:Name="HomeWifiPasswordPanel" Classes="GlassCard" CornerRadius="6" Padding="10,8" IsVisible="False">
                                 <TextBlock x:Name="HomeWifiPasswordText" Text="Pass: weshare123" FontSize="11" Foreground="#B3B3B3"/>
                              </Border>
                              
                              <Border x:Name="HomeWifiWebPortalPanel" Classes="GlassCard" CornerRadius="6" Padding="10,8" IsVisible="False">
                                 <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock x:Name="HomeWifiWebPortalText" Text="http://192.168.137.1:8080" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" x:Name="CopyWifiWebLinkBtn" Content="COPY" Click="CopyWifiWebLink_Click" Classes="GhostBtn" Padding="8,4" FontSize="9"/>
                                 </Grid>
                              </Border>

                              <!-- Backward compatibility anchors -->
                              <Rectangle x:Name="HomeWifiWebPortalSeparator" IsVisible="False"/>
                              <Rectangle x:Name="HomeWifiPasswordSeparator" IsVisible="False"/>
                              <TextBlock x:Name="WebPortalLabel" IsVisible="False"/>
                           </StackPanel>

                        </StackPanel>
                     </ScrollViewer>
                  </Border>

               </Grid>
            </Grid>

            <!-- ========================================== -->
            <!-- 2. SEND STEP 1: QUEUE SELECTION            -->
            <!-- ========================================== -->
            <Grid x:Name="SendFilesPanel" IsVisible="False" Classes="SignalPanel" RowDefinitions="*, Auto" DragDrop.AllowDrop="True">
               <Grid Grid.Row="0" RowDefinitions="Auto, 16, *">
                  <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                     <TextBlock Text="SELECTED FILES QUEUE" FontSize="11" FontWeight="Bold" Foreground="#B3B3B3" LetterSpacing="1.2" VerticalAlignment="Center"/>
                     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button Classes="GhostBtn" Content="+ ADD FOLDER" Click="BrowseFolder_Click"/>
                        <Button Classes="PrimaryBtn" Content="+ ADD FILES" Click="BrowseFiles_Click"/>
                     </StackPanel>
                  </Grid>

                  <!-- Queue List -->
                  <Border Grid.Row="2" Classes="GlassCard" CornerRadius="8" Padding="16">
                     <Grid>
                        <ScrollViewer>
                           <ItemsControl x:Name="SendQueueList">
                              <ItemsControl.ItemTemplate>
                                 <DataTemplate x:DataType="views:QueueItem">
                                    <Border Classes="TrackRow" Padding="12,10" Margin="0,0,0,4">
                                       <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                          <Border Grid.Column="0" Width="40" Height="40" Classes="GlassCard" CornerRadius="4" Margin="0,0,14,0" VerticalAlignment="Center">
                                             <Rectangle Width="18" Height="18" Fill="#7C3AED"><Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/SEND FILE.png"/></Rectangle.OpacityMask></Rectangle>
                                          </Border>
                                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                             <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                             <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="#B3B3B3"/>
                                          </StackPanel>
                                          <Button Grid.Column="3" Content="âœ•" Click="RemoveFromQueue_Click" Background="Transparent" Foreground="#F3727F" FontSize="14" Padding="10"/>
                                       </Grid>
                                    </Border>
                                 </DataTemplate>
                              </ItemsControl.ItemTemplate>
                           </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty Queue Placeholder -->
                        <StackPanel x:Name="QueueEmptyLabel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                           <TextBlock Text="YOUR SEND QUEUE IS EMPTY" FontSize="12" FontWeight="Bold" Foreground="#7C7C7C" LetterSpacing="1.5" HorizontalAlignment="Center"/>
                           <Button Classes="PrimaryBtn" Content="CHOOSE FILES" Click="BrowseFiles_Click" HorizontalAlignment="Center"/>
                        </StackPanel>
                     </Grid>
                  </Border>
               </Grid>

               <!-- Footer Actions -->
               <Border Grid.Row="1" x:Name="SendFooter" Classes="GlassCard" BorderBrush="#242424" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
                  <Grid ColumnDefinitions="*, Auto, Auto">
                     <TextBlock x:Name="SendSummaryText" Text="0 files selected" FontSize="13" FontWeight="SemiBold" Foreground="#B3B3B3" VerticalAlignment="Center"/>
                     <Button Grid.Column="1" x:Name="ZipSendBtn" Content="COMPRESS TO ZIP" Click="ZipSend_Click" Classes="GhostBtn" Margin="0,0,12,0" IsVisible="False"/>
                     <Button Grid.Column="2" Content="CHOOSE RECEIVER â†’" Click="SendNow_Click" Classes="PrimaryBtn"/>
                  </Grid>
               </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- 3. SEND STEP 2: RADAR PEER DISCOVERY       -->
            <!-- ========================================== -->
            <Grid x:Name="SendDiscoveryPanel" IsVisible="False" Classes="SignalPanel">
               <Grid>
                  <!-- Concentric Violet Radar Stage -->
                  <Panel Width="480" Height="360" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                     <!-- Radar Static Rings -->
                     <Ellipse Width="340" Height="340" Stroke="#157C3AED" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                     <Ellipse Width="260" Height="260" Stroke="#207C3AED" StrokeThickness="1" StrokeDashArray="4,4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                     <Ellipse Width="180" Height="180" Stroke="#257C3AED" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                     <Ellipse Width="100" Height="100" Stroke="#307C3AED" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                     
                     <!-- Active Animated Pulsing Ripple Waves -->
                     <Border Classes="RadarPulseRing1" Width="340" Height="340" CornerRadius="170" BorderBrush="#457C3AED" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                     <Border Classes="RadarPulseRing2" Width="340" Height="340" CornerRadius="170" BorderBrush="#357C3AED" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                     <Border Classes="RadarPulseRing3" Width="340" Height="340" CornerRadius="170" BorderBrush="#257C3AED" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                     <!-- Active Animated Rotating Radar Sweep Beam -->
                     <Border Classes="RadarSweepBeam" Width="340" Height="340" CornerRadius="170" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                           <Border Width="2" Height="170" VerticalAlignment="Top" HorizontalAlignment="Center" Background="#707C3AED" BoxShadow="0 0 12 0 #507C3AED"/>
                        </Grid>
                     </Border>

                     <!-- Center Glowing Beacon Node -->
                     <Border Width="60" Height="60" CornerRadius="30" Background="#7C3AED" BoxShadow="0 0 30 0 #907C3AED" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconDiscovery}" Fill="#FFFFFF" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                     </Border>

                     <!-- Floating Discovered Device Markers (Device Avatar Style) -->
                     <ItemsControl ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=views:MainView}}">
                        <ItemsControl.ItemsPanel>
                           <ItemsPanelTemplate><Canvas Width="520" Height="520" Background="Transparent"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                           <DataTemplate x:DataType="models:DeviceModel">
                              <Button Click="SendFile_Click" Background="Transparent" Padding="0" BorderThickness="0">
                                 <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <Border Classes="DeviceMarker GlassCard" Width="64" Height="64" BorderBrush="#7C3AED" BorderThickness="2" CornerRadius="32" BoxShadow="0 8 24 0 #40000000">
                                       <Rectangle Width="24" Height="24" Fill="#7C3AED">
                                          <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/RECEIVE FILE.png"/></Rectangle.OpacityMask>
                                       </Rectangle>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" MaxWidth="90" TextTrimming="CharacterEllipsis"/>
                                 </StackPanel>
                              </Button>
                           </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.Styles>
                           <Style Selector="ContentPresenter">
                              <Setter Property="Canvas.Left">
                                 <MultiBinding Converter="{StaticResource RadarPos}"><Binding /><Binding Path="Devices" RelativeSource="{RelativeSource AncestorType=views:MainView}"/><Binding Source="X"/></MultiBinding>
                              </Setter>
                              <Setter Property="Canvas.Top">
                                 <MultiBinding Converter="{StaticResource RadarPos}"><Binding /><Binding Path="Devices" RelativeSource="{RelativeSource AncestorType=views:MainView}"/><Binding Source="Y"/></MultiBinding>
                              </Setter>
                           </Style>
                        </ItemsControl.Styles>
                     </ItemsControl>
                  </Panel>

                  <!-- Bottom Radar Controls -->
                  <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="16" Margin="0,0,0,16">
                     <TextBlock x:Name="RadarEmptyHint" Text="TAP ANY NEARBY DEVICE TO SEND FILES" FontSize="10" FontWeight="Bold" Foreground="#7C3AED" LetterSpacing="2"/>
                     <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                        <Button Content="CANCEL" Click="CancelSending_Click" Classes="GhostBtn"/>
                        <Button Content="REFRESH RADAR" Click="RefreshDiscovery_Click" Classes="PrimaryBtn"/>
                     </StackPanel>
                  </StackPanel>
               </Grid>
            </Grid>

            <!-- ========================================== -->
            <!-- 4. RECEIVE MODE (DISCOVERABLE BEACON)      -->
            <!-- ========================================== -->
            <Grid x:Name="ReceiveModePanel" IsVisible="False" Classes="SignalPanel">
               <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24" MaxWidth="440">
                  
                  <!-- Pulsing Beacon -->
                  <Panel Width="440" Height="320" HorizontalAlignment="Center" ClipToBounds="False">
                     <!-- Radar Static Rings -->
                     <Ellipse Width="300" Height="300" Stroke="#157C3AED" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                     <Ellipse Width="220" Height="220" Stroke="#207C3AED" StrokeThickness="1" StrokeDashArray="4,4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                     <Ellipse Width="140" Height="140" Stroke="#257C3AED" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                     <!-- Active Animated Pulsing Ripple Waves -->
                     <Border Classes="RadarPulseRing1" Width="300" Height="300" CornerRadius="150" BorderBrush="#457C3AED" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                     <Border Classes="RadarPulseRing2" Width="300" Height="300" CornerRadius="150" BorderBrush="#357C3AED" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                     <Border Classes="RadarPulseRing3" Width="300" Height="300" CornerRadius="150" BorderBrush="#257C3AED" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                     <!-- Active Animated Rotating Radar Sweep Beam -->
                     <Border Classes="RadarSweepBeam" Width="300" Height="300" CornerRadius="150" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                           <Border Width="2" Height="150" VerticalAlignment="Top" HorizontalAlignment="Center" Background="#707C3AED" BoxShadow="0 0 12 0 #507C3AED"/>
                        </Grid>
                     </Border>

                     <!-- Center Receiving Station Node -->
                     <Border Width="64" Height="64" Background="#7C3AED" CornerRadius="32" BoxShadow="0 0 32 0 #807C3AED" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconReceive}" Fill="#FFFFFF" Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                     </Border>
                  </Panel>

                  <StackPanel Spacing="6" HorizontalAlignment="Center">
                     <TextBlock Text="THIS PC IS DISCOVERABLE" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                     <TextBlock Text="Other devices on the network can find you and send files directly." FontSize="13" Foreground="#B3B3B3" TextAlignment="Center"/>
                  </StackPanel>

                  <Border Classes="GlassCard" CornerRadius="8" Padding="16">
                     <StackPanel Spacing="4">
                        <TextBlock Text="AUTO-ACCEPT IS ENABLED" FontSize="11" FontWeight="Bold" Foreground="#7C3AED" LetterSpacing="1" HorizontalAlignment="Center"/>
                        <TextBlock Text="Files will be stored directly into your Downloads directory." FontSize="11" Foreground="#7C7C7C" HorizontalAlignment="Center"/>
                     </StackPanel>
                  </Border>

                  <Button Content="GO TO TRANSFERS" Click="NavTransfers_Click" Classes="GhostBtn" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="RecvEmptyState" IsVisible="False"/>
               </StackPanel>
            </Grid>

            <!-- ========================================== -->
            <!-- 5. ACTIVE TRANSFERS MONITOR                -->
            <!-- ========================================== -->
            <Grid x:Name="TransfersPanel" IsVisible="False" Classes="SignalPanel" RowDefinitions="Auto, 16, *">
               
               <!-- Active Sending / Transfer Card -->
               <Border Grid.Row="0" x:Name="SendProgressBorder" IsVisible="False" Classes="GlassCard" CornerRadius="8" Padding="24" BoxShadow="0 8 24 0 #40000000">
                  <Grid RowDefinitions="Auto, 16, Auto, 12, Auto, 8, Auto">
                     <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <StackPanel Spacing="4">
                           <TextBlock Text="TRANSFERRING" FontSize="10" FontWeight="Bold" Foreground="#7C3AED" LetterSpacing="1.5"/>
                           <TextBlock x:Name="SendProgressFile" Text="document.pdf" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="CANCEL" Click="CancelActiveSend_Click" Classes="GhostBtn" Padding="14,6" FontSize="10"/>
                     </Grid>

                     <!-- Progress Bar -->
                     <ProgressBar Grid.Row="2" x:Name="SendProgressBar" Height="8" CornerRadius="4" Foreground="#7C3AED" Background="#333333"/>

                     <Grid Grid.Row="4" ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="SendProgressSpeed" Text="Calculating speed..." FontSize="12" Foreground="#B3B3B3"/>
                        <TextBlock Grid.Column="1" x:Name="SendProgressPct" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#7C3AED"/>
                     </Grid>
                     <controls:SpeedGraphControl Grid.Row="6" x:Name="SendSpeedGraph" Height="40" Margin="0,8,0,0"/>
                  </Grid>
               </Border>

               <!-- Incoming Transfers List -->
               <Border Grid.Row="2" Classes="GlassCard" CornerRadius="8" Padding="20">
                  <Grid RowDefinitions="Auto, 16, *">
                     <TextBlock Text="ACTIVE SESSIONS" FontSize="11" FontWeight="Bold" Foreground="#B3B3B3" LetterSpacing="1.2"/>
                     <ScrollViewer Grid.Row="2">
                        <ItemsControl x:Name="IncomingList">
                           <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="models:FileTransferState">
                                 <Border Classes="TrackRow GlassCard" Padding="16,12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                       <Border Grid.Column="0" Width="40" Height="40" Classes="GlassCard" CornerRadius="4" Margin="0,0,16,0" VerticalAlignment="Center">
                                          <Rectangle Width="18" Height="18" Fill="#7C3AED"><Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/RECEIVE FILE.png"/></Rectangle.OpacityMask></Rectangle>
                                       </Border>
                                       <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                          <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                          <ProgressBar Height="4" Value="{Binding ProgressPercentage}" Foreground="#7C3AED" Background="#333333" CornerRadius="2"/>
                                          <TextBlock Text="{Binding PeerName, StringFormat='From: {0}'}" FontSize="10" Foreground="#B3B3B3"/>
                                       </StackPanel>
                                       <TextBlock Grid.Column="2" Text="{Binding SpeedMbPerSec, StringFormat='\{0:F1\} MB/s'}" FontSize="11" Foreground="#7C3AED" VerticalAlignment="Center" Margin="16,0"/>
                                       <Button Grid.Column="3" Content="CANCEL" Click="CancelIncoming_Click" Classes="GhostBtn" Padding="10,6" FontSize="10" VerticalAlignment="Center"/>
                                    </Grid>
                                 </Border>
                              </DataTemplate>
                           </ItemsControl.ItemTemplate>
                        </ItemsControl>
                     </ScrollViewer>
                  </Grid>
               </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- 6. LIBRARY (RECEIVED FILES)                -->
            <!-- ========================================== -->
            <Grid x:Name="FilesPanel" IsVisible="False" Classes="SignalPanel" RowDefinitions="Auto, 16, Auto, 16, *">
               
               <!-- Search & Actions Top Bar -->
               <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto">
                  <TextBox x:Name="FileSearchBox" Watermark="Search received files..." TextChanged="FileSearch_TextChanged" Width="280" HorizontalAlignment="Left"/>
                  <Button Grid.Column="1" Content="CLEAR COMPLETED" Click="ClearCompletedTransfers_Click" Classes="GhostBtn" Margin="0,0,12,0"/>
                  <Button Grid.Column="2" Content="OPEN FOLDER" Click="OpenDownloadFolder_Click" Classes="PrimaryBtn"/>
               </Grid>

               <!-- Filter Chips & Stats -->
               <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
                  <TextBlock x:Name="LibraryStatsText" Text="Total Received: 0 files (0 B)" FontSize="12" Foreground="#B3B3B3" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                     <Button x:Name="FilterAllBtn" Content="ALL" Click="FilterDate_Click" Tag="All" Classes="FilterChip ActiveChip"/>
                     <Button x:Name="FilterTodayBtn" Content="TODAY" Click="FilterDate_Click" Tag="Today" Classes="FilterChip"/>
                     <Button x:Name="FilterWeekBtn" Content="THIS WEEK" Click="FilterDate_Click" Tag="Week" Classes="FilterChip"/>
                  </StackPanel>
               </Grid>

               <!-- Received Files Tracklist -->
               <Border Grid.Row="4" Classes="GlassCard" CornerRadius="8" Padding="16">
                  <Grid>
                     <ScrollViewer>
                        <ItemsControl x:Name="ReceivedFilesList">
                           <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="models:FileTransferState">
                                 <Border Classes="TrackRow" Padding="12,10" Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto">
                                       <Border Grid.Column="0" Width="36" Height="36" Classes="GlassCard" CornerRadius="4" Margin="0,0,14,0" VerticalAlignment="Center">
                                          <Rectangle Width="16" Height="16" Fill="#B3B3B3"><Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/LIBRARY.png"/></Rectangle.OpacityMask></Rectangle>
                                       </Border>
                                       <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                          <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                          <TextBlock Text="{Binding PeerName, StringFormat='From: {0}'}" FontSize="11" Foreground="#B3B3B3"/>
                                       </StackPanel>
                                       <TextBlock Grid.Column="2" Text="{Binding FileSizeDisplay}" FontSize="11" Foreground="#7C7C7C" VerticalAlignment="Center" Margin="16,0"/>
                                       
                                       <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsCompleted}">
                                          <Button Content="OPEN" Click="OpenFileInList_Click" Tag="{Binding}" Classes="PrimaryBtn" Padding="12,6" FontSize="10"/>
                                          <Button Content="FOLDER" Click="OpenFolderInList_Click" Tag="{Binding}" Classes="GhostBtn" Padding="10,6" FontSize="10"/>
                                          <Button Content="âœ•" Click="DeleteFileInList_Click" Tag="{Binding}" Background="Transparent" Foreground="#F3727F" FontSize="12" Padding="8"/>
                                       </StackPanel>

                                       <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding !IsCompleted}">
                                          <Button Content="CANCEL" Click="CancelIncoming_Click" Classes="GhostBtn" Padding="10,6" FontSize="10"/>
                                       </StackPanel>
                                    </Grid>
                                 </Border>
                              </DataTemplate>
                           </ItemsControl.ItemTemplate>
                        </ItemsControl>
                     </ScrollViewer>

                     <TextBlock x:Name="HistoryEmptyState" Text="NO RECEIVED FILES YET" FontSize="12" FontWeight="Bold" Foreground="#7C7C7C" LetterSpacing="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
               </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- 7. WEB SHARED PANEL                        -->
            <!-- ========================================== -->
            <Grid x:Name="WebSharedPanel" IsVisible="False" Classes="SignalPanel" ColumnDefinitions="260, 16, *">
               
               <!-- Left Column: Web Clients -->
               <Border Grid.Column="0" Classes="GlassCard" CornerRadius="8" Padding="16">
                  <Grid RowDefinitions="Auto, 12, *">
                     <TextBlock Text="WEB CLIENTS" FontSize="11" FontWeight="Bold" Foreground="#B3B3B3" LetterSpacing="1.2"/>
                     <ListBox Grid.Row="2" x:Name="WebClientsListBox" Background="Transparent" BorderThickness="0" SelectionChanged="WebClientsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                           <DataTemplate x:DataType="models:DeviceModel">
                              <Border Classes="TrackRow" Padding="8,6" Margin="0,2">
                                 <Grid ColumnDefinitions="Auto, *">
                                    <Border Width="28" Height="28" CornerRadius="14" Classes="GlassCard" Margin="0,0,10,0" VerticalAlignment="Center">
                                       <TextBlock Text="WEB" FontSize="8" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                       <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                                       <TextBlock Text="{Binding IpAddress}" FontSize="10" Foreground="#7C7C7C"/>
                                    </StackPanel>
                                 </Grid>
                              </Border>
                           </DataTemplate>
                        </ListBox.ItemTemplate>
                     </ListBox>
                  </Grid>
               </Border>

               <!-- Right Column: Staged Files -->
               <Border Grid.Column="2" Classes="GlassCard" CornerRadius="8" Padding="20">
                  <Grid RowDefinitions="Auto, 16, *">
                     <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <TextBlock Text="STAGED WEB FILES" FontSize="11" FontWeight="Bold" Foreground="#B3B3B3" LetterSpacing="1.2" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="WebFilesCountText" Text="0 files" FontSize="11" Foreground="#7C7C7C" VerticalAlignment="Center"/>
                     </Grid>

                     <TextBlock x:Name="WebFilesEmptyLabel" Grid.Row="2" Text="No files staged from web clients. Upload files from mobile to approve here." FontSize="12" Foreground="#7C7C7C" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>

                     <ScrollViewer Grid.Row="2">
                        <ItemsControl x:Name="WebSharedFilesList">
                           <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="views:StagedWebFile">
                                 <Border Classes="TrackRow GlassCard" Padding="16,12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                       <StackPanel VerticalAlignment="Center">
                                          <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                          <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="#B3B3B3"/>
                                       </StackPanel>
                                       <Button Grid.Column="1" Content="ACCEPT" Tag="{Binding}" Click="AcceptWebSharedFile_Click" Classes="PrimaryBtn" Padding="14,6" FontSize="10" Margin="0,0,8,0"/>
                                       <Button Grid.Column="2" Content="REJECT" Tag="{Binding}" Click="RejectWebSharedFile_Click" Classes="GhostBtn" Padding="12,6" FontSize="10"/>
                                    </Grid>
                                 </Border>
                              </DataTemplate>
                           </ItemsControl.ItemTemplate>
                        </ItemsControl>
                     </ScrollViewer>
                  </Grid>
               </Border>
            </Grid>


            <!-- ========================================== -->
            <!-- 7.5 DEDICATED DEVICE SESSION (SEND & RECV)  -->
            <!-- ========================================== -->
            <Grid x:Name="DeviceSessionPanel" IsVisible="False" Classes="SignalPanel" RowDefinitions="Auto, 20, *">
               <!-- Header Bar: Device Info & Session Status -->
               <Border Grid.Row="0" Background="#75111422" BorderBrush="#283048" BorderThickness="1" CornerRadius="12" Padding="20,16">
                  <Grid ColumnDefinitions="Auto, *, Auto">
                     <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="#1E2235" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconMobile}" Fill="#06B6D4" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                     </Border>
                     <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock x:Name="SessionDeviceTitle" Text="Device Session" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="SessionDeviceSub" Text="Ready for bidirectional file exchange" FontSize="12" Foreground="#94A3B8"/>
                     </StackPanel>
                     <Border Grid.Column="2" Background="#80151828" BorderBrush="#2A334E" BorderThickness="1" CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                           <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" BoxShadow="0 0 10 0 #10B981"/>
                           <TextBlock Text="Active Session" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                        </StackPanel>
                     </Border>
                  </Grid>
               </Border>

               <!-- Body: Two Spacious Columns for Send & Receive -->
               <Grid Grid.Row="2" ColumnDefinitions="*, 20, *">
                  
                  <!-- Left Column: Send Files to Device -->
                  <Border Grid.Column="0" Background="#75111422" BorderBrush="#283048" BorderThickness="1" CornerRadius="14" Padding="24" ClipToBounds="False">
                     <Grid RowDefinitions="Auto, 16, *, Auto">
                        <StackPanel Grid.Row="0" Spacing="4">
                           <TextBlock Text="SEND TO THIS DEVICE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandVioletBrush}" LetterSpacing="1"/>
                           <TextBlock Text="Select or drop any files to transfer instantly" FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>

                        <!-- Large Drop Zone & File Selection Card -->
                        <Border Grid.Row="2" Background="#80121626" BorderBrush="#2E3854" BorderThickness="1.5" CornerRadius="12" Padding="28" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                           <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                              <Border Width="64" Height="64" CornerRadius="32" Background="#1E2338" HorizontalAlignment="Center">
                                 <Path Data="{StaticResource IconSend}" Fill="#7C3AED" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                              </Border>
                              <TextBlock Text="Transfer Any Files or Media" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                              <TextBlock Text="Send documents, images, 4K videos, or archives" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                              <Button x:Name="SessionSendFilesBtn" Content="Choose Files to Send →" Click="SessionSendFiles_Click" Classes="PrimaryBtn" Padding="24,12" FontSize="13" HorizontalAlignment="Center"/>
                           </StackPanel>
                        </Border>

                        <!-- Staged/Sent Summary in Session -->
                        <Border Grid.Row="3" Margin="0,16,0,0" Padding="14,10" Background="#60151828" CornerRadius="8">
                           <TextBlock x:Name="SessionSendStatusText" Text="Ready to transmit files" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </Border>
                     </Grid>
                  </Border>

                  <!-- Right Column: Incoming Files from Device -->
                  <Border Grid.Column="2" Background="#75111422" BorderBrush="#283048" BorderThickness="1" CornerRadius="14" Padding="24" ClipToBounds="False">
                     <Grid RowDefinitions="Auto, 16, *">
                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                           <StackPanel Spacing="4">
                              <TextBlock Text="INCOMING FROM THIS DEVICE" FontSize="11" FontWeight="Bold" Foreground="#06B6D4" LetterSpacing="1"/>
                              <TextBlock Text="Files waiting for your approval" FontSize="12" Foreground="#94A3B8"/>
                           </StackPanel>
                           <TextBlock Grid.Column="1" x:Name="SessionIncomingCountText" Text="0 files" FontSize="11" Foreground="#10B981" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Grid.Row="2" Background="#80121626" BorderBrush="#2E3854" BorderThickness="1" CornerRadius="12" Padding="16">
                           <Grid>
                              <TextBlock x:Name="SessionIncomingEmptyLabel" Text="No pending file requests from this device" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                              <ScrollViewer>
                                 <ItemsControl x:Name="SessionIncomingFilesList">
                                    <ItemsControl.ItemTemplate>
                                       <DataTemplate x:DataType="views:StagedWebFile">
                                          <Border Classes="TrackRow" Padding="14,10" Margin="0,0,0,8" Background="#70151828" CornerRadius="8">
                                             <Grid ColumnDefinitions="*, Auto, Auto">
                                                <StackPanel VerticalAlignment="Center">
                                                   <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                   <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="#94A3B8"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Accept" Tag="{Binding}" Click="AcceptWebSharedFile_Click" Classes="PrimaryBtn" Padding="12,6" FontSize="10" Margin="0,0,8,0"/>
                                                <Button Grid.Column="2" Content="Reject" Tag="{Binding}" Click="RejectWebSharedFile_Click" Classes="GhostBtn" Padding="10,6" FontSize="10"/>
                                             </Grid>
                                          </Border>
                                       </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                 </ItemsControl>
                              </ScrollViewer>
                           </Grid>
                        </Border>
                     </Grid>
                  </Border>

               </Grid>
            </Grid>


            <!-- ========================================== -->
            <!-- 8. SETTINGS PANEL                          -->
            <!-- ========================================== -->
            <Grid x:Name="SettingsPanel" IsVisible="False" Classes="SignalPanel">
               <ScrollViewer>
                  <StackPanel Spacing="24" MaxWidth="640" HorizontalAlignment="Left">
                     
                     <!-- General Settings Card -->
                     <Border Classes="GlassCard" CornerRadius="8" Padding="28">
                        <StackPanel Spacing="24">
                           
                           <!-- Name Setting -->
                           <StackPanel Spacing="8">
                              <TextBlock Text="DEVICE NAME ON NETWORK" FontSize="11" FontWeight="Bold" Foreground="#B3B3B3" LetterSpacing="1.2"/>
                              <TextBox x:Name="SettingsDeviceName" TextChanged="SettingsDeviceName_TextChanged"/>
                              <TextBlock Text="This name will appear on radar and mobile web clients." FontSize="11" Foreground="#7C7C7C"/>
                           </StackPanel>

                           <!-- Permissions / Auto-Accept Setting -->
                           <Grid ColumnDefinitions="*, Auto">
                              <StackPanel Spacing="4" VerticalAlignment="Center">
                                 <TextBlock Text="AUTO-ACCEPT TRANSFERS" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                 <TextBlock Text="Automatically receive incoming files without prompt." FontSize="11" Foreground="#7C7C7C"/>
                              </StackPanel>
                              <ToggleSwitch Grid.Column="1" x:Name="AutoAcceptToggle" IsCheckedChanged="AutoAcceptSwitch_Changed"/>
                           </Grid>

                           <!-- Theme Setting -->
                           <Grid ColumnDefinitions="*, Auto">
                              <StackPanel Spacing="4" VerticalAlignment="Center">
                                 <TextBlock Text="DARK MODE" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                 <TextBlock Text="Obsidian Violet signature dark theme." FontSize="11" Foreground="#7C7C7C"/>
                              </StackPanel>
                              <ToggleSwitch Grid.Column="1" x:Name="ThemeToggle" IsChecked="True" IsCheckedChanged="ThemeSwitch_Changed"/>
                           </Grid>

                           <!-- Save Directory -->
                           <StackPanel Spacing="8">
                              <TextBlock Text="SAVE LOCATION" FontSize="11" FontWeight="Bold" Foreground="#B3B3B3" LetterSpacing="1.2"/>
                              <Grid ColumnDefinitions="*, Auto">
                                 <TextBlock x:Name="SettingsSaveLocationLabel" Text="C:\Downloads" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                 <Button Grid.Column="1" Content="CHANGE" Click="ChangeSaveLocation_Click" Classes="GhostBtn" Padding="14,6" FontSize="10" Margin="16,0,0,0"/>
                              </Grid>
                           </StackPanel>

                        </StackPanel>
                     </Border>

                     <!-- Updates Card -->
                     <Border Classes="GlassCard" CornerRadius="8" Padding="28">
                        <StackPanel Spacing="16">
                           <TextBlock Text="APPLICATION UPDATES" FontSize="11" FontWeight="Bold" Foreground="#B3B3B3" LetterSpacing="1.2"/>
                           <Grid ColumnDefinitions="*, Auto">
                              <StackPanel Spacing="4">
                                 <TextBlock x:Name="SettingsVersionText" Text="Version 1.1.0" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                                 <TextBlock x:Name="SettingsUpdateStatusText" Text="You are running the latest version" FontSize="11" Foreground="#7C7C7C"/>
                              </StackPanel>
                              <Button Grid.Column="1" x:Name="SettingsCheckUpdateBtn" Content="CHECK FOR UPDATES" Click="CheckForUpdate_Click" Classes="GhostBtn" Padding="14,8" FontSize="10"/>
                           </Grid>
                           <Button x:Name="SettingsDownloadInstallBtn" Content="INSTALL UPDATE" Click="DownloadInstallUpdate_Click" Classes="PrimaryBtn" IsVisible="False"/>
                           
                           <StackPanel x:Name="SettingsUpdateProgressPanel" IsVisible="False" Spacing="6">
                              <TextBlock x:Name="SettingsUpdateProgressText" Text="Downloading..." FontSize="11" Foreground="#B3B3B3"/>
                              <ProgressBar x:Name="SettingsUpdateProgressBar" Height="4"/>
                              <TextBlock x:Name="SettingsUpdateProgressPct" Text="0%" FontSize="10" Foreground="#7C3AED"/>
                           </StackPanel>
                        </StackPanel>
                     </Border>

                  </StackPanel>
               </ScrollViewer>
            </Grid>

            <!-- ========================================== -->
            <!-- 9. ABOUT PANEL                             -->
            <!-- ========================================== -->
            <Grid x:Name="AboutPanel" IsVisible="False" Classes="SignalPanel">
               <Border Classes="GlassCard" CornerRadius="8" Padding="32" MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Top">
                  <StackPanel Spacing="20">
                     <Border Width="48" Height="48" CornerRadius="24" Background="#7C3AED" HorizontalAlignment="Left">
                        <Rectangle Width="24" Height="24" Fill="#000000"><Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/SCAN.png"/></Rectangle.OpacityMask></Rectangle>
                     </Border>
                     <StackPanel Spacing="4">
                        <TextBlock Text="WE SHARE" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" LetterSpacing="1"/>
                        <TextBlock x:Name="AboutVersionText" Text="Version 1.1.0" FontSize="12" Foreground="#7C3AED" FontWeight="Bold"/>
                     </StackPanel>
                     <TextBlock Text="High-speed, zero-cloud peer-to-peer file sharing for Windows, macOS, Android, and iOS. Direct socket engine, raw-TCP HTTP web portal, and ad-hoc Desert Mode." FontSize="13" Foreground="#B3B3B3" TextWrapping="Wrap" LineHeight="20"/>
                     <Button Content="VISIT GITHUB REPOSITORY" Click="OpenGitHub_Click" Classes="GhostBtn" HorizontalAlignment="Left"/>
                  </StackPanel>
               </Border>
            </Grid>

          </Grid>
        </Grid>
      </Border>

    </Grid>

    <!-- =================================================== -->
    <!-- SPOTIFY "NOW TRANSFERRING" PLAYER DOCK (BOTTOM BAR) -->
    <!-- =================================================== -->
    <Border Grid.Row="1" Height="76" Classes="GlassCard" BorderBrush="#252A3E" BorderThickness="0,1,0,0" Padding="24,0" ZIndex="2000">
       <Grid ColumnDefinitions="280, *, 280">
          
          <!-- Left: Current Active File / Status -->
          <Grid Grid.Column="0" ColumnDefinitions="Auto, *" VerticalAlignment="Center">
             <Border Width="44" Height="44" CornerRadius="4" Classes="GlassCard" Margin="0,0,14,0" VerticalAlignment="Center">
                <Rectangle Width="20" Height="20" Fill="#7C3AED">
                   <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/SEND FILE.png"/></Rectangle.OpacityMask>
                </Rectangle>
             </Border>
             <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="BottomPlayerFileName" Text="WeShare Engine" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="BottomPlayerPeerName" Text="System Ready · Discoverable" FontSize="11" Foreground="#B3B3B3" TextTrimming="CharacterEllipsis"/>
             </StackPanel>
          </Grid>

          <!-- Center: Transfer Player Controls & Scrubber -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" MaxWidth="440" Width="440">
             <!-- Circular Action Control & Speed Badge -->
             <Grid ColumnDefinitions="*, Auto, *">
                <TextBlock Grid.Column="0" x:Name="BottomPlayerSpeed" Text="0.0 MB/s" FontSize="11" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                
                <Button Grid.Column="1" x:Name="BottomPlayerCancelBtn" Click="CancelActiveSend_Click" Classes="CircularPlay" Width="36" Height="36" CornerRadius="18">
                   <Rectangle Width="12" Height="12" Fill="#000000">
                      <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/SCAN.png"/></Rectangle.OpacityMask>
                   </Rectangle>
                </Button>

                <TextBlock Grid.Column="2" Text="Direct P2P" FontSize="10" Foreground="#7C7C7C" VerticalAlignment="Center" Margin="16,0,0,0"/>
             </Grid>

             <!-- Violet Accent Progress Bar -->
             <ProgressBar x:Name="BottomPlayerProgress" Height="4" Value="0" CornerRadius="2" Foreground="#7C3AED" Background="#333333"/>
          </StackPanel>

          <!-- Right: System Info & Folder Button -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
             <Button Content="OPEN FOLDER" Click="OpenDownloadFolder_Click" Classes="GhostBtn" Padding="14,8" FontSize="10"/>
             <Border Classes="GlassCard" CornerRadius="9999" Padding="12,6" VerticalAlignment="Center">
                <TextBlock Text="LOCAL NET" FontSize="10" FontWeight="Bold" Foreground="#7C3AED" LetterSpacing="1"/>
             </Border>
          </StackPanel>

       </Grid>
    </Border>

    <!-- ========================================== -->
    <!-- OVERLAYS & MODALS                          -->
    <!-- ========================================== -->

    <!-- Modal Incoming File Approval (Approval Dialog) -->
    <Grid x:Name="AcceptRejectPanel" IsVisible="False" Background="#90000000" ZIndex="5000">
       <Border Classes="GlassCard" CornerRadius="8" Padding="32" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 16 48 0 #80000000">
          <StackPanel Spacing="20">
             <Border Width="56" Height="56" CornerRadius="28" Background="#7C3AED" HorizontalAlignment="Center">
                <Rectangle Width="24" Height="24" Fill="#000000"><Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/RECEIVE FILE.png"/></Rectangle.OpacityMask></Rectangle>
             </Border>
             
             <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="INCOMING TRANSFER" FontSize="11" FontWeight="Bold" Foreground="#7C3AED" LetterSpacing="1.5" HorizontalAlignment="Center"/>
                <TextBlock x:Name="IncomingFileName" Text="file.zip" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="IncomingPeerName" Text="From: Peer" FontSize="12" Foreground="#B3B3B3" HorizontalAlignment="Center"/>
                <TextBlock x:Name="IncomingFileSize" Text="0 MB" FontSize="11" Foreground="#7C7C7C" HorizontalAlignment="Center"/>
             </StackPanel>

             <Grid ColumnDefinitions="*, 12, *">
                <Button Grid.Column="0" Content="DECLINE" Click="RejectTransfer_Click" Classes="GhostBtn" HorizontalAlignment="Stretch" TextElement.Foreground="#F3727F"/>
                <Button Grid.Column="2" Content="ACCEPT" Click="AcceptTransfer_Click" Classes="PrimaryBtn" HorizontalAlignment="Stretch"/>
             </Grid>
          </StackPanel>
       </Border>
    </Grid>

    <!-- Manual IP Dialog -->
    <Grid x:Name="ManualIPDialog" IsVisible="False" Background="#90000000" ZIndex="4500">
       <Border Classes="GlassCard" CornerRadius="8" Padding="28" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="16">
             <TextBlock Text="CONNECT BY IP" FontSize="12" FontWeight="Bold" Foreground="#7C3AED" LetterSpacing="1.2"/>
             <TextBox x:Name="ManualIPInput" Watermark="192.168.1.xxx"/>
             <Button Content="CONNECT" Classes="PrimaryBtn" HorizontalAlignment="Stretch"/>
          </StackPanel>
       </Border>
    </Grid>

    <!-- Drag Overlay -->
    <Panel x:Name="DragOverlay" IsVisible="False" Background="#C0121212" ZIndex="6000">
       <Border BorderBrush="#7C3AED" BorderThickness="2" CornerRadius="8" Margin="24">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
             <Border Width="72" Height="72" CornerRadius="36" Background="#7C3AED" HorizontalAlignment="Center">
                <Rectangle Width="32" Height="32" Fill="#000000"><Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/SEND FILE.png"/></Rectangle.OpacityMask></Rectangle>
             </Border>
             <TextBlock Text="DROP FILES ANYWHERE TO SHARE" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" LetterSpacing="1"/>
          </StackPanel>
       </Border>
    </Panel>

    <!-- Toast Notification (Top Right Floating Pill) -->
    <Border x:Name="ToastBorder" IsVisible="False" Background="#7C3AED" CornerRadius="9999" Padding="20,10" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,24,0,0" ZIndex="7000" BoxShadow="0 8 24 0 #40000000">
       <TextBlock x:Name="ToastMessage" Text="Action completed" FontSize="12" FontWeight="Bold" Foreground="#000000"/>
    </Border>

    <!-- Hidden compatibility elements -->
    <Border x:Name="BottomNav" IsVisible="False"/>
    <Grid x:Name="SplashGrid" IsVisible="False"/>

  </Grid>
</UserControl>
