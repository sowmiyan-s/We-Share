<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WeShare.UI.Views"
             xmlns:models="using:WeShare.Core.Models"
             xmlns:views="using:WeShare.UI.Views"
             x:Class="WeShare.UI.Views.MainView"
             x:DataType="views:MainView"
             FontFamily="Sora, Inter, Segoe UI Variable Display, sans-serif">

  <UserControl.Resources>
    <local:ProgressToWidthConverter x:Key="ProgressToWidthConverter"/>
    <local:FileSizeConverter x:Key="FileSizeConverter"/>
    <local:RadarPositionConverter x:Key="RadarPos"/>

    <!-- Dynamic Theme-Aware Brushes -->
    <SolidColorBrush x:Key="DeepSlateBrush" Color="{DynamicResource DeepSlate}"/>
    <SolidColorBrush x:Key="ElectricIndigoBrush" Color="{DynamicResource ElectricIndigo}"/>
    <SolidColorBrush x:Key="ElectricIndigoDimBrush" Color="{DynamicResource ElectricIndigoDim}"/>
    <SolidColorBrush x:Key="TealSuccessBrush" Color="{DynamicResource TealAccent}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondary}"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Sidebar Items (Pill Styling) -->
    <Style Selector="Button.SidebarItem">
      <Setter Property="Background"          Value="Transparent"/>
      <Setter Property="Padding"             Value="16,12"/>
      <Setter Property="Margin"              Value="12,2"/>
      <Setter Property="CornerRadius"        Value="8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.SidebarItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0FFFFFFF"/>
    </Style>
    <Style Selector="Button.SidebarItem.Active /template/ ContentPresenter">
      <Setter Property="Background"     Value="#156366F1"/>
      <Setter Property="BorderBrush"    Value="{StaticResource ElectricIndigoBrush}"/>
      <Setter Property="BorderThickness" Value="3,0,0,0"/>
    </Style>
    <Style Selector="Button.SidebarItem TextBlock">
       <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="FontSize" Value="13"/>
       <Setter Property="LetterSpacing" Value="0.5"/>
    </Style>
    <Style Selector="Button.SidebarItem.Active TextBlock">
       <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
       <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.SidebarItem Rectangle.IconTint">
       <Setter Property="Opacity" Value="0.6"/>
       <Setter Property="Fill" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style Selector="Button.SidebarItem.Active Rectangle.IconTint">
       <Setter Property="Opacity" Value="1"/>
       <Setter Property="Fill" Value="{DynamicResource TextPrimary}"/>
    </Style>

    <!-- Glass Cards (Rounded and Soft Shadowed) -->
    <Style Selector="Border.GlassCard">
        <Setter Property="Background" Value="{DynamicResource GlassBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="BoxShadow" Value="0 8 32 0 #15000000"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.GlassCard:pointerover">
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
    </Style>

    <!-- Buttons -->
    <Style Selector="Button.PrimaryBtn">
       <Setter Property="Background" Value="{StaticResource ElectricIndigoBrush}"/>
       <Setter Property="Foreground" Value="White"/>
       <Setter Property="Padding" Value="20,12"/>
       <Setter Property="CornerRadius" Value="8"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="FontSize" Value="13"/>
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Setter Property="Transitions">
          <Transitions>
             <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
             <BrushTransition Property="Background" Duration="0:0:0.1"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Button.PrimaryBtn:pointerover /template/ ContentPresenter">
       <Setter Property="Background" Value="{StaticResource ElectricIndigoDimBrush}"/>
       <Setter Property="RenderTransform" Value="scale(1.03)"/>
    </Style>
    <Style Selector="Button.PrimaryBtn:pressed">
       <Setter Property="RenderTransform" Value="scale(0.97)"/>
    </Style>

    <!-- Dashboard Action Buttons -->
    <Style Selector="Button.DashboardActionBtn">
       <Setter Property="Background" Value="Transparent"/>
       <Setter Property="Padding" Value="0"/>
       <Setter Property="BorderThickness" Value="0"/>
       <Setter Property="HorizontalAlignment" Value="Stretch"/>
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Setter Property="Transitions">
          <Transitions>
             <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Button.DashboardActionBtn:pointerover">
       <Setter Property="RenderTransform" Value="scale(1.02)"/>
    </Style>
    <Style Selector="Button.DashboardActionBtn:pointerover Border.GlassCard">
       <Setter Property="Background" Value="#1A6366F1"/>
       <Setter Property="BorderBrush" Value="#806366F1"/>
       <Setter Property="BoxShadow" Value="0 12 30 0 #256366F1"/>
    </Style>
    <Style Selector="Button.DashboardActionBtn:pressed">
       <Setter Property="RenderTransform" Value="scale(0.98)"/>
    </Style>

    <!-- Circular Action Buttons -->
    <Style Selector="Button.CircleAction">
       <Setter Property="Background" Value="{DynamicResource GlassBackgroundBrush}"/>
       <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
       <Setter Property="BorderThickness" Value="1"/>
       <Setter Property="Width" Value="120"/>
       <Setter Property="Height" Value="120"/>
       <Setter Property="Padding" Value="0"/>
       <Setter Property="CornerRadius" Value="60"/>
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Setter Property="HorizontalContentAlignment" Value="Center"/>
       <Setter Property="VerticalContentAlignment" Value="Center"/>
       <Setter Property="Template">
         <ControlTemplate>
           <Border x:Name="RootBorder"
                   Background="{TemplateBinding Background}"
                   BorderBrush="{TemplateBinding BorderBrush}"
                   BorderThickness="{TemplateBinding BorderThickness}"
                   CornerRadius="{TemplateBinding CornerRadius}"
                   ClipToBounds="True">
             <ContentPresenter x:Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
           </Border>
         </ControlTemplate>
       </Setter>
       <Setter Property="Transitions">
          <Transitions>
             <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="QuarticEaseOut"/>
             <BrushTransition Property="Background" Duration="0:0:0.2"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Button.CircleAction:pointerover">
       <Setter Property="Background" Value="#1A6366F1"/>
       <Setter Property="BorderBrush" Value="{StaticResource ElectricIndigoBrush}"/>
       <Setter Property="RenderTransform" Value="scale(1.1)"/>
    </Style>
    <Style Selector="Button.CircleAction:pressed">
       <Setter Property="RenderTransform" Value="scale(0.92)"/>
    </Style>

    <!-- Signal Panels -->
    <Style Selector="Grid.SignalPanel">
       <Setter Property="Opacity" Value="0"/>
       <Setter Property="ClipToBounds" Value="False"/>
       <Setter Property="Transitions">
          <Transitions>
             <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="QuarticEaseOut"/>
             <ThicknessTransition Property="Margin" Duration="0:0:0.5" Easing="QuarticEaseOut"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Grid.SignalPanel[IsVisible=True]">
       <Setter Property="Opacity" Value="1"/>
       <Setter Property="Margin" Value="48,32,48,48"/>
    </Style>
    <Style Selector="Grid.SignalPanel[IsVisible=False]">
       <Setter Property="Margin" Value="48,64,48,16"/>
    </Style>

    <!-- Generic List Item Hover Effects -->
     <Style Selector="ItemsControl Border.GlassCard:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource ElectricIndigoBrush}"/>
        <Setter Property="Background" Value="#0AFFFFFF"/>
     </Style>
     
     <!-- Filter Chips -->
     <Style Selector="Button.FilterChip">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Transitions">
           <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.15"/>
              <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
              <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
           </Transitions>
        </Setter>
     </Style>
     <Style Selector="Button.FilterChip:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#10FFFFFF"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
     </Style>
     <Style Selector="Button.FilterChip.ActiveChip /template/ ContentPresenter">
        <Setter Property="Background" Value="#156366F1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource ElectricIndigoBrush}"/>
     </Style>
  </UserControl.Styles>

  <Grid>
    <!-- GLOBAL BACKGROUND -->
    <Panel Background="{DynamicResource BaseBackgroundBrush}"/>

    <Grid ColumnDefinitions="280, *" x:Name="MainLayout">
      <!-- SIDEBAR -->
      <Border Grid.Column="0" x:Name="Sidebar" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto, *, Auto" Margin="0,48,0,32">

          <!-- Brand -->
          <StackPanel Grid.Row="0" Margin="32,0,32,48" Spacing="8" Background="Transparent" PointerPressed="TitleBar_PointerPressed">
             <StackPanel Orientation="Horizontal" Spacing="12">
                <Image Source="/Assets/logo.png" Width="32" Height="32" Stretch="Uniform" Opacity="1"/>
                <TextBlock Text="WE SHARE" FontSize="14" FontWeight="Bold" LetterSpacing="3"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                           FontFamily="Sora, sans-serif"/>
             </StackPanel>
             <Rectangle Height="1" Fill="{DynamicResource GlassBorderBrush}" Margin="0,16,0,0"/>
          </StackPanel>

          <!-- Navigation -->
          <StackPanel Grid.Row="1" Spacing="4">
            <Button Classes="SidebarItem" x:Name="NavHomeBtn" Click="NavHome_Click">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Rectangle Classes="IconTint" Width="18" Height="18">
                   <Rectangle.OpacityMask>
                      <ImageBrush Source="/Assets/Icons/HOME.png"/>
                   </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Text="HOME"/>
              </StackPanel>
            </Button>
            <Button Classes="SidebarItem" x:Name="NavFilesBtn" Click="NavFiles_Click">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Rectangle Classes="IconTint" Width="18" Height="18">
                   <Rectangle.OpacityMask>
                      <ImageBrush Source="/Assets/Icons/LIBRARY.png"/>
                   </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Text="LIBRARY"/>
              </StackPanel>
            </Button>
            <Button Classes="SidebarItem" x:Name="NavTransfersBtn" Click="NavTransfers_Click">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Rectangle Classes="IconTint" Width="18" Height="18">
                   <Rectangle.OpacityMask>
                      <ImageBrush Source="/Assets/Icons/SCAN.png"/>
                   </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Text="TRANSFERS"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Bottom Status -->
          <StackPanel Grid.Row="2" Margin="24,0" Spacing="16">
            <Button Classes="SidebarItem" x:Name="NavSettBtn" Click="NavSettings_Click" Padding="8,8">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Rectangle Classes="IconTint" Width="18" Height="18">
                   <Rectangle.OpacityMask>
                      <ImageBrush Source="/Assets/Icons/SETTINGS.png"/>
                   </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Text="SETTINGS"/>
              </StackPanel>
            </Button>
            <Button Classes="SidebarItem" x:Name="NavAboutBtn" Click="NavAbout_Click">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <Rectangle Classes="IconTint" Width="18" Height="18">
                   <Rectangle.OpacityMask>
                      <ImageBrush Source="/Assets/Icons/WEBSITE.png"/>
                   </Rectangle.OpacityMask>
                </Rectangle>
                <TextBlock Text="ABOUT APP"/>
              </StackPanel>
            </Button>

            <!-- Device status card in Sidebar -->
            <Border Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="16,14" CornerRadius="10" Margin="12,0">
               <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*, Auto">
                     <TextBlock Text="DEVICE IDENTITY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2" VerticalAlignment="Center"/>
                     <Border Grid.Column="1" Classes="NetworkSignalPulse" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock x:Name="SidebarDeviceName" Text="SOWMIYAN-S" FontSize="13"
                             FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                  <Border Background="#10FFFFFF" CornerRadius="6" Padding="6,4" HorizontalAlignment="Left" Margin="0,4,0,0">
                     <TextBlock x:Name="SidebarNetworkInfo" Text="0.0.0.0:0" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                  </Border>
               </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- CONTENT AREA -->
      <Grid Grid.Column="1" RowDefinitions="Auto, *" x:Name="ContentArea">
        
        <!-- Activity Bar -->
        <Border x:Name="GlobalActivityBorder" IsVisible="False" Height="3" Background="Transparent" VerticalAlignment="Top" ZIndex="1000">
           <ProgressBar x:Name="GlobalProgressBar" IsIndeterminate="False" Height="3" Foreground="{StaticResource ElectricIndigoBrush}" Background="Transparent" BorderThickness="0"/>
        </Border>

        <!-- Header -->
        <Border Grid.Row="0" Height="100" Padding="48,0" Background="Transparent" PointerPressed="TitleBar_PointerPressed"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1">
           <Grid ColumnDefinitions="*, Auto">
              <StackPanel VerticalAlignment="Center" Spacing="4">
                 <TextBlock x:Name="PageTitle" Text="HOME" FontSize="26" FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}" LetterSpacing="1"/>
              </StackPanel>
           </Grid>
        </Border>

        <!-- Dynamic Content -->
        <Grid Grid.Row="1">
            
            <!-- Wizard Progress Indicator -->
            <StackPanel x:Name="SendStepWizard" IsVisible="False" Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" ZIndex="100">
               <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock x:Name="Step1Indicator" Text="1. SELECT FILES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ElectricIndigoBrush}"/>
                  <Rectangle Width="40" Height="1" Fill="{DynamicResource GlassBorderBrush}" VerticalAlignment="Center"/>
               </StackPanel>
               <TextBlock x:Name="Step2Indicator" Text="2. CHOOSE RECEIVER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>

          <!-- HOME DASHBOARD -->
          <Grid x:Name="HomePanel" Classes="SignalPanel" RowDefinitions="Auto, *" ClipToBounds="False">
             <!-- Welcome Banner -->
             <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,24">
                <StackPanel Spacing="6">
                   <TextBlock Text="Welcome back," FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                   <TextBlock Text="Ready to share files locally" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
                <!-- Live speed badge -->
                <Border Grid.Column="1" Background="#186366F1" BorderBrush="{StaticResource ElectricIndigoBrush}" BorderThickness="1"
                        CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                   <TextBlock x:Name="HomeSpeedBadge" IsVisible="False" Text="↑ 0.0 MB/s"
                              FontSize="11" FontWeight="Bold" Foreground="{StaticResource ElectricIndigoBrush}"/>
                </Border>
             </Grid>

             <!-- Dashboard Grid -->
             <Grid Grid.Row="1" ColumnDefinitions="*, 24, 350">
                <!-- Left Column: Actions and Recent List -->
                <Grid Grid.Column="0" RowDefinitions="Auto, 24, *">
                   <!-- Send/Receive Action Buttons -->
                   <Grid Grid.Row="0" ColumnDefinitions="*, 20, *">
                      
                      <!-- Send Card -->
                      <Button Grid.Column="0" Classes="DashboardActionBtn" Click="HomeSend_Click" HorizontalAlignment="Stretch">
                         <Border Classes="GlassCard" Padding="24" CornerRadius="12" Height="180">
                            <Grid RowDefinitions="Auto, *, Auto">
                               <Rectangle Grid.Row="0" Width="36" Height="36" Fill="{DynamicResource ElectricIndigoBrush}" HorizontalAlignment="Left">
                                  <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/SEND FILE.png"/></Rectangle.OpacityMask>
                               </Rectangle>
                               <StackPanel Grid.Row="2" Spacing="6">
                                  <TextBlock Text="Send Files" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                  <TextBlock Text="Drag and drop or select files to send to peers" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                         </Border>
                      </Button>
                      
                      <!-- Receive Card -->
                      <Button Grid.Column="2" Classes="DashboardActionBtn" Click="NavReceiveMode_Click" HorizontalAlignment="Stretch">
                         <Border Classes="GlassCard" Padding="24" CornerRadius="12" Height="180">
                            <Grid RowDefinitions="Auto, *, Auto">
                               <Rectangle Grid.Row="0" Width="36" Height="36" Fill="{DynamicResource ElectricIndigoBrush}" HorizontalAlignment="Left">
                                  <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/RECEIVE FILE.png"/></Rectangle.OpacityMask>
                               </Rectangle>
                               <StackPanel Grid.Row="2" Spacing="6">
                                  <TextBlock Text="Receive Files" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                  <TextBlock Text="Make this device discoverable on your Wi-Fi" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                               </StackPanel>
                            </Grid>
                         </Border>
                      </Button>
                      
                   </Grid>

                   <!-- Recent Activity Section -->
                   <Border Grid.Row="2" Classes="GlassCard" CornerRadius="12" Padding="24">
                      <Grid RowDefinitions="Auto, *">
                         <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                            <TextBlock Text="RECENT ACTIVITY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="VIEW LIBRARY" Click="NavFiles_Click" Foreground="{DynamicResource ElectricIndigoBrush}" Background="Transparent" FontSize="11" Padding="4" FontWeight="Bold"/>
                         </Grid>
                         
                         <!-- Mini history list -->
                         <Grid Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding ReceivedFiles, RelativeSource={RelativeSource AncestorType=views:MainView}}" MaxHeight="240">
                               <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="models:FileTransferState">
                                     <Border BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="0,12" Margin="0,0,0,4">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                           <Border Width="36" Height="36" Background="#10FFFFFF" CornerRadius="8">
                                              <Rectangle Classes="IconTint" Width="16" Height="16"><Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/LIBRARY.png"/></Rectangle.OpacityMask></Rectangle>
                                           </Border>
                                           <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                              <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                              <TextBlock Text="{Binding FileSizeDisplay}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                           </StackPanel>
                                           <Border Grid.Column="2" Background="#1010B981" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                              <TextBlock Text="RECEIVED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TealSuccessBrush}"/>
                                           </Border>
                                        </Grid>
                                     </Border>
                                  </DataTemplate>
                               </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="HomeEmptyHistoryLabel" Text="No recent transfers" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.3" FontSize="12" FontWeight="SemiBold"/>
                         </Grid>
                      </Grid>
                   </Border>
                </Grid>

                <!-- Right Column: Network info & Tips -->
                <StackPanel Grid.Column="2" Spacing="24">
                   <!-- Network Identity Widget -->
                   <Border Classes="GlassCard" Padding="24" CornerRadius="12">
                      <StackPanel Spacing="20">
                         <TextBlock Text="NETWORK IDENTITY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                         
                         <StackPanel Spacing="8">
                            <TextBlock Text="Device Name" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="HomeDeviceNameText" Text="SOWMIYAN-S" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                         </StackPanel>

                         <StackPanel Spacing="8">
                            <TextBlock Text="Local IP &amp; Port" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                            <Border Background="#10FFFFFF" CornerRadius="8" Padding="12,10" HorizontalAlignment="Stretch">
                               <Grid ColumnDefinitions="Auto, *">
                                  <Border Classes="NetworkSignalPulse" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                  <TextBlock Grid.Column="1" x:Name="HomeNetworkInfoText" Text="0.0.0.0:0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                               </Grid>
                            </Border>
                         </StackPanel>

                         <StackPanel Spacing="8">
                          <StackPanel Spacing="8">
                             <TextBlock Text="Web Portal (Mobile Share)" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                             <Border Background="#10FFFFFF" CornerRadius="8" Padding="12,10" HorizontalAlignment="Stretch">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                   <Border Classes="WebPortalPulse" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                   <TextBlock Grid.Column="1" x:Name="HomeWebPortalText" Text="http://0.0.0.0:8080" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                   <Button Grid.Column="2" x:Name="CopyWebLinkBtn" Click="CopyWebLink_Click"
                                           Background="#186366F1" BorderBrush="{StaticResource ElectricIndigoBrush}" BorderThickness="1"
                                           CornerRadius="6" Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Center"
                                           ToolTip.Tip="Copy link to clipboard">
                                      <StackPanel Orientation="Horizontal" Spacing="5">
                                         <Rectangle Width="12" Height="12" Fill="{StaticResource ElectricIndigoBrush}">
                                            <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/WEBSITE.png"/></Rectangle.OpacityMask>
                                         </Rectangle>
                                         <TextBlock Text="COPY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource ElectricIndigoBrush}"/>
                                      </StackPanel>
                                   </Button>
                                </Grid>
                             </Border>
                          </StackPanel></StackPanel>

                          <!-- QR Code panel -->
                          <Border Background="#08FFFFFF" CornerRadius="10" Padding="12" HorizontalAlignment="Stretch">
                             <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="SCAN TO OPEN PORTAL" FontSize="9" FontWeight="Bold" LetterSpacing="2"
                                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                                <Border Width="120" Height="120" CornerRadius="8" ClipToBounds="True"
                                        Background="White" Padding="6">
                                   <Image x:Name="HomeQrImage" Stretch="Uniform"/>
                                </Border>
                             </StackPanel>
                          </Border>

                         <Rectangle Height="1" Fill="{DynamicResource GlassBorderBrush}"/>
                         
                         <Button Classes="PrimaryBtn" Content="CONNECT VIA IP" Click="ManualConnect_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                      </StackPanel>
                   </Border>
                   
                   <!-- Tips -->
                   <Border Classes="GlassCard" Padding="20" CornerRadius="12">
                      <StackPanel Spacing="12">
                         <TextBlock Text="QUICK TIPS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                         <TextBlock Text="• Drag &amp; drop files directly onto this window to start sending immediately." FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="16"/>
                         <TextBlock Text="• Ensure target devices are connected to the same Wi-Fi network and have We Share open." FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" LineHeight="16"/>
                      </StackPanel>
                   </Border>
                </StackPanel>
             </Grid>
          </Grid>

          <!-- RECEIVE RADAR -->
          <Grid x:Name="ReceiveModePanel" IsVisible="False" Classes="SignalPanel">
             <Grid>
                <Panel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520" Height="520">
                   <!-- Radial background glow -->
                   <Ellipse Width="400" Height="400">
                      <Ellipse.Fill>
                         <RadialGradientBrush Center="50%,50%" Radius="0.5">
                            <GradientStop Offset="0" Color="{StaticResource ElectricIndigo}"/>
                            <GradientStop Offset="1" Color="Transparent"/>
                         </RadialGradientBrush>
                      </Ellipse.Fill>
                      <Ellipse.Opacity>0.1</Ellipse.Opacity>
                   </Ellipse>
                   
                   <Ellipse Width="520" Height="520" Stroke="{DynamicResource RadarRingBrush}" StrokeThickness="1" Opacity="0.5"/>
                   <Ellipse Width="420" Height="420" Stroke="{DynamicResource GlassBorderBrush}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.3"/>
                   <Ellipse Width="180" Height="180" Stroke="{DynamicResource GlassBorderBrush}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.3"/>
                   
                   <!-- Concentric Ripple Waves -->
                   <Ellipse Classes="RadarPulse" Width="320" Height="320" Fill="{StaticResource ElectricIndigoBrush}"/>
                   <Ellipse Classes="RadarPulseInner" Width="320" Height="320" Fill="{StaticResource ElectricIndigoBrush}"/>

                   <!-- Rotating Scanner Sweep -->
                   <Border Width="520" Height="520" CornerRadius="260" Classes="RadarScan">
                      <Border.RenderTransform><RotateTransform/></Border.RenderTransform>
                      <Panel Width="520" Height="520">
                         <Path Data="M 0,0 L 260,0 A 260,260 0 0 0 212.9,-149.1 Z"
                                Fill="{StaticResource ElectricIndigoBrush}" Opacity="0.15">
                            <Path.RenderTransform>
                               <TranslateTransform X="260" Y="260"/>
                            </Path.RenderTransform>
                         </Path>
                         <Rectangle Width="260" Height="1" Fill="White" Opacity="0.4" 
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    StrokeDashArray="4,4"/>
                      </Panel>
                   </Border>

                   <!-- Center Hub -->
                   <Border Width="100" Height="100" Background="{StaticResource ElectricIndigoBrush}" CornerRadius="50" BoxShadow="0 0 35 0 #806366F1">
                      <Rectangle Width="36" Height="36" Fill="White">
                         <Rectangle.OpacityMask>
                            <ImageBrush Source="/Assets/Icons/SCAN.png"/>
                         </Rectangle.OpacityMask>
                      </Rectangle>
                   </Border>

                   <!-- Floating Devices List -->
                   <ItemsControl ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=views:MainView}}">
                      <ItemsControl.ItemsPanel>
                         <ItemsPanelTemplate>
                            <Canvas Width="520" Height="520" Background="Transparent"/>
                         </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                         <DataTemplate x:DataType="models:DeviceModel">
                             <Button Click="SendFile_Click" Background="Transparent" Padding="0" BorderThickness="0" ClipToBounds="False">
                               <Button.Styles>
                                  <Style Selector="Button:pointerover /template/ ContentPresenter">
                                     <Setter Property="Background" Value="Transparent"/>
                                  </Style>
                                  <Style Selector="Button:pointerover Border.DeviceMarker">
                                     <Setter Property="BorderBrush" Value="White"/>
                                     <Setter Property="BoxShadow" Value="0 12 35 0 #506366F1"/>
                                  </Style>
                               </Button.Styles>
                               <StackPanel Spacing="10" HorizontalAlignment="Center" ClipToBounds="False">
                                  <Border Classes="DeviceMarker" Width="64" Height="64" Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{StaticResource ElectricIndigoBrush}" BorderThickness="2" CornerRadius="32" BoxShadow="0 8 25 0 #30000000">
                                     <Rectangle Width="28" Height="28" Fill="{StaticResource ElectricIndigoBrush}">
                                        <Rectangle.OpacityMask>
                                           <ImageBrush Source="/Assets/Icons/RECEIVE FILE.png"/>
                                        </Rectangle.OpacityMask>
                                     </Rectangle>
                                  </Border>
                                  <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                               </StackPanel>
                             </Button>
                          </DataTemplate>
                       </ItemsControl.ItemTemplate>
                       <ItemsControl.Styles>
                          <Style Selector="ContentPresenter">
                             <Setter Property="Canvas.Left">
                                <MultiBinding Converter="{StaticResource RadarPos}">
                                   <Binding />
                                   <Binding Path="Devices" RelativeSource="{RelativeSource AncestorType=views:MainView}"/>
                                   <Binding Source="X"/>
                                </MultiBinding>
                             </Setter>
                             <Setter Property="Canvas.Top">
                                <MultiBinding Converter="{StaticResource RadarPos}">
                                   <Binding />
                                   <Binding Path="Devices" RelativeSource="{RelativeSource AncestorType=views:MainView}"/>
                                   <Binding Source="Y"/>
                                </MultiBinding>
                             </Setter>
                             <Setter Property="Transitions">
                                <Transitions>
                                   <DoubleTransition Property="Canvas.Left" Duration="0:0:1.5" Easing="QuarticEaseOut"/>
                                   <DoubleTransition Property="Canvas.Top" Duration="0:0:1.5" Easing="QuarticEaseOut"/>
                                 </Transitions>
                             </Setter>
                          </Style>
                       </ItemsControl.Styles>
                    </ItemsControl>

                </Panel>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,48" Spacing="24">
                   <TextBlock Text="READY TO RECEIVE" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" LetterSpacing="4" HorizontalAlignment="Center"/>
                   <TextBlock Text="Visible to devices on your local network" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Opacity="0.7"/>
                   <Button Classes="PrimaryBtn" Content="CANCEL BROADCAST" Click="NavHome_Click" Width="200" Margin="0,16,0,0"/>
                </StackPanel>
             </Grid>
          </Grid>

          <!-- TRANSFERS PANEL (Active Transfers) -->
          <Grid x:Name="TransfersPanel" IsVisible="False" Classes="SignalPanel">
              <ScrollViewer>
                  <StackPanel Spacing="32">
                      <TextBlock Text="LIVE TRANSFERS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                      
                      <!-- Active Sends -->
                      <Border x:Name="SendProgressBorder" IsVisible="False" Classes="GlassCard" Background="#156366F1" Padding="28" CornerRadius="12">
                          <StackPanel Spacing="16">
                             <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="SENDING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ElectricIndigoBrush}" LetterSpacing="2"/>
                                <Button Grid.Column="1" Content="✕ CANCEL" Click="CancelActiveSend_Click" Background="Transparent" Foreground="#FF5555" FontSize="10" FontWeight="Bold" Padding="4"/>
                             </Grid>
                             <Grid ColumnDefinitions="*, Auto">
                                <TextBlock x:Name="SendProgressFile" Text="Processing..." FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14"/>
                                <TextBlock Grid.Column="1" x:Name="SendProgressPct" Text="0%" FontWeight="Bold" Foreground="{StaticResource ElectricIndigoBrush}"/>
                             </Grid>
                             <ProgressBar x:Name="SendProgressBar" Height="6" CornerRadius="3" Foreground="{StaticResource ElectricIndigoBrush}" Background="#20FFFFFF"/>
                             <TextBlock x:Name="SendProgressSpeed" Text="0 MB/s" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                          </StackPanel>
                      </Border>

                      <!-- Active Receives -->
                      <Border Classes="GlassCard" MinHeight="200" CornerRadius="12" Padding="8">
                          <Grid>
                              <ItemsControl x:Name="IncomingList">
                                  <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="models:FileTransferState">
                                          <Border BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="20">
                                              <StackPanel Spacing="12">
                                                  <Grid ColumnDefinitions="*, Auto">
                                                      <TextBlock Text="RECEIVING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ElectricIndigoBrush}" LetterSpacing="2"/>
                                                      <Button Grid.Column="1" Content="✕ CANCEL" Click="CancelIncoming_Click" Background="Transparent" Foreground="#FF5555" FontSize="10" FontWeight="Bold" Padding="4"/>
                                                  </Grid>
                                                  <Grid ColumnDefinitions="*, Auto">
                                                      <TextBlock Text="{Binding FileName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                      <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat=\{0:F0\}%}" Foreground="{StaticResource ElectricIndigoBrush}" FontWeight="Bold"/>
                                                  </Grid>
                                                  <ProgressBar Height="6" Value="{Binding ProgressPercentage}" Foreground="{StaticResource ElectricIndigoBrush}" Background="#10FFFFFF" CornerRadius="3"/>
                                                  <Grid ColumnDefinitions="*, Auto">
                                                      <TextBlock Text="{Binding PeerName}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                      <TextBlock Grid.Column="1" Text="{Binding SpeedMbPerSec, StringFormat=\{0:F2\} MB/s}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                  </Grid>
                                              </StackPanel>
                                          </Border>
                                      </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock x:Name="RecvEmptyState" Text="NO ACTIVE TRANSFERS" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.3" FontSize="12" FontWeight="Bold" LetterSpacing="2"/>
                          </Grid>
                      </Border>
                      <Button Classes="PrimaryBtn" Content="GO TO LIBRARY" Click="NavFiles_Click" HorizontalAlignment="Center"/>
                  </StackPanel>
              </ScrollViewer>
          </Grid>

          <!-- SEND STEP 1: Files Selection -->
          <Grid x:Name="SendFilesPanel" IsVisible="False" Classes="SignalPanel" RowDefinitions="*, Auto" DragDrop.AllowDrop="True">
             <ScrollViewer Grid.Row="0">
                <StackPanel Spacing="32">
                   <Grid ColumnDefinitions="*, Auto">
                      <TextBlock Text="QUEUE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Classes="PrimaryBtn" Content="+ ADD FILES" Click="BrowseFiles_Click"/>
                   </Grid>
                   
                   <Border Classes="GlassCard" MinHeight="340" CornerRadius="12" Padding="8">
                      <Grid>
                         <ItemsControl x:Name="SendQueueList">
                            <ItemsControl.ItemTemplate>
                               <DataTemplate x:DataType="views:QueueItem">
                                  <Border Classes="GlassCard" Padding="16,14" Margin="8,4" CornerRadius="8">
                                     <Grid ColumnDefinitions="Auto, *, Auto">
                                         <Grid Margin="0,0,16,0" Width="40" Height="40">
                                             <Border Background="#10FFFFFF" CornerRadius="6">
                                                <Rectangle Classes="IconTint" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Rectangle.OpacityMask>
                                                        <ImageBrush Source="/Assets/Icons/LIBRARY.png"/>
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                             </Border>
                                             <Border CornerRadius="6" ClipToBounds="True">
                                                 <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                             </Border>
                                         </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                           <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}"/>
                                           <TextBlock Text="{Binding Size, Converter={StaticResource FileSizeConverter}}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="✕" Click="RemoveFromQueue_Click" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Padding="8"/>
                                     </Grid>
                                  </Border>
                               </DataTemplate>
                            </ItemsControl.ItemTemplate>
                         </ItemsControl>
                         
                         <!-- Empty Queue Label -->
                         <StackPanel x:Name="QueueEmptyLabel" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.4" Spacing="16">
                            <Rectangle Classes="IconTint" Width="40" Height="40" Opacity="0.3">
                               <Rectangle.OpacityMask>
                                  <ImageBrush Source="/Assets/Icons/LIBRARY.png"/>
                               </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="SELECT FILES TO BEGIN" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                         </StackPanel>
                      </Grid>
                   </Border>

                </StackPanel>
             </ScrollViewer>
             
             <Border Grid.Row="1" Margin="0,24,0,0" x:Name="SendFooter" IsVisible="False" Classes="GlassCard" Padding="24,20" CornerRadius="12">
                <Grid ColumnDefinitions="*, Auto">
                   <StackPanel VerticalAlignment="Center">
                      <TextBlock x:Name="SendSummaryText" Text="0 files selected" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="14"/>
                      <TextBlock Text="Ready for next step" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                   </StackPanel>
                   <Button Grid.Column="1" Classes="PrimaryBtn" Content="CHOOSE RECEIVER" Width="200" HorizontalContentAlignment="Center" Click="NavSendDiscovery_Click"/>
                </Grid>
             </Border>
          </Grid>

          <!-- SEND STEP 2: Peer Discovery -->
          <Grid x:Name="SendDiscoveryPanel" IsVisible="False" Classes="SignalPanel">
             <Grid>
                <Panel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520" Height="520" ClipToBounds="False">
                   <Ellipse Width="400" Height="400">
                      <Ellipse.Fill>
                         <RadialGradientBrush Center="50%,50%" Radius="0.5">
                            <GradientStop Offset="0" Color="{StaticResource ElectricIndigo}"/>
                            <GradientStop Offset="1" Color="Transparent"/>
                         </RadialGradientBrush>
                      </Ellipse.Fill>
                      <Ellipse.Opacity>0.1</Ellipse.Opacity>
                   </Ellipse>
                   
                   <Ellipse Width="520" Height="520" Stroke="{DynamicResource RadarRingBrush}" StrokeThickness="1" Opacity="0.5"/>
                   <Ellipse Width="420" Height="420" Stroke="{DynamicResource GlassBorderBrush}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.3"/>
                   <Ellipse Width="180" Height="180" Stroke="{DynamicResource GlassBorderBrush}" StrokeThickness="1" StrokeDashArray="4,4" Opacity="0.3"/>
                   
                   <!-- Concentric Ripple Waves -->
                   <Ellipse Classes="RadarPulse" Width="320" Height="320" Fill="{StaticResource ElectricIndigoBrush}"/>
                   <Ellipse Classes="RadarPulseInner" Width="320" Height="320" Fill="{StaticResource ElectricIndigoBrush}"/>

                   <!-- Scanner sweep -->
                   <Border Width="520" Height="520" CornerRadius="260" Classes="RadarScan">
                      <Border.RenderTransform><RotateTransform/></Border.RenderTransform>
                      <Panel Width="520" Height="520">
                         <Path Data="M 0,0 L 260,0 A 260,260 0 0 0 212.9,-149.1 Z" Fill="{StaticResource ElectricIndigoBrush}" Opacity="0.15">
                            <Path.RenderTransform><TranslateTransform X="260" Y="260"/></Path.RenderTransform>
                         </Path>
                         <Rectangle Width="260" Height="1" Fill="White" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Center" StrokeDashArray="4,4"/>
                      </Panel>
                   </Border>

                   <Border Width="90" Height="90" Background="{StaticResource ElectricIndigoBrush}" CornerRadius="45" BoxShadow="0 0 35 0 #806366F1">
                      <Rectangle Width="32" Height="32" Fill="White">
                         <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/SCAN.png"/></Rectangle.OpacityMask>
                      </Rectangle>
                   </Border>

                   <StackPanel x:Name="RadarEmptyHint" IsVisible="False">
                      <TextBlock Text="LOOKING FOR DEVICES..." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="4" HorizontalAlignment="Center"/>
                      <TextBlock Text="Ensure other devices are on the same WiFi" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                   </StackPanel>

                   <!-- Detected Senders List -->
                   <ItemsControl ItemsSource="{Binding Devices, RelativeSource={RelativeSource AncestorType=views:MainView}}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="520" Height="520" Background="Transparent"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                         <DataTemplate x:DataType="models:DeviceModel">
                            <Button Click="SendFile_Click" Background="Transparent" Padding="0" BorderThickness="0" ClipToBounds="False">
                               <Button.Styles>
                                  <Style Selector="Button:pointerover /template/ ContentPresenter">
                                     <Setter Property="Background" Value="Transparent"/>
                                  </Style>
                                  <Style Selector="Button:pointerover Border.DeviceMarker">
                                     <Setter Property="BorderBrush" Value="White"/>
                                     <Setter Property="BoxShadow" Value="0 12 35 0 #506366F1"/>
                                  </Style>
                               </Button.Styles>
                               <StackPanel Spacing="10" HorizontalAlignment="Center" ClipToBounds="False">
                                  <Border Classes="DeviceMarker" Width="64" Height="64" Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{StaticResource ElectricIndigoBrush}" BorderThickness="2" CornerRadius="32" BoxShadow="0 8 25 0 #30000000">
                                     <Rectangle Width="28" Height="28" Fill="{StaticResource ElectricIndigoBrush}">
                                        <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/SEND FILE.png"/></Rectangle.OpacityMask>
                                     </Rectangle>
                                  </Border>
                                  <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="100" TextTrimming="CharacterEllipsis"/>
                               </StackPanel>
                            </Button>
                         </DataTemplate>
                      </ItemsControl.ItemTemplate>
                      <ItemsControl.Styles>
                         <Style Selector="ContentPresenter">
                            <Setter Property="Canvas.Left">
                               <MultiBinding Converter="{StaticResource RadarPos}"><Binding /><Binding Path="Devices" RelativeSource="{RelativeSource AncestorType=views:MainView}"/><Binding Source="X"/></MultiBinding>
                            </Setter>
                            <Setter Property="Canvas.Top">
                               <MultiBinding Converter="{StaticResource RadarPos}"><Binding /><Binding Path="Devices" RelativeSource="{RelativeSource AncestorType=views:MainView}"/><Binding Source="Y"/></MultiBinding>
                            </Setter>
                            <Setter Property="Transitions"><Transitions><DoubleTransition Property="Canvas.Left" Duration="0:0:1.5" Easing="QuarticEaseOut"/><DoubleTransition Property="Canvas.Top" Duration="0:0:1.5" Easing="QuarticEaseOut"/></Transitions></Setter>
                         </Style>
                      </ItemsControl.Styles>
                   </ItemsControl>
                </Panel>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,32" Spacing="20">
                   <TextBlock Text="SCANNING FOR DEVICES..." FontSize="10" FontWeight="Bold" Foreground="{StaticResource ElectricIndigoBrush}" LetterSpacing="4" HorizontalAlignment="Center" Opacity="0.8"/>
                   <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center">
                       <Button Content="CANCEL SENDING" Click="CancelSending_Click" Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontSize="11" Padding="16"/>
                       <Button Content="REFRESH RADAR" Click="RefreshDiscovery_Click" Background="Transparent" Foreground="{DynamicResource ElectricIndigoBrush}" FontSize="11" FontWeight="Bold" Padding="16"/>
                   </StackPanel>
                </StackPanel>
             </Grid>
          </Grid>

          <!-- LIBRARY PANEL -->
          <Grid x:Name="FilesPanel" IsVisible="False" Classes="SignalPanel">
             <ScrollViewer>
                <StackPanel Spacing="24">
                   <!-- Top Bar Search and Folder button -->
                   <Grid ColumnDefinitions="*, Auto, Auto">
                      <TextBlock Text="RECEIVED FILES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2" VerticalAlignment="Center"/>
                      <TextBox Grid.Column="1" Width="220" x:Name="FileSearchBox" Watermark="Filter files..." Padding="12,8" FontSize="12" Margin="16,0" TextChanged="FileSearch_TextChanged"/>
                      <Button Grid.Column="2" Classes="PrimaryBtn" Content="OPEN FOLDER" Click="OpenDownloadFolder_Click"/>
                   </Grid>
                    
                    <!-- Stats & Date Filters Row -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,12">
                       <!-- Stats Display -->
                       <Border Grid.Column="0" Background="#10FFFFFF" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" VerticalAlignment="Center">
                          <TextBlock x:Name="LibraryStatsText" Text="📊 Total Received: 0 files (0 B)" FontSize="12" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                       </Border>
                       
                       <!-- Filter Chips -->
                       <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                          <Button x:Name="FilterAllBtn" Content="ALL" Click="FilterDate_Click" Tag="All" Classes="FilterChip ActiveChip"/>
                          <Button x:Name="FilterTodayBtn" Content="TODAY" Click="FilterDate_Click" Tag="Today" Classes="FilterChip"/>
                          <Button x:Name="FilterWeekBtn" Content="THIS WEEK" Click="FilterDate_Click" Tag="Week" Classes="FilterChip"/>
                       </StackPanel>
                    </Grid>
                   
                   <Grid>
                        <ItemsControl x:Name="ReceivedFilesList">
                            <ItemsControl.ItemTemplate>
                               <DataTemplate x:DataType="models:FileTransferState">
                                  <Border Classes="GlassCard" Padding="18,16" Margin="0,0,0,10" CornerRadius="10">
                                     <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Border Width="44" Height="44" Background="#10FFFFFF" CornerRadius="8">
                                           <Rectangle Classes="IconTint" Width="18" Height="18"><Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/LIBRARY.png"/></Rectangle.OpacityMask></Rectangle>
                                        </Border>
                                        
                                        <!-- Completed file info -->
                                        <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center" IsVisible="{Binding IsCompleted}">
                                           <TextBlock Text="{Binding FileName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                           <TextBlock Text="{Binding FileSizeDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- In-progress receive info -->
                                        <StackPanel Grid.Column="1" Margin="18,0" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding !IsCompleted}">
                                           <Grid ColumnDefinitions="*, Auto">
                                              <TextBlock Text="{Binding FileName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                              <TextBlock Grid.Column="1" Text="{Binding ProgressPercentage, StringFormat=\{0:F0\}%}" Foreground="{DynamicResource ElectricIndigoBrush}" FontWeight="Bold" FontSize="12"/>
                                           </Grid>
                                           <ProgressBar Height="6" Value="{Binding ProgressPercentage}" Foreground="{DynamicResource ElectricIndigoBrush}" Background="#10FFFFFF" CornerRadius="3"/>
                                           <Grid ColumnDefinitions="*, Auto">
                                              <TextBlock Text="{Binding PeerName, StringFormat='From: \{0\}'}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                              <TextBlock Grid.Column="1" Text="{Binding SpeedMbPerSec, StringFormat=\{0:F1\} MB/s}" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
                                           </Grid>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsCompleted}">
                                           <Button Content="VIEW" Click="OpenFileInList_Click" Tag="{Binding}" Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" FontSize="11" Padding="14,8" CornerRadius="6"/>
                                           <Button Content="✕" Click="DeleteFileInList_Click" Tag="{Binding}" Background="Transparent" Foreground="#FF5555" FontSize="12" Padding="10"/>
                                        </StackPanel>

                                        <!-- Cancel for active transfers -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding !IsCompleted}">
                                           <Button Content="CANCEL" Click="CancelIncoming_Click" Background="Transparent" Foreground="#FF5555" BorderBrush="#FF5555" BorderThickness="1" FontSize="11" Padding="14,8" CornerRadius="6"/>
                                        </StackPanel>
                                     </Grid>
                                  </Border>
                               </DataTemplate>
                            </ItemsControl.ItemTemplate>
                         </ItemsControl>
                        
                        <!-- Empty library label -->
                        <TextBlock x:Name="HistoryEmptyState" Text="NO FILES RECEIVED YET" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.3" FontSize="12" FontWeight="Bold" LetterSpacing="2" Margin="0,100,0,0"/>
                   </Grid>
                </StackPanel>
             </ScrollViewer>
          </Grid>

          <!-- ABOUT PANEL -->
          <Grid x:Name="AboutPanel" IsVisible="False" Classes="SignalPanel">
             <ScrollViewer>
               <Grid ColumnDefinitions="*, 48, 340" Margin="40,0">

                 <!-- Left: Identity hero -->
                 <StackPanel Grid.Column="0" Spacing="0" VerticalAlignment="Top">

                   <!-- App Identity Block -->
                   <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,0,0,32">
                     <Border Classes="SplashLogoPulse" Width="72" Height="72" CornerRadius="18"
                             ClipToBounds="True" BoxShadow="0 8 32 0 #50000000">
                       <Image Source="/Assets/logo.png" Stretch="Uniform"/>
                     </Border>
                     <StackPanel VerticalAlignment="Center" Spacing="4">
                       <TextBlock Text="We Share" FontSize="30" FontWeight="Bold"
                                  Foreground="{DynamicResource TextPrimary}" LetterSpacing="-0.5"/>
                       <StackPanel Orientation="Horizontal" Spacing="8">
                         <Border Background="#186366F1" BorderBrush="{StaticResource ElectricIndigoBrush}"
                                 BorderThickness="1" CornerRadius="4" Padding="8,3">
                           <TextBlock Text="v1.1.0" FontSize="10" FontWeight="Bold"
                                      Foreground="{StaticResource ElectricIndigoBrush}"/>
                         </Border>
                         <Border Background="#1510B981" BorderBrush="{StaticResource TealSuccessBrush}"
                                 BorderThickness="1" CornerRadius="4" Padding="8,3">
                           <TextBlock Text="STABLE" FontSize="10" FontWeight="Bold"
                                      Foreground="{StaticResource TealSuccessBrush}"/>
                         </Border>
                       </StackPanel>
                     </StackPanel>
                   </StackPanel>

                   <!-- Tagline -->
                   <TextBlock Text="Lightning-fast local file sharing — no cloud, no accounts, no limits."
                              FontSize="16" FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                              LineHeight="26" Margin="0,0,0,12"/>
                   <TextBlock Text="We Share operates entirely over your Wi-Fi network. Your files never touch the internet."
                              FontSize="13" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                              LineHeight="22" Margin="0,0,0,40"/>

                   <!-- Feature pills -->
                   <TextBlock Text="CAPABILITIES" FontSize="9" FontWeight="Bold" LetterSpacing="2"
                              Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16"/>
                   <WrapPanel Orientation="Horizontal">
                     <Border Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                             BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,8,8">
                       <TextBlock Text="⚡  High-speed TCP transfers" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                     </Border>
                     <Border Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                             BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,8,8">
                       <TextBlock Text="📡  UDP peer discovery" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                     </Border>
                     <Border Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                             BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,8,8">
                       <TextBlock Text="🌐  Web portal for mobile" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                     </Border>
                     <Border Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                             BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,8,8">
                       <TextBlock Text="🔒  LAN-only, zero cloud" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                     </Border>
                     <Border Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                             BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,8,8">
                       <TextBlock Text="📶  Auto Wi-Fi hotspot" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                     </Border>
                     <Border Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                             BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,8,8">
                       <TextBlock Text="🖥️  .NET 8 self-contained" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                     </Border>
                   </WrapPanel>

                   <!-- Github CTA -->
                   <Button Click="OpenGitHub_Click" Classes="PrimaryBtn"
                           HorizontalAlignment="Left" Margin="0,32,0,0">
                     <StackPanel Orientation="Horizontal" Spacing="10">
                       <Rectangle Width="14" Height="14" Fill="White">
                         <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/WEBSITE.png"/></Rectangle.OpacityMask>
                       </Rectangle>
                       <TextBlock Text="VIEW ON GITHUB"/>
                     </StackPanel>
                   </Button>
                 </StackPanel>

                 <!-- Right: Info cards -->
                 <StackPanel Grid.Column="2" Spacing="16" VerticalAlignment="Top">

                   <!-- Developer card -->
                   <Border Classes="GlassCard" Padding="24" CornerRadius="14">
                     <StackPanel Spacing="16">
                       <TextBlock Text="DEVELOPER" FontSize="9" FontWeight="Bold" LetterSpacing="2"
                                  Foreground="{DynamicResource TextSecondary}"/>
                       <StackPanel Orientation="Horizontal" Spacing="14">
                         <Border Width="44" Height="44" Background="#186366F1" CornerRadius="10"
                                 BorderBrush="{StaticResource ElectricIndigoBrush}" BorderThickness="1">
                           <TextBlock Text="S" FontSize="20" FontWeight="Bold"
                                      Foreground="{StaticResource ElectricIndigoBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                         </Border>
                         <StackPanel VerticalAlignment="Center" Spacing="2">
                           <TextBlock Text="Sowmiyan S" FontSize="15" FontWeight="Bold"
                                      Foreground="{DynamicResource TextPrimary}"/>
                           <TextBlock Text="Open-source developer" FontSize="11"
                                      Foreground="{DynamicResource TextSecondary}"/>
                         </StackPanel>
                       </StackPanel>
                     </StackPanel>
                   </Border>

                   <!-- Privacy card -->
                   <Border Classes="GlassCard" Padding="24" CornerRadius="14">
                     <StackPanel Spacing="12">
                       <StackPanel Orientation="Horizontal" Spacing="10">
                         <Border Width="32" Height="32" Background="#1010B981" CornerRadius="8">
                           <TextBlock Text="🔒" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                         </Border>
                         <TextBlock Text="PRIVACY &amp; SECURITY" FontSize="9" FontWeight="Bold" LetterSpacing="2"
                                    Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                       </StackPanel>
                       <TextBlock Text="We Share works entirely over the local network. No files or metadata are ever sent to external servers."
                                  TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" LineHeight="20"/>
                     </StackPanel>
                   </Border>

                   <!-- License card -->
                   <Border Classes="GlassCard" Padding="24" CornerRadius="14">
                     <StackPanel Spacing="12">
                       <StackPanel Orientation="Horizontal" Spacing="10">
                         <Border Width="32" Height="32" Background="#18F59E0B" CornerRadius="8">
                           <TextBlock Text="📄" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                         </Border>
                         <TextBlock Text="LICENSE" FontSize="9" FontWeight="Bold" LetterSpacing="2"
                                    Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                       </StackPanel>
                       <TextBlock Text="MIT License — free to use, modify, and distribute with attribution."
                                  TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" LineHeight="20"/>
                     </StackPanel>
                   </Border>

                   <!-- Built with card -->
                   <Border Classes="GlassCard" Padding="24" CornerRadius="14">
                     <StackPanel Spacing="12">
                       <TextBlock Text="BUILT WITH" FontSize="9" FontWeight="Bold" LetterSpacing="2"
                                  Foreground="{DynamicResource TextSecondary}"/>
                       <StackPanel Spacing="10">
                         <Grid ColumnDefinitions="Auto, *">
                           <Border Width="6" Height="6" Background="{StaticResource ElectricIndigoBrush}" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
                           <TextBlock Grid.Column="1" Text=".NET 8 — Self-contained runtime" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                         </Grid>
                         <Grid ColumnDefinitions="Auto, *">
                           <Border Width="6" Height="6" Background="{StaticResource ElectricIndigoBrush}" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
                           <TextBlock Grid.Column="1" Text="AvaloniaUI — Cross-platform UI" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                         </Grid>
                         <Grid ColumnDefinitions="Auto, *">
                           <Border Width="6" Height="6" Background="{StaticResource ElectricIndigoBrush}" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,10,0"/>
                           <TextBlock Grid.Column="1" Text="SQLite — Local transfer history" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                         </Grid>
                       </StackPanel>
                     </StackPanel>
                   </Border>

                   <!-- Copyright -->
                   <TextBlock Text="© 2026 Sowmiyan S. All rights reserved." FontSize="10"
                              Foreground="{DynamicResource TextSecondary}" Opacity="0.5"
                              HorizontalAlignment="Center"/>
                 </StackPanel>
               </Grid>
             </ScrollViewer>
          </Grid>

          <!-- SETTINGS PANEL -->
          <Grid x:Name="SettingsPanel" IsVisible="False" Classes="SignalPanel">
             <StackPanel Spacing="32" MaxWidth="600" HorizontalAlignment="Left">
                <Border Classes="GlassCard" Padding="32" CornerRadius="12">
                   <StackPanel Spacing="32">
                      <!-- Name Setting -->
                      <StackPanel Spacing="12">
                         <TextBlock Text="NAME ON NETWORK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                         <TextBox x:Name="SettingsDeviceName" Padding="14" Foreground="{DynamicResource TextPrimary}" FontSize="14" TextChanged="SettingsDeviceName_TextChanged"/>
                         <TextBlock Text="This is the name other devices on your Wi-Fi will see when sending files to you." FontSize="11" Foreground="{DynamicResource TextSecondary}" Opacity="0.7"/>
                      </StackPanel>
                      
                      <!-- Appearance Setting -->
                      <StackPanel Spacing="12">
                         <TextBlock Text="APPEARANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                         <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                               <TextBlock Text="DARK THEME" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                               <TextBlock Text="Switch between Dark and Light color palettes" FontSize="11" Foreground="{DynamicResource TextSecondary}" Opacity="0.7"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="ThemeToggle" IsChecked="True" IsCheckedChanged="ThemeSwitch_Changed"/>
                         </Grid>
                      </StackPanel>
                      
                      <!-- Save Location Setting -->
                      <StackPanel Spacing="12">
                         <TextBlock Text="DOWNLOAD DIRECTORY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" LetterSpacing="2"/>
                         <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="4" VerticalAlignment="Center" MaxWidth="380">
                               <TextBlock x:Name="SettingsSaveLocationLabel" Text="..." Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                               <TextBlock Text="Folder where received files are saved" FontSize="11" Foreground="{DynamicResource TextSecondary}" Opacity="0.7"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="BROWSE" Click="ChangeSaveLocation_Click" Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="16,10" CornerRadius="8" Margin="16,0,0,0"/>
                         </Grid>
                      </StackPanel>
                   </StackPanel>
                </Border>
             </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- MOBILE NAVIGATION (For Phone device types) -->
    <Border x:Name="BottomNav" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="80" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0" IsVisible="False">
        <Grid ColumnDefinitions="*, *, *, *">
            <Button Grid.Column="0" Classes="SidebarItem" Click="NavHome_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Rectangle Width="20" Height="20" Fill="{DynamicResource TextPrimary}" Opacity="0.6">
                    <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/HOME.png"/></Rectangle.OpacityMask>
                </Rectangle>
            </Button>
            <Button Grid.Column="1" Classes="SidebarItem" Click="NavFiles_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Rectangle Width="20" Height="20" Fill="{DynamicResource TextPrimary}" Opacity="0.6">
                    <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/LIBRARY.png"/></Rectangle.OpacityMask>
                </Rectangle>
            </Button>
            <Button Grid.Column="2" Classes="SidebarItem" Click="NavSettings_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Rectangle Width="20" Height="20" Fill="{DynamicResource TextPrimary}" Opacity="0.6">
                    <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/SETTINGS.png"/></Rectangle.OpacityMask>
                </Rectangle>
            </Button>
            <Button Grid.Column="3" Classes="SidebarItem" Click="NavAbout_Click" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Rectangle Width="20" Height="20" Fill="{DynamicResource TextPrimary}" Opacity="0.6">
                    <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/WEBSITE.png"/></Rectangle.OpacityMask>
                </Rectangle>
            </Button>
        </Grid>
    </Border>

    <!-- Drag & Drop Overlay overlay -->
    <Panel x:Name="DragOverlay" IsVisible="False" Background="#B06366F1" ZIndex="4000">
       <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="32">
          <Border Width="160" Height="160" BorderBrush="White" BorderThickness="2" CornerRadius="16" Background="#20FFFFFF" BoxShadow="0 8 32 0 #30000000">
             <Rectangle Width="70" Height="70" Fill="White">
                <Rectangle.OpacityMask><ImageBrush Source="/Assets/Icons/SEND FILE.png"/></Rectangle.OpacityMask>
             </Rectangle>
          </Border>
          <TextBlock Text="DROP TO SEND" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" LetterSpacing="2"/>
       </StackPanel>
    </Panel>

    <!-- Manual IP Dialog -->
    <Panel x:Name="ManualIPDialog" IsVisible="False" Background="#A0000000" ZIndex="4999">
       <Border Background="{DynamicResource GlassBackgroundBrush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="16" Width="380" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 24 60 0 #40000000">
          <StackPanel Spacing="24">
             <TextBlock Text="CONNECT VIA IP" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
             <TextBlock Text="Enter the local IP address of the device you want to send files to." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18"/>
             <TextBox x:Name="ManualIPInput" Watermark="e.g. 192.168.1.5" Height="45" VerticalContentAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}" Background="#10FFFFFF" CornerRadius="8"/>
             <Grid ColumnDefinitions="*, 12, *">
                <Button Grid.Column="0" Content="CANCEL" Click="CloseManualIP_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40" CornerRadius="8" Padding="0,10"/>
                <Button Grid.Column="2" Content="CONNECT" Click="ManualIPConnect_Click" Classes="PrimaryBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="40"/>
             </Grid>
          </StackPanel>
       </Border>
    </Panel>

    <!-- Splash Grid loader -->
    <Grid x:Name="SplashGrid" Background="{DynamicResource BaseBackgroundBrush}" ZIndex="5000">
       <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="28">

         <!-- Orbital ring animation -->
         <Panel Width="120" Height="120" HorizontalAlignment="Center">

           <!-- Outer orbit ring -->
           <Ellipse Classes="SplashOrbit1" Width="120" Height="120"
                    Stroke="{StaticResource ElectricIndigoBrush}" StrokeThickness="2"
                    StrokeDashArray="6,18" Opacity="0.6"/>

           <!-- Inner orbit ring (counter-rotate) -->
           <Ellipse Classes="SplashOrbit2" Width="88" Height="88"
                    Stroke="{StaticResource ElectricIndigoBrush}" StrokeThickness="1.5"
                    StrokeDashArray="4,12" Opacity="0.4"/>

           <!-- Pulsing logo hub -->
           <Border Classes="SplashLogoPulse" Width="64" Height="64" CornerRadius="16"
                   ClipToBounds="True"
                   Background="{DynamicResource GlassBackgroundBrush}"
                   BorderBrush="{StaticResource ElectricIndigoBrush}" BorderThickness="1.5"
                   BoxShadow="0 0 30 0 #806366F1">
             <Image Source="/Assets/logo.png" Stretch="Uniform" Margin="10"/>
           </Border>
         </Panel>

         <!-- Brand text -->
         <StackPanel Spacing="6" HorizontalAlignment="Center">
           <TextBlock Text="WE SHARE" FontSize="20" FontWeight="Bold" LetterSpacing="6"
                      Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
           <TextBlock Text="Starting services…" FontSize="11"
                      Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Opacity="0.6"/>
         </StackPanel>
       </StackPanel>
    </Grid>

    <!-- Accept incoming request panel -->
    <Border x:Name="AcceptRejectPanel" IsVisible="False" ZIndex="6000" VerticalAlignment="Center" HorizontalAlignment="Center" Width="440" Padding="32" CornerRadius="16" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{StaticResource ElectricIndigoBrush}" BorderThickness="2" BoxShadow="0 24 60 0 #80000000">
       <Grid RowDefinitions="Auto, Auto">
          <StackPanel Spacing="24">
             <TextBlock Text="INCOMING REQUEST" FontSize="11" FontWeight="Bold" LetterSpacing="3" Foreground="{StaticResource ElectricIndigoBrush}"/>
             <StackPanel Spacing="8">
                <TextBlock x:Name="IncomingFileName" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="IncomingPeerName" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock x:Name="IncomingFileSize" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
             </StackPanel>
          </StackPanel>
          <Grid Grid.Row="1" ColumnDefinitions="*, 16, *" Margin="0,40,0,0">
             <Button Grid.Column="0" Content="REJECT" Click="RejectTransfer_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14" Background="Transparent" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Foreground="{DynamicResource TextSecondary}" CornerRadius="8"/>
             <Button Grid.Column="2" Classes="PrimaryBtn" Content="ACCEPT" Click="AcceptTransfer_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14"/>
          </Grid>
       </Grid>
    </Border>

     <!-- Floating Toast alert -->
     <Border x:Name="ToastBorder" IsVisible="False" VerticalAlignment="Top" HorizontalAlignment="Center"
             Margin="48,80,48,0" Padding="16,11" Opacity="0"
             Background="{DynamicResource CardBackgroundBrush}"
             BorderBrush="{StaticResource ElectricIndigoBrush}" BorderThickness="1"
             CornerRadius="20" BoxShadow="0 8 32 0 #40000000"
             RenderTransformOrigin="50%,50%">
        <Grid ColumnDefinitions="Auto, *">
             <Border Width="4" Height="18" Background="{StaticResource ElectricIndigoBrush}" CornerRadius="2" VerticalAlignment="Center"/>
             <TextBlock x:Name="ToastMessage" VerticalAlignment="Center" FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="10,0,0,0"/>
        </Grid>
     </Border>
  </Grid>
</UserControl>
