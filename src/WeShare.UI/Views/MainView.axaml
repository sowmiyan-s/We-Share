<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WeShare.UI.Views"
             xmlns:models="using:WeShare.Core.Models"
             xmlns:views="using:WeShare.UI.Views"
             xmlns:controls="clr-namespace:WeShare.UI.Controls"
             x:Class="WeShare.UI.Views.MainView"
             x:DataType="views:MainView"
             FontFamily="Segoe UI, system-ui, -apple-system, Roboto, sans-serif"
             Background="#090A0F">

  <UserControl.Resources>
    <local:ProgressToWidthConverter x:Key="ProgressToWidthConverter"/>
    <local:FileSizeConverter x:Key="FileSizeConverter"/>
    <local:RadarPositionConverter x:Key="RadarPos"/>
    <local:DeviceTypeToIconConverter x:Key="DeviceTypeToIconConverter"/>
    <local:DeviceTypeToGeometryConverter x:Key="DeviceTypeToGeometryConverter"/>
    <local:TransferDirectionLabelConverter x:Key="TransferDirLabel"/>

    <!-- Design Tokens -->
    <SolidColorBrush x:Key="BrandVioletBrush" Color="#4F46E5"/>
    <SolidColorBrush x:Key="BrandVioletDimBrush" Color="#4338CA"/>
    <SolidColorBrush x:Key="BrandMagentaBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="TelemetryCyanBrush" Color="#06B6D4"/>
    <SolidColorBrush x:Key="BaseBackgroundBrush" Color="#090A0F"/>
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#11131C"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#161824"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#222638"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#222638"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#363D57"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

    <!-- Legacy Compatibility Brushes -->
    <SolidColorBrush x:Key="SpotifyGreenBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="SpotifyGreenHoverBrush" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="SpotifyGreenPressedBrush" Color="#6D28D9"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#222638"/>
    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#12141F"/>
    <SolidColorBrush x:Key="ElectricIndigoBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="ElectricIndigoDimBrush" Color="#6D28D9"/>
    <SolidColorBrush x:Key="TealSuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="DeepSlateBrush" Color="#090A0F"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Navigation Item Button -->
    <Style Selector="Button.SidebarItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.SidebarItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.SidebarItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1A1D2B"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.SidebarItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#252A3E"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.SidebarItem.Active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1E2235"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.SidebarItem TextBlock">
       <Setter Property="Foreground" Value="#94A3B8"/>
       <Setter Property="FontWeight" Value="Medium"/>
       <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="Button.SidebarItem:pointerover TextBlock">
       <Setter Property="Foreground" Value="#F8FAFC"/>
    </Style>
    <Style Selector="Button.SidebarItem.Active TextBlock">
       <Setter Property="Foreground" Value="#FFFFFF"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.SidebarItem Path.NavIcon">
       <Setter Property="Fill" Value="#94A3B8"/>
    </Style>
    <Style Selector="Button.SidebarItem:pointerover Path.NavIcon">
       <Setter Property="Fill" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.SidebarItem.Active Path.NavIcon">
       <Setter Property="Fill" Value="#7C3AED"/>
    </Style>

    <!-- Ultra-Refined Glassmorphism Surface Card -->
    <Style Selector="Border.GlassCard">
        <Setter Property="Background" Value="#C0121524"/>
        <Setter Property="BorderBrush" Value="#2E354D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="BoxShadow" Value="0 8 32 0 #55000000, inset 0 1 0 0 #18FFFFFF"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.GlassCard:pointerover">
        <Setter Property="Background" Value="#D4161A2D"/>
        <Setter Property="BorderBrush" Value="#487C3AED"/>
        <Setter Property="BoxShadow" Value="0 12 40 0 #70000000, inset 0 1 0 0 #28FFFFFF"/>
    </Style>

    <!-- Radar Sonar Active Sweep Rotation -->
    <Style Selector="Panel.RadarSweep">
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Style.Animations>
          <Animation Duration="0:0:3" IterationCount="Infinite">
             <KeyFrame Cue="0%">
                <Setter Property="RotateTransform.Angle" Value="0"/>
             </KeyFrame>
             <KeyFrame Cue="100%">
                <Setter Property="RotateTransform.Angle" Value="360"/>
             </KeyFrame>
          </Animation>
       </Style.Animations>
    </Style>

    <!-- Sonar Pulsing Concentric Wave Rings -->
    <Style Selector="Ellipse.RadarPulseRing1">
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Style.Animations>
          <Animation Duration="0:0:3" IterationCount="Infinite">
             <KeyFrame Cue="0%">
                <Setter Property="ScaleTransform.ScaleX" Value="0.2"/>
                <Setter Property="ScaleTransform.ScaleY" Value="0.2"/>
                <Setter Property="Opacity" Value="0.8"/>
             </KeyFrame>
             <KeyFrame Cue="70%">
                <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                <Setter Property="Opacity" Value="0.0"/>
             </KeyFrame>
             <KeyFrame Cue="100%">
                <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                <Setter Property="Opacity" Value="0.0"/>
             </KeyFrame>
          </Animation>
       </Style.Animations>
    </Style>

    <Style Selector="Ellipse.RadarPulseRing2">
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Style.Animations>
          <Animation Duration="0:0:3" Delay="0:0:1.5" IterationCount="Infinite">
             <KeyFrame Cue="0%">
                <Setter Property="ScaleTransform.ScaleX" Value="0.2"/>
                <Setter Property="ScaleTransform.ScaleY" Value="0.2"/>
                <Setter Property="Opacity" Value="0.8"/>
             </KeyFrame>
             <KeyFrame Cue="70%">
                <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                <Setter Property="Opacity" Value="0.0"/>
             </KeyFrame>
             <KeyFrame Cue="100%">
                <Setter Property="ScaleTransform.ScaleX" Value="1.0"/>
                <Setter Property="ScaleTransform.ScaleY" Value="1.0"/>
                <Setter Property="Opacity" Value="0.0"/>
             </KeyFrame>
          </Animation>
       </Style.Animations>
    </Style>

    <!-- Primary Action Button (Smooth Tactile Animation, Protected CornerRadius) -->
    <Style Selector="Button.PrimaryBtn">
       <Setter Property="Background" Value="{StaticResource BrandGradientHBrush}"/>
       <Setter Property="Foreground" Value="#FFFFFF"/>
       <Setter Property="BorderThickness" Value="0"/>
       <Setter Property="Padding" Value="20,11"/>
       <Setter Property="CornerRadius" Value="8"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
       <Setter Property="FontSize" Value="13"/>
       <Setter Property="Cursor" Value="Hand"/>
       <Setter Property="ClipToBounds" Value="True"/>
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Setter Property="Transitions">
          <Transitions>
             <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
             <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Button.PrimaryBtn /template/ ContentPresenter#PART_ContentPresenter">
       <Setter Property="CornerRadius" Value="8"/>
       <Setter Property="Background" Value="{StaticResource BrandGradientHBrush}"/>
    </Style>
    <Style Selector="Button.PrimaryBtn:pointerover">
       <Setter Property="RenderTransform" Value="translateY(-1px)"/>
    </Style>
    <Style Selector="Button.PrimaryBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
       <Setter Property="Background" Value="{StaticResource BrandGradientHBrush}"/>
       <Setter Property="CornerRadius" Value="8"/>
       <Setter Property="Opacity" Value="0.92"/>
    </Style>
    <Style Selector="Button.PrimaryBtn:pressed">
       <Setter Property="RenderTransform" Value="translateY(1px)"/>
    </Style>
    <Style Selector="Button.PrimaryBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
       <Setter Property="Background" Value="{StaticResource BrandGradientHBrush}"/>
       <Setter Property="CornerRadius" Value="8"/>
       <Setter Property="Opacity" Value="0.80"/>
    </Style>

    <!-- Ghost / Secondary Button (Smooth Tactile Animation, Protected CornerRadius) -->
    <Style Selector="Button.GhostBtn">
       <Setter Property="Background" Value="#161824"/>
       <Setter Property="Foreground" Value="#E2E8F0"/>
       <Setter Property="BorderBrush" Value="#262A3D"/>
       <Setter Property="BorderThickness" Value="1"/>
       <Setter Property="Padding" Value="16,9"/>
       <Setter Property="CornerRadius" Value="8"/>
       <Setter Property="FontWeight" Value="Medium"/>
       <Setter Property="FontSize" Value="12"/>
       <Setter Property="Cursor" Value="Hand"/>
       <Setter Property="ClipToBounds" Value="True"/>
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Setter Property="Transitions">
          <Transitions>
             <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
             <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
             <BrushTransition Property="Background" Duration="0:0:0.12"/>
             <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Button.GhostBtn /template/ ContentPresenter#PART_ContentPresenter">
       <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.GhostBtn:pointerover">
       <Setter Property="RenderTransform" Value="translateY(-1px)"/>
    </Style>
    <Style Selector="Button.GhostBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
       <Setter Property="BorderBrush" Value="#7C3AED"/>
       <Setter Property="Background" Value="#1E2336"/>
       <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.GhostBtn:pressed">
       <Setter Property="RenderTransform" Value="translateY(1px)"/>
    </Style>
    <Style Selector="Button.GhostBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
       <Setter Property="BorderBrush" Value="#6D28D9"/>
       <Setter Property="Background" Value="#141722"/>
       <Setter Property="CornerRadius" Value="8"/>
       <Setter Property="Opacity" Value="0.85"/>
    </Style>

    <!-- Hero Big Action Card Button -->
    <Style Selector="Button.HeroCardBtn">
       <Setter Property="Background" Value="Transparent"/>
       <Setter Property="Padding" Value="0"/>
       <Setter Property="BorderThickness" Value="0"/>
       <Setter Property="HorizontalAlignment" Value="Stretch"/>
       <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
       <Setter Property="Transitions">
          <Transitions>
             <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Button.HeroCardBtn:pointerover">
       <Setter Property="RenderTransform" Value="translateY(-3px)"/>
    </Style>

    <!-- Filter Chips -->
    <Style Selector="Button.FilterChip">
       <Setter Property="Background" Value="#161824"/>
       <Setter Property="Foreground" Value="#94A3B8"/>
       <Setter Property="BorderBrush" Value="#222638"/>
       <Setter Property="BorderThickness" Value="1"/>
       <Setter Property="CornerRadius" Value="6"/>
       <Setter Property="Padding" Value="14,6"/>
       <Setter Property="FontSize" Value="12"/>
       <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="Button.FilterChip /template/ ContentPresenter#PART_ContentPresenter">
       <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.FilterChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
       <Setter Property="Background" Value="#1E2235"/>
       <Setter Property="Foreground" Value="#FFFFFF"/>
       <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.FilterChip:pressed /template/ ContentPresenter#PART_ContentPresenter">
       <Setter Property="Background" Value="#252A3E"/>
       <Setter Property="Foreground" Value="#FFFFFF"/>
       <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.FilterChip.ActiveChip /template/ ContentPresenter#PART_ContentPresenter">
       <Setter Property="Background" Value="#7C3AED"/>
       <Setter Property="Foreground" Value="#FFFFFF"/>
       <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.FilterChip.ActiveChip:pressed /template/ ContentPresenter#PART_ContentPresenter">
       <Setter Property="Background" Value="#6D28D9"/>
       <Setter Property="Foreground" Value="#FFFFFF"/>
       <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.FilterChip.ActiveChip TextBlock">
       <Setter Property="Foreground" Value="#FFFFFF"/>
       <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Table Row Hover -->
    <Style Selector="Border.TrackRow">
       <Setter Property="Background" Value="Transparent"/>
       <Setter Property="CornerRadius" Value="8"/>
       <Setter Property="Transitions">
          <Transitions>
             <BrushTransition Property="Background" Duration="0:0:0.15"/>
          </Transitions>
       </Setter>
    </Style>
    <Style Selector="Border.TrackRow:pointerover">
       <Setter Property="Background" Value="#1A1D2B"/>
    </Style>
  </UserControl.Styles>

  <Grid x:Name="RootBorder" Background="#090A0F" RowDefinitions="*">
    <!-- Ambient Ecosystem Background -->
    <Image Source="avares://WeShare.UI/Assets/background.png" Stretch="UniformToFill" Opacity="0.36" IsHitTestVisible="False"/>
    <Border Background="#D0090A0F" IsHitTestVisible="False"/>
    
    <!-- MAIN WORKSPACE GRID: Sidebar + Content Canvas -->
    <Grid x:Name="MainLayout" ColumnDefinitions="240, *">
      
      <!-- ========================================== -->
      <!-- UNIFIED LEFT SIDEBAR                       -->
      <!-- ========================================== -->
      <Border Grid.Column="0" x:Name="Sidebar" Background="#F211131C" BorderBrush="#1E2232" BorderThickness="0,0,1,0" Padding="14,18">
        <Grid RowDefinitions="Auto, 18, *, Auto">
          
          <!-- Brand Header with Pure White Vector Logo (No Borders) -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="6,6,0,0">
             <Image Source="avares://WeShare.UI/Assets/app_logo.png" Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Center"/>
             <TextBlock Text="We Share" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" LetterSpacing="0.4"/>
          </StackPanel>

          <!-- Primary Navigation Links -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Bold" Foreground="#475569" LetterSpacing="1" Margin="8,8,8,4"/>
              
              <Button Classes="SidebarItem Active" x:Name="NavHomeBtn" Click="NavHome_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Path Classes="NavIcon" Data="{StaticResource IconHome}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                  <TextBlock Text="Home" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button Classes="SidebarItem" x:Name="NavSendBtn" Click="NavSendFiles_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Path Classes="NavIcon" Data="{StaticResource IconSend}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                  <TextBlock Text="Send Files" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button Classes="SidebarItem" x:Name="NavReceiveBtn" Click="NavReceiveMode_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Path Classes="NavIcon" Data="{StaticResource IconReceive}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                  <TextBlock Text="Receive Mode" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <Button Classes="SidebarItem" x:Name="NavWebSharedBtn" Click="NavWebShared_Click">
                <Grid ColumnDefinitions="*, Auto">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <Path Classes="NavIcon" Data="{StaticResource IconGlobe}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="Web Portal" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Border Grid.Column="1" x:Name="SidebarWebClientBadge" Background="#7C3AED" CornerRadius="8" Padding="6,1" Margin="6,0,0,0" IsVisible="False" VerticalAlignment="Center">
                    <TextBlock x:Name="SidebarWebClientBadgeCount" Text="0" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                  </Border>
                </Grid>
              </Button>

              <Button Classes="SidebarItem" x:Name="NavTransfersBtn" Click="NavTransfers_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Path Classes="NavIcon" Data="{StaticResource IconHistory}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                  <TextBlock Text="Transfer History" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>

              <!-- Compatibility Anchors for code-behind references -->
              <StackPanel IsVisible="False">
                 <Button x:Name="NavFilesBtn" Click="NavFiles_Click"/>
                 <TextBlock x:Name="SidebarDevicesEmpty"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- Bottom System Links & Workstation Identity -->
          <StackPanel Grid.Row="3" Spacing="4" Margin="0,10,0,0">
            
            <!-- Workstation Identity (Clickable to change device name anytime) -->
            <Border Background="#161824" BorderBrush="#222638" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" PointerPressed="SidebarDeviceName_PointerPressed" Cursor="Hand" ToolTip.Tip="Click to change device name">
               <Grid ColumnDefinitions="Auto, *, Auto">
                  <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Margin="0,0,10,0" VerticalAlignment="Center" ClipToBounds="True">
                     <Image Source="avares://WeShare.UI/Assets/profile.png" Width="28" Height="28" Stretch="Uniform"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                     <TextBlock x:Name="SidebarDeviceName" Text="My PC" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                     <TextBlock x:Name="SidebarNetworkInfo" Text="Wi-Fi Active" FontSize="10" Foreground="#94A3B8"/>
                  </StackPanel>
                  <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" Background="#10B981" VerticalAlignment="Center" ToolTip.Tip="Network Active"/>
               </Grid>
            </Border>

            <Button Classes="SidebarItem" x:Name="NavSettBtn" Click="NavSettings_Click">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Classes="NavIcon" Data="{StaticResource IconSettings}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="Settings" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Classes="SidebarItem" x:Name="NavAboutBtn" Click="NavAbout_Click">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Path Classes="NavIcon" Data="{StaticResource IconAbout}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="About" FontSize="12" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>

        </Grid>
      </Border>

      <!-- ========================================== -->
      <!-- MAIN WORKSPACE CANVAS                      -->
      <!-- ========================================== -->
      <Grid Grid.Column="1" RowDefinitions="Auto, *" x:Name="ContentArea" Background="Transparent">
        
        <!-- Global Activity Progress Line -->
        <Border x:Name="GlobalActivityBorder" IsVisible="False" Height="2" Background="Transparent" VerticalAlignment="Top" ZIndex="1000">
           <ProgressBar x:Name="GlobalProgressBar" IsIndeterminate="False" Height="2" Foreground="#7C3AED" Background="Transparent" BorderThickness="0"/>
        </Border>

        <!-- Top Header Navigation Bar (Unobstructed by window caption buttons) -->
        <Border Grid.Row="0" Padding="36,16,36,14" Background="Transparent" PointerPressed="TitleBar_PointerPressed" BorderBrush="#1A1D2B" BorderThickness="0,0,0,1">
           <Grid ColumnDefinitions="Auto, *">
              
              <!-- Left: Optional Back Navigation + Title -->
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                 <Button x:Name="PageBackBtn" Content="← Back" Click="NavHome_Click" Classes="GhostBtn" Padding="10,5" FontSize="11" IsVisible="False"/>
                 <TextBlock x:Name="PageTitle" Text="Command Center" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
              </StackPanel>

              <!-- Hidden compatibility anchors (Zero collision with window caption buttons) -->
              <StackPanel IsVisible="False">
                 <StackPanel x:Name="HeaderWorkstationPill"/>
                 <TextBlock x:Name="HomeDeviceNameText"/>
                 <TextBlock x:Name="HomeNetworkInfoText"/>
                 <TextBlock x:Name="HomeSpeedBadge"/>
              </StackPanel>
           </Grid>
        </Border>

        <!-- Dynamic Content Panels Container -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch">
          <Grid MaxWidth="960" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="36,16,36,24" RowDefinitions="Auto, Auto, *">
              
              <!-- Send Wizard Step Indicator (Dedicated Row 0, Zero Overlap) -->
              <StackPanel Grid.Row="0" x:Name="SendStepWizard" IsVisible="False" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,0,0,24">
                 <Border Background="#161824" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="6" Padding="14,7">
                   <TextBlock x:Name="Step1Indicator" Text="1. Select Files" FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED"/>
                 </Border>
                 <Rectangle Width="24" Height="1" Fill="#262A3D" VerticalAlignment="Center"/>
                 <Border Background="#161824" BorderBrush="#222638" BorderThickness="1" CornerRadius="6" Padding="14,7">
                   <TextBlock x:Name="Step2Indicator" Text="2. Choose Recipient" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                 </Border>
              </StackPanel>

              <!-- Transfer Request Declined Notification Banner -->
              <Border Grid.Row="1" x:Name="TransferDeclinedCard" IsVisible="False" Background="#1E1218" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,20" BoxShadow="0 8 24 0 #40000000">
                 <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#34141C" Margin="0,0,14,0" VerticalAlignment="Center">
                       <Path Data="{StaticResource IconClose}" Fill="#EF4444" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                       <TextBlock Text="TRANSFER REQUEST DECLINED" FontSize="11" FontWeight="Bold" Foreground="#EF4444" LetterSpacing="0.8"/>
                       <TextBlock x:Name="TransferDeclinedMessage" Text="The recipient declined the file transfer request." FontSize="13" Foreground="#F8FAFC" FontWeight="Medium" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="RetryTransferBtn" Content="Retry Request" Click="RetryTransfer_Click" Classes="PrimaryBtn" Padding="14,8" FontSize="12" Margin="14,0,8,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="Dismiss" Click="DismissDeclined_Click" Classes="GhostBtn" Padding="12,8" FontSize="12" VerticalAlignment="Center"/>
                 </Grid>
              </Border>

              <!-- Panel Deck Container in Row 2 -->
              <Grid Grid.Row="2">

            <!-- ========================================================= -->
            <!-- 1. HOME VIEW: BIG CIRCULAR HERO BUTTONS (USER ASSETS)     -->
            <!-- ========================================================= -->
            <Grid x:Name="HomePanel" Classes="SignalPanel" RowDefinitions="*, Auto" MinHeight="520" VerticalAlignment="Stretch">
               
               <!-- CENTERPIECE: AMBIENT GLOW + BIG CIRCULAR SEND & RECEIVE HERO BUTTONS -->
               <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">


                  <StackPanel Spacing="32" HorizontalAlignment="Center">
                     
                     <!-- Two Big Circular Action Buttons -->
                     <Grid ColumnDefinitions="Auto, 72, Auto" HorizontalAlignment="Center">
                        
                        <!-- BIG CIRCULAR SEND BUTTON -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="14">
                           <Button Classes="CircleActionBtn" Click="HomeSend_Click" DragDrop.AllowDrop="True" Width="190" Height="190">
                              <Border Classes="SendCircleDisc">
                                 <Image Source="avares://WeShare.UI/Assets/send.png" Width="190" Height="190" Stretch="Uniform"/>
                              </Border>
                           </Button>
                           <TextBlock Text="SEND" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" LetterSpacing="1.5" HorizontalAlignment="Center"/>
                           <TextBlock Text="Drop files or click to send" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- BIG CIRCULAR RECEIVE BUTTON -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="14">
                           <Button Classes="CircleActionBtn" Click="NavReceiveMode_Click" Width="190" Height="190">
                              <Border Classes="ReceiveCircleDisc">
                                 <Image Source="avares://WeShare.UI/Assets/receive.png" Width="190" Height="190" Stretch="Uniform"/>
                              </Border>
                           </Button>
                           <TextBlock Text="RECEIVE" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" LetterSpacing="1.5" HorizontalAlignment="Center"/>
                           <TextBlock Text="Ready to accept transfers" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                        </StackPanel>

                     </Grid>

                     <!-- Quick Web Connection Shortcut -->
                     <Button Click="NavWebShared_Click" Classes="GhostBtn" Padding="18,9" CornerRadius="20" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                           <Border Width="8" Height="13" CornerRadius="2" Background="#F59E0B" VerticalAlignment="Center"/>
                            <TextBlock Text="Connect by Web Portal" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                     </Button>

                     <!-- Floating Active Transfer Telemetry Pill (Auto-Surfaces on Transfers) -->
                     <Border x:Name="HomeActiveTransferPill" IsVisible="False" Background="#151928" BorderBrush="#4F46E5" BorderThickness="1" CornerRadius="20" Padding="16,8" HorizontalAlignment="Center" BoxShadow="0 4 16 0 #20000000">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                           <Border Width="8" Height="8" CornerRadius="4" Background="#10B981"/>
                           <TextBlock x:Name="HomeTransferFileName" Text="Transferring files..." FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                           <TextBlock x:Name="HomeTransferSpeedText" Text="0.0 MB/s" FontSize="12" Foreground="#818CF8" FontWeight="Bold"/>
                           <Button Content="View Transfers →" Click="NavTransfers_Click" Classes="GhostBtn" Padding="8,3" FontSize="10"/>
                        </StackPanel>
                     </Border>

                  </StackPanel>
               </Grid>

               <!-- BOTTOM: STATUS & HIDDEN COMPATIBILITY ANCHORS -->
               <Grid Grid.Row="1" Margin="4,0,4,0">
                  <TextBlock x:Name="HomeEmptyHistoryLabel" Text="" IsVisible="False"/>
               </Grid>

            </Grid>

            <!-- ========================================== -->
            <!-- 2. SEND QUEUE: FILE SELECTION              -->
            <!-- ========================================== -->
            <Grid x:Name="SendFilesPanel" IsVisible="False" Classes="SignalPanel" RowDefinitions="*, Auto" DragDrop.AllowDrop="True">
               <Grid Grid.Row="0" RowDefinitions="Auto, Auto, 14, *">
                  
                  <!-- Target Recipient Banner (Shown when a peer is selected) -->
                  <Border Grid.Row="0" x:Name="SendTargetCard" IsVisible="False" Background="#161824" BorderBrush="#4F46E5" BorderThickness="1.2" CornerRadius="10" Padding="14,10" Margin="0,0,0,14" BoxShadow="0 4 16 0 #304F46E5">
                     <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#1E2338" Margin="0,0,12,0" VerticalAlignment="Center">
                           <Path x:Name="SendTargetIcon" Data="{StaticResource IconDevice}" Fill="#818CF8" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                           <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="SENDING TO:" FontSize="10" FontWeight="Bold" Foreground="#818CF8" LetterSpacing="0.8"/>
                              <TextBlock x:Name="SendTargetName" Text="Selected Device" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                           </StackPanel>
                           <TextBlock x:Name="SendTargetDetails" Text="PC • 192.168.1.50" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Change Recipient" Click="NavSendDiscovery_Click" Classes="GhostBtn" Padding="10,6" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Click="ClearSendTarget_Click" Classes="GhostBtn" Padding="8,6" VerticalAlignment="Center" ToolTip.Tip="Clear selected recipient">
                           <Path Data="{StaticResource IconClose}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                     </Grid>
                  </Border>

                  <Grid Grid.Row="1" ColumnDefinitions="*, Auto">
                     <TextBlock Text="Files to Send" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="GhostBtn" Content="Clear All" Click="ClearQueue_Click" x:Name="ClearQueueBtn" IsVisible="False"/>
                        <Button Classes="GhostBtn" Content="+ Add Folder" Click="BrowseFolder_Click"/>
                        <Button Classes="PrimaryBtn" Content="+ Add Files" Click="BrowseFiles_Click"/>
                     </StackPanel>
                  </Grid>

                  <!-- Queue File List -->
                  <Border Grid.Row="3" Classes="GlassCard" Padding="16">
                     <Grid>
                        <ScrollViewer>
                           <ItemsControl x:Name="SendQueueList">
                              <ItemsControl.ItemTemplate>
                                 <DataTemplate x:DataType="views:QueueItem">
                                    <Border Classes="TrackRow" Padding="12,9" Margin="0,0,0,4">
                                       <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                          <Border Grid.Column="0" Width="36" Height="36" Background="#1E2235" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center">
                                             <Path Data="{StaticResource IconFile}" Fill="#818CF8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                          </Border>
                                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                             <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                             <TextBlock Text="{Binding SizeDisplay}" FontSize="11" Foreground="#94A3B8"/>
                                          </StackPanel>
                                          <Button Grid.Column="3" Click="RemoveFromQueue_Click" Background="Transparent" Padding="8">
                                             <Path Data="{StaticResource IconClose}" Fill="#EF4444" Width="10" Height="10" Stretch="Uniform"/>
                                          </Button>
                                       </Grid>
                                    </Border>
                                 </DataTemplate>
                              </ItemsControl.ItemTemplate>
                           </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty Queue Visual Placeholder -->
                        <StackPanel x:Name="QueueEmptyLabel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                           <Border Width="48" Height="48" CornerRadius="24" Background="#161824" HorizontalAlignment="Center">
                              <Path Data="{StaticResource IconSend}" Fill="#64748B" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                           </Border>
                           <TextBlock Text="No files selected yet" FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                           <Button Classes="PrimaryBtn" Content="Browse Files" Click="BrowseFiles_Click" HorizontalAlignment="Center"/>
                        </StackPanel>
                     </Grid>
                  </Border>
               </Grid>

               <!-- Footer Actions -->
               <Border Grid.Row="1" x:Name="SendFooter" Classes="GlassCard" Padding="18,14" Margin="0,16,0,0">
                  <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                     <TextBlock x:Name="SendSummaryText" Text="0 files selected" FontSize="13" FontWeight="Medium" Foreground="#94A3B8" VerticalAlignment="Center"/>
                     <Button Grid.Column="1" x:Name="ZipSendBtn" Content="Compress to ZIP" Click="ZipSend_Click" Classes="GhostBtn" Margin="0,0,10,0" IsVisible="False"/>
                     <Button Grid.Column="2" x:Name="ChooseRecipientBtn" Content="Choose Recipient →" Click="NavSendDiscovery_Click" Classes="PrimaryBtn" Margin="0,0,10,0"/>
                     <Button Grid.Column="3" x:Name="SendToTargetBtn" Content="Send Files →" Click="SendToSelectedTarget_Click" Classes="PrimaryBtn" IsVisible="False"/>
                  </Grid>
               </Border>
            </Grid>

            <!-- ========================================== -->
            <!-- 3. CHOOSE RECIPIENT: RADAR / DEVICES       -->
            <!-- ========================================== -->
            <Grid x:Name="SendDiscoveryPanel" IsVisible="False" Classes="SignalPanel">
               <Grid RowDefinitions="*, Auto, Auto">
                  
                  <!-- Radar Discovery Stage Card -->
                  <Border Grid.Row="0" Classes="GlassCard" Padding="28,20">
                     <Grid RowDefinitions="Auto, *">
                        <!-- Upper Header Bar: Clean Aligned Title & Actions -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,16">
                           <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                              <Border Width="8" Height="8" CornerRadius="4" Background="#7C3AED" VerticalAlignment="Center"/>
                              <TextBlock Text="Select a nearby device to send to:" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                           </StackPanel>

                           <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                              <Button Content="← Back to Files" Click="NavSendFiles_Click" Classes="GhostBtn" Padding="12,6" FontSize="11"/>
                              <Button Content="Refresh Radar" Click="RefreshDiscovery_Click" Classes="PrimaryBtn" Padding="14,6" FontSize="11"/>
                           </StackPanel>
                        </Grid>
                        
                        <!-- Active Animated Radar View -->
                        <Panel Grid.Row="1" Width="480" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                           <!-- Radar Fixed Grid Concentric Rings -->
                           <Ellipse Width="380" Height="380" Stroke="#207C3AED" StrokeThickness="1"/>
                           <Ellipse Width="280" Height="280" Stroke="#187C3AED" StrokeThickness="1" StrokeDashArray="3,3"/>
                           <Ellipse Width="180" Height="180" Stroke="#227C3AED" StrokeThickness="1"/>
                           <Ellipse Width="80" Height="80" Stroke="#287C3AED" StrokeThickness="1"/>

                           <!-- Crosshair Guides -->
                           <Line StartPoint="0,190" EndPoint="380,190" Stroke="#147C3AED" StrokeThickness="1"/>
                           <Line StartPoint="190,0" EndPoint="190,380" Stroke="#147C3AED" StrokeThickness="1"/>

                           <!-- Active Sonar Pulsing Concentric Wave Rings -->
                           <Ellipse Width="380" Height="380" Stroke="#557C3AED" StrokeThickness="1.5" Classes="RadarPulseRing1" IsHitTestVisible="False"/>
                           <Ellipse Width="380" Height="380" Stroke="#4506B6D4" StrokeThickness="1.5" Classes="RadarPulseRing2" IsHitTestVisible="False"/>

                           <!-- Rotating Sonar Sweep Beam -->
                           <Panel Width="380" Height="380" Classes="RadarSweep" IsHitTestVisible="False">
                              <Rectangle Width="190" Height="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                 <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                       <GradientStop Offset="0.0" Color="#007C3AED"/>
                                       <GradientStop Offset="0.7" Color="#907C3AED"/>
                                       <GradientStop Offset="1.0" Color="#C0A855F7"/>
                                    </LinearGradientBrush>
                                 </Rectangle.Fill>
                              </Rectangle>
                              <Polygon Points="190,190 380,150 380,190" Opacity="0.18">
                                 <Polygon.Fill>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                       <GradientStop Offset="0.0" Color="#007C3AED"/>
                                       <GradientStop Offset="1.0" Color="#707C3AED"/>
                                    </LinearGradientBrush>
                                 </Polygon.Fill>
                              </Polygon>
                           </Panel>

                           <!-- Center Local Node (Radar Scanner) -->
                           <Border Width="52" Height="52" CornerRadius="26" Background="#161824" BorderBrush="#7C3AED" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                              <Image Source="avares://WeShare.UI/Assets/find.png" Width="36" Height="36" Stretch="Uniform"/>
                           </Border>

                           <!-- Discovered Peer Nodes (Active Receivers Only) -->
                           <ItemsControl ItemsSource="{Binding ActiveReceivers, RelativeSource={RelativeSource AncestorType=views:MainView}}">
                              <ItemsControl.ItemsPanel>
                                 <ItemsPanelTemplate><Canvas Width="480" Height="380" Background="Transparent"/></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                 <DataTemplate x:DataType="models:DeviceModel">
                                    <Button Click="SendFile_Click" Background="Transparent" Padding="0" BorderThickness="0">
                                       <StackPanel Spacing="4" HorizontalAlignment="Center">
                                          <Border Classes="DeviceMarker" Width="48" Height="48" Background="#161824" BorderBrush="#7C3AED" BorderThickness="2" CornerRadius="24" BoxShadow="0 4 14 0 #40000000">
                                             <Path Data="{Binding Type, Converter={StaticResource DeviceTypeToGeometryConverter}}" Fill="#A5B4FC" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                          </Border>
                                          <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                                       </StackPanel>
                                    </Button>
                                 </DataTemplate>
                              </ItemsControl.ItemTemplate>
                              <ItemsControl.Styles>
                                 <Style Selector="ContentPresenter">
                                    <Setter Property="Canvas.Left">
                                       <MultiBinding Converter="{StaticResource RadarPos}"><Binding /><Binding Path="ActiveReceivers" RelativeSource="{RelativeSource AncestorType=views:MainView}"/><Binding Source="X"/></MultiBinding>
                                    </Setter>
                                    <Setter Property="Canvas.Top">
                                       <MultiBinding Converter="{StaticResource RadarPos}"><Binding /><Binding Path="ActiveReceivers" RelativeSource="{RelativeSource AncestorType=views:MainView}"/><Binding Source="Y"/></MultiBinding>
                                    </Setter>
                                 </Style>
                              </ItemsControl.Styles>
                           </ItemsControl>
                        </Panel>
                     </Grid>
                  </Border>

                  <!-- Discovered Devices Quick Selection Row -->
                  <ItemsControl Grid.Row="1" ItemsSource="{Binding ActiveReceivers, RelativeSource={RelativeSource AncestorType=views:MainView}}" HorizontalAlignment="Center" Margin="0,16,0,0">
                     <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"/></ItemsPanelTemplate>
                     </ItemsControl.ItemsPanel>
                     <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DeviceModel">
                           <Button Click="SendFile_Click" Classes="GhostBtn" Padding="14,8" CornerRadius="8">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                 <Border Width="22" Height="22" CornerRadius="11" Background="#1E2235" VerticalAlignment="Center">
                                    <Path Data="{Binding Type, Converter={StaticResource DeviceTypeToGeometryConverter}}" Fill="#A5B4FC" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                 </Border>
                                 <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                 <TextBlock Text="→ Send" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandVioletBrush}" VerticalAlignment="Center"/>
                              </StackPanel>
                           </Button>
                        </DataTemplate>
                     </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Controls Footer -->
                  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,14,0,0">
                     <TextBlock x:Name="RadarEmptyHint" Text="Scanning local Wi-Fi for active We Share devices..." FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                     <Button Content="Cancel" Click="CancelSending_Click" Classes="GhostBtn" Padding="14,6" FontSize="11"/>
                  </StackPanel>
               </Grid>
            </Grid>

            <!-- ========================================== -->
            <!-- 4. RECEIVE MODE (RADAR SCANNER STATION)    -->
            <!-- ========================================== -->
            <Grid x:Name="ReceiveModePanel" IsVisible="False" Classes="SignalPanel">
               <Grid RowDefinitions="Auto, *, Auto">
                  <!-- Header bar -->
                  <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,16">
                     <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4" Background="#06B6D4" VerticalAlignment="Center"/>
                        <TextBlock Text="RECEIVE RADAR — Discovered Senders:" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                     </StackPanel>
                     <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="Refresh Radar" Click="RefreshDiscovery_Click" Classes="GhostBtn" Padding="14,6" FontSize="11"/>
                        <Button Content="View Active Transfers" Click="NavTransfers_Click" Classes="PrimaryBtn" Padding="16,6" FontSize="11"/>
                     </StackPanel>
                  </Grid>

                  <!-- Radar Stage Card -->
                  <Border Grid.Row="1" Classes="GlassCard" Padding="28,20">
                     <Grid RowDefinitions="*">
                        <Panel Width="480" Height="380" HorizontalAlignment="Center" VerticalAlignment="Center">
                           <!-- Concentric Rings -->
                           <Ellipse Width="380" Height="380" Stroke="#2006B6D4" StrokeThickness="1"/>
                           <Ellipse Width="280" Height="280" Stroke="#1806B6D4" StrokeThickness="1" StrokeDashArray="3,3"/>
                           <Ellipse Width="180" Height="180" Stroke="#2206B6D4" StrokeThickness="1"/>
                           <Ellipse Width="80" Height="80" Stroke="#2806B6D4" StrokeThickness="1"/>

                           <!-- Crosshair Guides -->
                           <Line StartPoint="0,190" EndPoint="380,190" Stroke="#1406B6D4" StrokeThickness="1"/>
                           <Line StartPoint="190,0" EndPoint="190,380" Stroke="#1406B6D4" StrokeThickness="1"/>

                           <!-- Sonar Waves -->
                           <Ellipse Width="380" Height="380" Stroke="#5506B6D4" StrokeThickness="1.5" Classes="RadarPulseRing1" IsHitTestVisible="False"/>
                           <Ellipse Width="380" Height="380" Stroke="#457C3AED" StrokeThickness="1.5" Classes="RadarPulseRing2" IsHitTestVisible="False"/>

                           <!-- Sweep Beam -->
                           <Panel Width="380" Height="380" Classes="RadarSweep" IsHitTestVisible="False">
                              <Rectangle Width="190" Height="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                 <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                       <GradientStop Offset="0.0" Color="#0006B6D4"/>
                                       <GradientStop Offset="0.7" Color="#9006B6D4"/>
                                       <GradientStop Offset="1.0" Color="#C022D3EE"/>
                                    </LinearGradientBrush>
                                 </Rectangle.Fill>
                              </Rectangle>
                              <Polygon Points="190,190 380,150 380,190" Opacity="0.18">
                                 <Polygon.Fill>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                       <GradientStop Offset="0.0" Color="#0006B6D4"/>
                                       <GradientStop Offset="1.0" Color="#7006B6D4"/>
                                    </LinearGradientBrush>
                                 </Polygon.Fill>
                              </Polygon>
                           </Panel>

                           <!-- Center Local Node (This Receiver) -->
                           <Border Width="56" Height="56" CornerRadius="28" Background="#111522" BorderBrush="#06B6D4" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 0 20 0 #4006B6D4">
                              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                 <Path Data="{StaticResource IconReceive}" Fill="#22D3EE" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center"/>
                              </StackPanel>
                           </Border>

                           <!-- Discovered Senders orbiting on Radar Canvas -->
                           <ItemsControl ItemsSource="{Binding ActiveSenders, RelativeSource={RelativeSource AncestorType=views:MainView}}">
                              <ItemsControl.ItemsPanel>
                                 <ItemsPanelTemplate><Canvas Width="480" Height="380" Background="Transparent"/></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                 <DataTemplate x:DataType="models:DeviceModel">
                                     <Button Click="ConnectToPeer_Click" Background="Transparent" Padding="0" BorderThickness="0" ToolTip.Tip="Tap to connect and receive files">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                           <Border Classes="DeviceMarker" Width="48" Height="48" Background="#161824" BorderBrush="#06B6D4" BorderThickness="2" CornerRadius="24" BoxShadow="0 4 14 0 #40000000">
                                              <Path Data="{Binding Type, Converter={StaticResource DeviceTypeToGeometryConverter}}" Fill="#67E8F9" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                           </Border>
                                           <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                                           <TextBlock Text="{Binding RoleDisplay}" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" MaxWidth="80" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                     </Button>
                                  </DataTemplate>
                               </ItemsControl.ItemTemplate>
                               <ItemsControl.Styles>
                                  <Style Selector="ContentPresenter">
                                     <Setter Property="Canvas.Left">
                                        <MultiBinding Converter="{StaticResource RadarPos}"><Binding /><Binding Path="ActiveSenders" RelativeSource="{RelativeSource AncestorType=views:MainView}"/><Binding Source="X"/></MultiBinding>
                                     </Setter>
                                     <Setter Property="Canvas.Top">
                                        <MultiBinding Converter="{StaticResource RadarPos}"><Binding /><Binding Path="ActiveSenders" RelativeSource="{RelativeSource AncestorType=views:MainView}"/><Binding Source="Y"/></MultiBinding>
                                     </Setter>
                                  </Style>
                               </ItemsControl.Styles>
                            </ItemsControl>
                        </Panel>
                     </Grid>
                  </Border>

                   <!-- Discovered Senders Roster & Device Identity Footer -->
                   <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,16,0,0">
                      <!-- Discovered devices quick connect list -->
                      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                         <ItemsControl ItemsSource="{Binding ActiveSenders, RelativeSource={RelativeSource AncestorType=views:MainView}}">
                            <ItemsControl.ItemsPanel>
                               <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                               <DataTemplate x:DataType="models:DeviceModel">
                                  <Button Click="ConnectToPeer_Click" Classes="GhostBtn" Padding="14,8" CornerRadius="8">
                                     <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#161928" VerticalAlignment="Center">
                                           <Path Data="{Binding Type, Converter={StaticResource DeviceTypeToGeometryConverter}}" Fill="#67E8F9" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Spacing="1" VerticalAlignment="Center">
                                           <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                           <TextBlock Text="Tap to Connect" FontSize="10" Foreground="#06B6D4"/>
                                        </StackPanel>
                                     </StackPanel>
                                  </Button>
                               </DataTemplate>
                           </ItemsControl.ItemTemplate>
                        </ItemsControl>
                     </ScrollViewer>

                     <!-- Device Identity Badge -->
                     <Border Grid.Column="1" Background="#161824" BorderBrush="#222638" BorderThickness="1" CornerRadius="10" Padding="14,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                           <StackPanel Spacing="1">
                              <TextBlock Text="THIS RECEIVER" FontSize="9" FontWeight="Bold" Foreground="#06B6D4"/>
                              <TextBlock x:Name="ReceiveDeviceNameText" Text="My PC" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                              <TextBlock x:Name="ReceiveDeviceIpText" Text="192.168.1.100" FontSize="10" Foreground="#94A3B8"/>
                           </StackPanel>
                           <Border Background="#0E2E28" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" Padding="8,4" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                 <Ellipse Width="6" Height="6" Fill="#10B981"/>
                                 <TextBlock Text="RADAR ON" FontSize="9" FontWeight="Bold" Foreground="#10B981"/>
                              </StackPanel>
                           </Border>
                        </StackPanel>
                     </Border>
                  </Grid>

                  <TextBlock x:Name="RecvEmptyState" IsVisible="False"/>
               </Grid>
            </Grid>

            <!-- ========================================== -->
            <!-- 5. ACTIVE TRANSFERS MONITOR                -->
            <!-- ========================================== -->
            <Grid x:Name="TransfersPanel" IsVisible="False" Classes="SignalPanel" RowDefinitions="Auto, Auto, *">
               
               <!-- Empty State: No Active Transfers (Shown when Idle) -->
               <Border Grid.Row="0" x:Name="NoActiveTransfersCard" Classes="GlassCard" Padding="48,44" Margin="0,0,0,16" IsVisible="True">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                     <Border Width="72" Height="72" CornerRadius="36" Background="#207C3AED" BorderBrush="#407C3AED" BorderThickness="1.5" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconTransfer}" Fill="#A855F7" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                     </Border>
                     <StackPanel Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="No Active Transfers" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Your transfer queue is clear. All outgoing and incoming files have completed." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                     </StackPanel>
                     <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Content="Send Files Now" Click="HomeSend_Click" Classes="PrimaryBtn" Padding="18,9"/>
                        <Button Content="Transfer History" Click="NavFiles_Click" Classes="GhostBtn" Padding="16,9"/>
                     </StackPanel>
                  </StackPanel>
               </Border>

               <!-- Active Outgoing Transfer Card (Primary Stream) -->
               <Border Grid.Row="0" x:Name="SendProgressBorder" IsVisible="False" Classes="GlassCard" Padding="22" Margin="0,0,0,16">
                  <Grid RowDefinitions="Auto, 14, Auto, 10, Auto, 6, Auto">
                     <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <StackPanel Spacing="2">
                           <TextBlock Text="TRANSFERRING FILE" FontSize="10" FontWeight="Bold" Foreground="#7C3AED" LetterSpacing="1"/>
                           <TextBlock x:Name="SendProgressFile" Text="document.pdf" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Cancel Transfer" Click="CancelActiveSend_Click" Classes="GhostBtn" Padding="12,6" FontSize="11"/>
                     </Grid>

                     <!-- Progress Bar -->
                     <ProgressBar Grid.Row="2" x:Name="SendProgressBar" Height="6" CornerRadius="3" Foreground="#7C3AED" Background="#1E2235"/>

                     <Grid Grid.Row="4" ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="SendProgressSpeed" Text="Calculating speed..." FontSize="12" Foreground="#94A3B8"/>
                        <TextBlock Grid.Column="1" x:Name="SendProgressPct" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#7C3AED"/>
                     </Grid>
                     <controls:SpeedGraphControl Grid.Row="6" x:Name="SendSpeedGraph" Height="40" Margin="0,6,0,0"/>
                  </Grid>
               </Border>

               <!-- Multi-Device Outgoing Transfers List -->
               <Border Grid.Row="1" x:Name="OutgoingTransfersBorder" Classes="GlassCard" Padding="20" Margin="0,0,0,16" IsVisible="False">
                  <Grid RowDefinitions="Auto, 14, *">
                     <TextBlock Text="Active Outgoing Transfers" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                     <ScrollViewer Grid.Row="2" MaxHeight="240">
                        <ItemsControl x:Name="OutgoingList">
                           <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="models:FileTransferState">
                                 <Border Classes="TrackRow" Padding="14,12" Margin="0,0,0,6" Background="#161824" CornerRadius="8">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                       <Border Grid.Column="0" Width="36" Height="36" Background="#1E2235" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center">
                                          <Path Data="{StaticResource IconSend}" Fill="#7C3AED" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                       </Border>
                                       <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                          <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                          <ProgressBar Height="4" Value="{Binding ProgressPercentage}" Foreground="#7C3AED" Background="#262A3D" CornerRadius="2"/>
                                          <TextBlock Text="{Binding PeerName, StringFormat='To: {0}'}" FontSize="11" Foreground="#64748B"/>
                                       </StackPanel>
                                       <TextBlock Grid.Column="2" Text="{Binding SpeedMbPerSec, StringFormat='\{0:F1\} MB/s'}" FontSize="12" Foreground="#06B6D4" VerticalAlignment="Center" Margin="14,0"/>
                                       <Button Grid.Column="3" Content="Abort" Click="CancelOutgoingItem_Click" Tag="{Binding}" Classes="GhostBtn" Padding="10,5" FontSize="10" VerticalAlignment="Center"/>
                                    </Grid>
                                 </Border>
                              </DataTemplate>
                           </ItemsControl.ItemTemplate>
                        </ItemsControl>
                     </ScrollViewer>
                  </Grid>
               </Border>

               <!-- Incoming Transfers List -->
               <Border Grid.Row="2" x:Name="IncomingBorder" Classes="GlassCard" Padding="20" IsVisible="False">
                  <Grid RowDefinitions="Auto, 14, *">
                     <TextBlock Text="Active Incoming Peer Transfers" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                     <ScrollViewer Grid.Row="2">
                        <ItemsControl x:Name="IncomingList">
                           <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="models:FileTransferState">
                                 <Border Classes="TrackRow" Padding="14,12" Margin="0,0,0,6" Background="#161824" CornerRadius="8">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                       <Border Grid.Column="0" Width="36" Height="36" Background="#1E2235" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center">
                                          <Path Data="{StaticResource IconReceive}" Fill="#6366F1" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                       </Border>
                                       <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                          <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                          <ProgressBar Height="4" Value="{Binding ProgressPercentage}" Foreground="#6366F1" Background="#262A3D" CornerRadius="2"/>
                                          <TextBlock Text="{Binding PeerName, StringFormat='From: {0}'}" FontSize="11" Foreground="#64748B"/>
                                       </StackPanel>
                                       <TextBlock Grid.Column="2" Text="{Binding SpeedMbPerSec, StringFormat='\{0:F1\} MB/s'}" FontSize="12" Foreground="#06B6D4" VerticalAlignment="Center" Margin="14,0"/>
                                       <Button Grid.Column="3" Content="Abort" Click="CancelIncoming_Click" Classes="GhostBtn" Padding="10,5" FontSize="10" VerticalAlignment="Center"/>
                                    </Grid>
                                 </Border>
                              </DataTemplate>
                           </ItemsControl.ItemTemplate>
                        </ItemsControl>
                     </ScrollViewer>
                  </Grid>
               </Border>

               <!-- Completed Transfers & History Ledger -->
               <Border Grid.Row="3" Classes="GlassCard" Padding="20" Margin="0,16,0,0">
                  <Grid RowDefinitions="Auto, 14, Auto, 14, *">
                     <!-- Search Bar & Folder Actions -->
                     <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto">
                        <TextBox x:Name="FileSearchBox" Watermark="Search transferred files..." TextChanged="FileSearch_TextChanged" Width="280" HorizontalAlignment="Left"/>
                        <Button Grid.Column="1" Content="Clear Completed" Click="ClearCompletedTransfers_Click" Classes="GhostBtn" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Content="Open Downloads Folder" Click="OpenDownloadFolder_Click" Classes="PrimaryBtn"/>
                     </Grid>

                     <!-- Filter Chips & Ledger Stats -->
                     <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
                        <TextBlock x:Name="LibraryStatsText" Text="0 transfers" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                           <Button x:Name="FilterAllBtn" Content="All" Click="FilterDate_Click" Tag="All" Classes="FilterChip ActiveChip"/>
                           <Button x:Name="FilterTodayBtn" Content="Today" Click="FilterDate_Click" Tag="Today" Classes="FilterChip"/>
                           <Button x:Name="FilterWeekBtn" Content="This Week" Click="FilterDate_Click" Tag="Week" Classes="FilterChip"/>
                        </StackPanel>
                     </Grid>

                     <!-- Received Files Data Grid -->
                     <Border Grid.Row="4" Background="#161824" CornerRadius="8" Padding="12">
                        <Grid>
                           <ScrollViewer MaxHeight="300">
                              <ItemsControl x:Name="ReceivedFilesList">
                                 <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileTransferState">
                                       <Border Classes="TrackRow" Padding="12,10" Margin="0,0,0,4">
                                          <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                             <Border Grid.Column="0" Width="34" Height="34" Background="#1E2235" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconFile}" Fill="#818CF8" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                             </Border>
                                             <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" Foreground="#64748B">
                                                   <TextBlock.Text>
                                                      <MultiBinding Converter="{StaticResource TransferDirLabel}">
                                                         <Binding Path="PeerName"/>
                                                         <Binding Path="Direction"/>
                                                      </MultiBinding>
                                                   </TextBlock.Text>
                                                </TextBlock>
                                             </StackPanel>
                                             <TextBlock Grid.Column="2" Text="{Binding FileSizeDisplay}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="16,0"/>
                                             
                                             <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsCompleted}">
                                                <Button Content="Open" Click="OpenFileInList_Click" Tag="{Binding}" Classes="PrimaryBtn" Padding="12,5" FontSize="10"/>
                                                <Button Content="Show in Folder" Click="OpenFolderInList_Click" Tag="{Binding}" Classes="GhostBtn" Padding="10,5" FontSize="10"/>
                                                <Button Content="Resend" Click="RequestResendForFile_Click" Tag="{Binding}" Classes="GhostBtn" Padding="10,5" FontSize="10" TextElement.Foreground="#06B6D4"/>
                                                <Button Click="DeleteFileInList_Click" Tag="{Binding}" Background="Transparent" Padding="6">
                                                   <Path Data="{StaticResource IconClose}" Fill="#EF4444" Width="10" Height="10" Stretch="Uniform"/>
                                                </Button>
                                             </StackPanel>

                                             <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding !IsCompleted}">
                                                <Button Content="Cancel" Click="CancelIncoming_Click" Classes="GhostBtn" Padding="10,5" FontSize="10"/>
                                             </StackPanel>
                                          </Grid>
                                       </Border>
                                    </DataTemplate>
                                 </ItemsControl.ItemTemplate>
                              </ItemsControl>
                           </ScrollViewer>

                           <TextBlock x:Name="HistoryEmptyState" Text="No transfers recorded yet" FontSize="13" FontWeight="Medium" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                     </Border>
                  </Grid>
               </Border>
            </Grid>

            <!-- Collapsed Compatibility Anchor for FilesPanel -->
            <Grid x:Name="FilesPanel" IsVisible="False"/>

            <!-- ========================================== -->
            <!-- 7. WEB TRANSFER & CONNECT (DEDICATED SCREEN) -->
            <!-- ========================================== -->
            <!-- ========================================== -->
            <!-- 7. REMADE WEB PORTAL MANAGEMENT PAGE       -->
            <!-- ========================================== -->
            <Grid x:Name="WebSharedPanel" IsVisible="False" Classes="SignalPanel" RowDefinitions="Auto, Auto, *">
               
               <!-- 7.1 TOP HUB: CONNECTION BAR & SMART HOTSPOT -->
               <Border Grid.Row="0" Classes="GlassCard" Padding="20,16" Margin="0,0,0,16">
                  <Grid ColumnDefinitions="*, Auto">
                     <!-- Left: Server URL & Status -->
                     <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                           <Border Width="8" Height="8" CornerRadius="4" Background="#10B981"/>
                           <TextBlock Text="WEB PORTAL SERVER ACTIVE" FontSize="11" FontWeight="Bold" Foreground="#10B981" LetterSpacing="0.8"/>
                           <TextBlock x:Name="WebPortalNetworkInfo" Text="• High-Speed Local Daemon" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                           <Border Background="#161824" BorderBrush="#222638" BorderThickness="1" CornerRadius="8" Padding="12,8">
                              <TextBlock x:Name="HomeWebPortalText" Text="http://192.168.1.100:8080" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                           </Border>
                           <Button x:Name="CopyWebLinkBtn" Content="Copy Link" Click="CopyWebLink_Click" Classes="GhostBtn" Padding="12,8" FontSize="11"/>
                           <Button Content="Open in Browser" Click="OpenWebPortalBrowser_Click" Classes="GhostBtn" Padding="12,8" FontSize="11"/>
                           <Button x:Name="ToggleQrBtn" Content="QR Code" Click="ToggleQrCode_Click" Classes="GhostBtn" Padding="12,8" FontSize="11"/>
                        </StackPanel>
                     </StackPanel>

                     <!-- Right: Smart Hotspot Controls with Clear Explanation -->
                     <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="StartHotspotBtn" Content="Direct Hotspot" Click="ManualStartHotspot_Click" Classes="PrimaryBtn" Padding="16,9" FontSize="12" ToolTip.Tip="Creates a private local Wi-Fi network directly from this PC when no router exists or devices cannot see each other."/>
                        <TextBlock Text="Use if devices are on different networks" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right"/>
                     </StackPanel>
                  </Grid>
               </Border>

               <!-- 7.2 COLLAPSIBLE QR CODE DRAWER -->
               <Border Grid.Row="1" x:Name="WebPortalQrDrawer" IsVisible="False" Classes="GlassCard" Padding="20" Margin="0,0,0,16" HorizontalAlignment="Center">
                  <StackPanel Spacing="12" HorizontalAlignment="Center">
                     <Border Background="#FFFFFF" CornerRadius="12" Padding="12" HorizontalAlignment="Center" Width="170" Height="170" BoxShadow="0 6 24 0 #40000000">
                        <Image x:Name="HomeQrImage" Stretch="Uniform"/>
                     </Border>
                     <TextBlock Text="Scan with phone camera to connect instantly without installing an app" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                  </StackPanel>
               </Border>

               <!-- 7.3 MAIN MANAGEMENT DECK: ACTIVE DEVICES RAIL + DEVICE WORKSPACE -->
               <Grid Grid.Row="2" RowDefinitions="Auto, *">
                  
                  <!-- ACTIVE DEVICES RAIL HEADER & CARDS -->
                  <Border Grid.Row="0" Classes="GlassCard" Padding="16,14" Margin="0,0,0,16">
                     <Grid RowDefinitions="Auto, Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,10">
                           <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                              <Border Width="7" Height="7" CornerRadius="3.5" Background="#4F46E5"/>
                              <TextBlock Text="ACTIVE CONNECTED DEVICES" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" LetterSpacing="0.6"/>
                           </StackPanel>
                           <TextBlock Grid.Column="2" x:Name="WebClientsRailCountText" Text="0 devices connected" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Devices Selection Horizontal List -->
                        <ListBox Grid.Row="1" x:Name="WebClientsListBox" Background="Transparent" BorderThickness="0" SelectionChanged="WebClientsListBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                           <ListBox.ItemsPanel>
                              <ItemsPanelTemplate>
                                 <StackPanel Orientation="Horizontal" Spacing="10"/>
                              </ItemsPanelTemplate>
                           </ListBox.ItemsPanel>
                           <ListBox.ItemTemplate>
                              <DataTemplate x:DataType="models:DeviceModel">
                                 <Border Background="#161824" BorderBrush="#262D44" BorderThickness="1.5" CornerRadius="10" Padding="14,10" MinWidth="170">
                                    <Grid ColumnDefinitions="Auto, *">
                                       <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#204F46E5" Margin="0,0,10,0" VerticalAlignment="Center">
                                          <Path Data="{Binding Type, Converter={StaticResource DeviceTypeToGeometryConverter}}" Fill="#A5B4FC" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                       </Border>
                                       <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                          <StackPanel Orientation="Horizontal" Spacing="5">
                                             <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" VerticalAlignment="Center"/>
                                             <TextBlock Text="{Binding IpAddress}" FontSize="10" Foreground="#64748B"/>
                                          </StackPanel>
                                       </StackPanel>
                                    </Grid>
                                 </Border>
                              </DataTemplate>
                           </ListBox.ItemTemplate>
                        </ListBox>
                     </Grid>
                  </Border>

                  <!-- WORKSPACE BODY: (A) DEVICE SESSION WORKSTATION or (B) NO DEVICES WELCOME -->
                  <Grid Grid.Row="1">
                     
                     <!-- (A) DEVICE SESSION WORKSTATION (Shown when a device is selected) -->
                     <Border x:Name="WebDeviceSessionView" Classes="GlassCard" Padding="20" IsVisible="True">
                        <Grid RowDefinitions="Auto, 16, *">
                           
                           <!-- Selected Device Context Header -->
                           <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                              <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#1E2338" Margin="0,0,12,0" VerticalAlignment="Center">
                                 <Path x:Name="SelectedWebClientIcon" Data="{StaticResource IconMobile}" Fill="#818CF8" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                 <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="DEVICE WORKSPACE:" FontSize="10" FontWeight="Bold" Foreground="#818CF8" LetterSpacing="0.8"/>
                                    <TextBlock x:Name="SelectedWebClientName" Text="Selected Device" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                 </StackPanel>
                                 <TextBlock x:Name="SelectedWebClientDetails" Text="IP: 192.168.1.88 • Connected via Web Portal" FontSize="11" Foreground="#94A3B8"/>
                              </StackPanel>
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                 <Button Content="Disconnect Client" Click="DisconnectCurrentWebClient_Click" Classes="GhostBtn" Padding="12,6" FontSize="11" Foreground="#EF4444"/>
                              </StackPanel>
                           </Grid>

                           <!-- Dual Panes: Left = Send To Device, Right = Received From Device -->
                           <Grid Grid.Row="2" ColumnDefinitions="*, 16, *">
                              
                              <!-- LEFT PANE: SEND TO THIS DEVICE -->
                              <Border Grid.Column="0" Background="#121420" BorderBrush="#222638" BorderThickness="1" CornerRadius="10" Padding="16">
                                 <Grid RowDefinitions="Auto, 12, Auto, 12, *, 14, Auto">
                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                       <TextBlock Text="Send to this Device" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                       <TextBlock Grid.Column="1" x:Name="WebSendStagedCountText" Text="0 files ready" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                       <Button Classes="PrimaryBtn" Content="+ Add Files" Click="WebAddFiles_Click" Padding="14,7" FontSize="11"/>
                                       <Button Classes="GhostBtn" Content="+ Add Folder" Click="WebAddFolder_Click" Padding="12,7" FontSize="11"/>
                                       <Button Classes="GhostBtn" Content="Clear" Click="WebClearSendQueue_Click" Padding="10,7" FontSize="11"/>
                                    </StackPanel>

                                    <!-- Dropzone & Staged Items Queue -->
                                    <Border Grid.Row="4" Background="#161824" BorderBrush="#323850" BorderThickness="1" CornerRadius="8" Padding="8">
                                       <Grid>
                                          <ScrollViewer>
                                             <ItemsControl x:Name="WebClientSendQueueList">
                                                <ItemsControl.ItemTemplate>
                                                   <DataTemplate x:DataType="views:QueueItem">
                                                      <Border Classes="TrackRow" Padding="10,7" Margin="0,2" Background="#1B1F30" CornerRadius="6">
                                                         <Grid ColumnDefinitions="Auto, *, Auto">
                                                            <Path Grid.Column="0" Data="{StaticResource IconFile}" Fill="#818CF8" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                               <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                               <TextBlock Text="{Binding SizeDisplay}" FontSize="10" Foreground="#94A3B8"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Click="WebRemoveStagedItem_Click" Background="Transparent" Padding="6">
                                                               <Path Data="{StaticResource IconClose}" Fill="#EF4444" Width="9" Height="9" Stretch="Uniform"/>
                                                            </Button>
                                                         </Grid>
                                                      </Border>
                                                   </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                             </ItemsControl>
                                          </ScrollViewer>

                                          <StackPanel x:Name="WebSendQueueEmptyLabel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                             <Path Data="{StaticResource IconSend}" Fill="#3E4562" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/>
                                             <TextBlock Text="No files staged. Click Add Files" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
                                          </StackPanel>
                                       </Grid>
                                    </Border>

                                    <!-- Send Action Button -->
                                    <Button Grid.Row="6" x:Name="WebSendToDeviceBtn" Content="Send Files to Device" Click="WebSendToDevice_Click" Classes="PrimaryBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,10" FontSize="13" FontWeight="Bold"/>
                                 </Grid>
                              </Border>

                              <!-- RIGHT PANE: RECEIVED FROM THIS DEVICE -->
                              <Border Grid.Column="2" Background="#121420" BorderBrush="#222638" BorderThickness="1" CornerRadius="10" Padding="16">
                                 <Grid RowDefinitions="Auto, 12, *, 12, Auto">
                                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto">
                                       <TextBlock Text="Received from this Device" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                       <TextBlock Grid.Column="1" x:Name="WebFilesCountText" Text="0 files" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                       <Button Grid.Column="2" x:Name="WebAcceptAllBtn" Content="Accept All" Click="WebAcceptAllFiles_Click" Classes="PrimaryBtn" Padding="10,5" FontSize="11"/>
                                    </Grid>

                                    <!-- Staged Incoming Files List -->
                                    <Border Grid.Row="2" Background="#161824" BorderBrush="#323850" BorderThickness="1" CornerRadius="8" Padding="8">
                                       <Grid>
                                          <ScrollViewer>
                                             <ItemsControl x:Name="WebSharedFilesList">
                                                <ItemsControl.ItemTemplate>
                                                   <DataTemplate x:DataType="views:StagedWebFile">
                                                      <Border Classes="TrackRow" Padding="10,8" Margin="0,2" Background="#1B1F30" CornerRadius="6">
                                                         <Grid ColumnDefinitions="*, Auto, Auto">
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                               <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                               <TextBlock Text="{Binding SizeDisplay}" FontSize="10" Foreground="#94A3B8"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="Accept" Tag="{Binding}" Click="AcceptWebSharedFile_Click" Classes="PrimaryBtn" Padding="10,5" FontSize="10" Margin="0,0,6,0"/>
                                                            <Button Grid.Column="2" Content="Reject" Tag="{Binding}" Click="RejectWebSharedFile_Click" Classes="GhostBtn" Padding="8,5" FontSize="10"/>
                                                         </Grid>
                                                      </Border>
                                                   </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                             </ItemsControl>
                                          </ScrollViewer>

                                          <TextBlock x:Name="WebFilesEmptyLabel" Text="Waiting for incoming uploads..." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                       </Grid>
                                    </Border>

                                    <!-- Storage Footer -->
                                    <Button Grid.Row="4" Content="Open Downloads Folder" Click="OpenDownloadFolder_Click" Classes="GhostBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,8" FontSize="11"/>
                                 </Grid>
                              </Border>

                           </Grid>

                        </Grid>
                     </Border>

                     <!-- (B) NO DEVICES CONNECTED WELCOME STATE (Shown when 0 web clients) -->
                     <Border x:Name="NoWebClientsCard" Classes="GlassCard" Padding="36" IsVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" MaxWidth="520">
                           <Border Width="64" Height="64" CornerRadius="32" Background="#207C3AED" HorizontalAlignment="Center">
                              <Path Data="{StaticResource IconGlobe}" Fill="#A855F7" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                           </Border>
                           <StackPanel Spacing="6" HorizontalAlignment="Center">
                              <TextBlock Text="Connect Any Device in 3 Seconds" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                              <TextBlock Text="No app installation needed. Transfer files directly between iPhone, Android, Mac, and PC via your local browser." FontSize="13" Foreground="#94A3B8" TextAlignment="Center" TextWrapping="Wrap"/>
                           </StackPanel>

                           <Border Background="#161824" BorderBrush="#222638" BorderThickness="1" CornerRadius="10" Padding="18">
                              <StackPanel Spacing="10">
                                 <TextBlock Text="HOW TO CONNECT:" FontSize="11" FontWeight="Bold" Foreground="#7C3AED" LetterSpacing="0.8"/>
                                 <TextBlock Text="1. Make sure both devices are on the same Wi-Fi (or click Start Hotspot)." FontSize="12" Foreground="#E2E8F0"/>
                                 <TextBlock Text="2. Scan the QR code or visit the URL shown at the top in your browser." FontSize="12" Foreground="#E2E8F0"/>
                                 <TextBlock Text="3. Your device will automatically appear in the Active Devices rail above!" FontSize="12" Foreground="#E2E8F0"/>
                              </StackPanel>
                           </Border>

                           <Button Content="Show QR Code" Click="ToggleQrCode_Click" Classes="PrimaryBtn" HorizontalAlignment="Center" Padding="20,10" FontSize="13"/>
                        </StackPanel>
                     </Border>

                  </Grid>
               </Grid>

               <!-- Compatibility anchors for legacy references -->
               <Panel IsVisible="False">
                  <Border x:Name="HomeWebPortalPanel"/>
                  <Border x:Name="HomeWifiPasswordPanel"><TextBlock x:Name="HomeWifiPasswordText"/></Border>
                  <Border x:Name="HomeWifiWebPortalPanel">
                     <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="HomeWifiWebPortalText"/>
                        <Button x:Name="CopyWifiWebLinkBtn"/>
                     </StackPanel>
                  </Border>
                  <Rectangle x:Name="HomeWifiWebPortalSeparator"/>
                  <Rectangle x:Name="HomeWifiPasswordSeparator"/>
                  <TextBlock x:Name="WebPortalLabel"/>
                  <Grid x:Name="DeviceSessionPanel">
                     <TextBlock x:Name="SessionDeviceTitle"/>
                     <TextBlock x:Name="SessionDeviceSub"/>
                     <Button x:Name="SessionSendFilesBtn"/>
                     <Button x:Name="SessionSendFolderBtn"/>
                     <TextBlock x:Name="SessionSendStatusText"/>
                     <TextBlock x:Name="SessionIncomingCountText"/>
                     <TextBlock x:Name="SessionIncomingEmptyLabel"/>
                     <ItemsControl x:Name="SessionIncomingFilesList"/>
                  </Grid>
               </Panel>
            </Grid>

            <!-- 8. SETTINGS PANEL                          -->
            <!-- ========================================== -->
            <Grid x:Name="SettingsPanel" IsVisible="False" Classes="SignalPanel">
               <ScrollViewer>
                  <StackPanel Spacing="18" MaxWidth="640" HorizontalAlignment="Left">
                     
                     <!-- Node Identity Card -->
                     <Border Classes="GlassCard" Padding="24">
                        <StackPanel Spacing="14">
                           <StackPanel Spacing="2">
                              <TextBlock Text="DEVICE IDENTITY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandVioletBrush}" LetterSpacing="1"/>
                              <TextBlock Text="Set your workstation nickname visible to other peers on the Radar and Web Portal." FontSize="12" Foreground="#94A3B8"/>
                           </StackPanel>
                           <TextBox x:Name="SettingsDeviceName" TextChanged="SettingsDeviceName_TextChanged" MaxLength="32"/>
                        </StackPanel>
                     </Border>

                     <!-- Download Storage Card -->
                     <Border Classes="GlassCard" Padding="24">
                        <StackPanel Spacing="14">
                           <StackPanel Spacing="2">
                              <TextBlock Text="DOWNLOAD DIRECTORY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandVioletBrush}" LetterSpacing="1"/>
                              <TextBlock Text="Location where received files and folders will be saved." FontSize="12" Foreground="#94A3B8"/>
                           </StackPanel>
                           <Grid ColumnDefinitions="*, Auto, Auto">
                              <Border Background="#12141F" BorderBrush="#222638" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,10,0" VerticalAlignment="Center">
                                 <TextBlock x:Name="SettingsSaveLocationLabel" Text="C:\Downloads" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                              </Border>
                              <Button Grid.Column="1" Content="Change Folder" Click="ChangeSaveLocation_Click" Classes="GhostBtn" Padding="12,7" FontSize="11" Margin="0,0,8,0"/>
                              <Button Grid.Column="2" Content="Open Folder" Click="OpenDownloadFolder_Click" Classes="PrimaryBtn" Padding="12,7" FontSize="11"/>
                           </Grid>
                        </StackPanel>
                     </Border>

                     <!-- Transfer & Audio Preferences Card -->
                     <Border Classes="GlassCard" Padding="24">
                        <StackPanel Spacing="18">
                           <TextBlock Text="TRANSFER PREFERENCES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandVioletBrush}" LetterSpacing="1"/>
                           
                           <Grid ColumnDefinitions="*, Auto">
                              <StackPanel Spacing="2">
                                 <TextBlock Text="Auto-Accept Incoming Transfers" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                 <TextBlock Text="Automatically accept file transfers from verified peers without showing approval prompt." FontSize="11" Foreground="#64748B"/>
                              </StackPanel>
                              <ToggleSwitch Grid.Column="1" x:Name="AutoAcceptToggle" IsCheckedChanged="AutoAcceptSwitch_Changed"/>
                           </Grid>

                           <Rectangle Height="1" Fill="#1E2235"/>

                           <Grid ColumnDefinitions="*, Auto">
                              <StackPanel Spacing="2">
                                 <TextBlock Text="Sound Effects (Audio Chimes)" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                 <TextBlock Text="Play notification chime when file transfers arrive or successfully complete." FontSize="11" Foreground="#64748B"/>
                              </StackPanel>
                              <ToggleSwitch Grid.Column="1" x:Name="SoundToggle" IsChecked="True" IsCheckedChanged="SoundSwitch_Changed"/>
                           </Grid>
                        </StackPanel>
                     </Border>

                     <!-- Software Updates Card -->
                     <Border Classes="GlassCard" Padding="24">
                        <StackPanel Spacing="14">
                           <TextBlock Text="SOFTWARE UPDATES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandVioletBrush}" LetterSpacing="1"/>
                           <Grid ColumnDefinitions="*, Auto">
                              <StackPanel Spacing="2">
                                 <TextBlock x:Name="SettingsVersionText" Text="Version 1.1.0" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                 <TextBlock x:Name="SettingsUpdateStatusText" Text="You are running the latest version" FontSize="12" Foreground="#64748B"/>
                              </StackPanel>
                              <Button Grid.Column="1" x:Name="SettingsCheckUpdateBtn" Content="Check for Updates" Click="CheckForUpdate_Click" Classes="GhostBtn" Padding="14,6" FontSize="11"/>
                           </Grid>
                           <Button x:Name="SettingsDownloadInstallBtn" Content="Install Update" Click="DownloadInstallUpdate_Click" Classes="PrimaryBtn" IsVisible="False"/>
                           
                           <StackPanel x:Name="SettingsUpdateProgressPanel" IsVisible="False" Spacing="4">
                              <TextBlock x:Name="SettingsUpdateProgressText" Text="Downloading..." FontSize="11" Foreground="#94A3B8"/>
                              <ProgressBar x:Name="SettingsUpdateProgressBar" Height="4"/>
                              <TextBlock x:Name="SettingsUpdateProgressPct" Text="0%" FontSize="10" Foreground="#7C3AED"/>
                           </StackPanel>
                        </StackPanel>
                     </Border>

                  </StackPanel>
               </ScrollViewer>
            </Grid>

            <!-- ========================================== -->
            <!-- 9. ABOUT PANEL (PROFESSIONAL ENGINEERING TEMPLATE) -->
            <!-- ========================================== -->
            <Grid x:Name="AboutPanel" IsVisible="False" Classes="SignalPanel">
               <ScrollViewer>
                  <StackPanel Spacing="20" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,24">
                     
                     <!-- Hero Specification Card -->
                     <Border Classes="GlassCard" Padding="28">
                        <Grid ColumnDefinitions="Auto, *">
                           <Border Grid.Column="0" Width="72" Height="72" CornerRadius="18" Background="#161826" BorderBrush="#7C3AED" BorderThickness="1.5" Margin="0,0,22,0" VerticalAlignment="Top" BoxShadow="0 6 24 0 #407C3AED" ClipToBounds="True">
                              <Image Source="avares://WeShare.UI/Assets/app_logo.png" Width="52" Height="52" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                           </Border>
                           <StackPanel Grid.Column="1" Spacing="8">
                              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                 <TextBlock Text="We Share" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF"/>
                                 <Border Background="#207C3AED" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="AboutVersionText" Text="v1.2.0-STABLE" FontSize="11" Foreground="#A855F7" FontWeight="SemiBold"/>
                                 </Border>
                                 <Border Background="#2010B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="AIR-GAPPED" FontSize="10" Foreground="#10B981" FontWeight="SemiBold"/>
                                 </Border>
                              </StackPanel>
                              <TextBlock Text="High-Throughput Local Area Network Data Transport Engine" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                              <TextBlock Text="Engineered for high-throughput, latency-critical peer-to-peer file synchronization across heterogeneous operating systems. Operates 100% locally with zero cloud dependencies, zero external relays, and maximum gigabit line-rate." FontSize="12" Foreground="#94A3B8" LineHeight="19" TextWrapping="Wrap"/>
                           </StackPanel>
                        </Grid>
                     </Border>

                     <!-- Core Architecture & Engineering Matrix (2x2 Grid) -->
                     <Border Classes="GlassCard" Padding="24">
                        <StackPanel Spacing="16">
                           <TextBlock Text="CORE ARCHITECTURAL SUBSYSTEMS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandVioletBrush}" LetterSpacing="1"/>
                           
                           <Grid RowDefinitions="Auto, 12, Auto" ColumnDefinitions="*, 12, *">
                              <!-- Subsystem 1 -->
                              <Border Grid.Row="0" Grid.Column="0" Background="#80121524" BorderBrush="#262D42" BorderThickness="1" CornerRadius="10" Padding="16">
                                 <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                       <Border Width="24" Height="24" CornerRadius="6" Background="#204F46E5">
                                          <Path Data="{StaticResource IconTransfers}" Fill="#818CF8" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                       </Border>
                                       <TextBlock Text="Direct Socket Engine" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Full-duplex asynchronous raw TCP streaming with 1MB ring buffer framing, memory pooling, and auto-tuned TCP window sizing." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="16"/>
                                 </StackPanel>
                              </Border>

                              <!-- Subsystem 2 -->
                              <Border Grid.Row="0" Grid.Column="2" Background="#80121524" BorderBrush="#262D42" BorderThickness="1" CornerRadius="10" Padding="16">
                                 <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                       <Border Width="24" Height="24" CornerRadius="6" Background="#2006B6D4">
                                          <Path Data="{StaticResource IconWifi}" Fill="#06B6D4" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                       </Border>
                                       <TextBlock Text="Autonomous Discovery" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Dual-stack mDNS / DNS-SD zero-configuration discovery coupled with UDP multicast beacons on port 45678 for instant peer pairing." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="16"/>
                                 </StackPanel>
                              </Border>

                              <!-- Subsystem 3 -->
                              <Border Grid.Row="2" Grid.Column="0" Background="#80121524" BorderBrush="#262D42" BorderThickness="1" CornerRadius="10" Padding="16">
                                 <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                       <Border Width="24" Height="24" CornerRadius="6" Background="#2010B981">
                                          <Path Data="{StaticResource IconGlobe}" Fill="#10B981" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                       </Border>
                                       <TextBlock Text="Embedded Web Daemon" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Self-contained asynchronous HTTP/1.1 micro-server with SSE telemetry streaming. Connect and transfer files from any mobile or desktop browser without installing software." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="16"/>
                                 </StackPanel>
                              </Border>

                              <!-- Subsystem 4 -->
                              <Border Grid.Row="2" Grid.Column="2" Background="#80121524" BorderBrush="#262D42" BorderThickness="1" CornerRadius="10" Padding="16">
                                 <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                       <Border Width="24" Height="24" CornerRadius="6" Background="#206366F1">
                                          <Path Data="{StaticResource IconSettings}" Fill="#818CF8" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                       </Border>
                                       <TextBlock Text="Air-Gapped Sovereignty" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Data strictly remains within the local subnet perimeter. Zero analytics, zero cloud telemetry, and complete resistance to external network snooping." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" LineHeight="16"/>
                                 </StackPanel>
                              </Border>
                           </Grid>
                        </StackPanel>
                     </Border>

                     <!-- System Specifications Matrix -->
                     <Border Classes="GlassCard" Padding="24">
                        <StackPanel Spacing="14">
                           <TextBlock Text="TECHNICAL SPECIFICATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandVioletBrush}" LetterSpacing="1"/>
                           
                           <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="160, *">
                              <TextBlock Grid.Row="0" Grid.Column="0" Text="Target Framework" FontSize="12" Foreground="#64748B" Margin="0,4"/>
                              <TextBlock Grid.Row="0" Grid.Column="1" Text=".NET 8.0 LTS CoreCLR (C# 12)" FontSize="12" Foreground="#F8FAFC" FontWeight="Medium" Margin="0,4"/>

                              <TextBlock Grid.Row="1" Grid.Column="0" Text="UI Subsystem" FontSize="12" Foreground="#64748B" Margin="0,4"/>
                              <TextBlock Grid.Row="1" Grid.Column="1" Text="Avalonia UI 11.0 (Hardware-Accelerated Direct2D / Skia)" FontSize="12" Foreground="#F8FAFC" FontWeight="Medium" Margin="0,4"/>

                              <TextBlock Grid.Row="2" Grid.Column="0" Text="Security Layer" FontSize="12" Foreground="#64748B" Margin="0,4"/>
                              <TextBlock Grid.Row="2" Grid.Column="1" Text="TLS 1.3 / AES-256 GCM In-Flight Encryption Handshake" FontSize="12" Foreground="#F8FAFC" FontWeight="Medium" Margin="0,4"/>

                              <TextBlock Grid.Row="3" Grid.Column="0" Text="Concurrency Model" FontSize="12" Foreground="#64748B" Margin="0,4"/>
                              <TextBlock Grid.Row="3" Grid.Column="1" Text="Non-blocking Asynchronous Multi-Session Transfer Pipelines" FontSize="12" Foreground="#F8FAFC" FontWeight="Medium" Margin="0,4"/>
                           </Grid>
                        </StackPanel>
                     </Border>

                     <!-- Architect & Credits Card -->
                     <Border Classes="GlassCard" Padding="22">
                        <Grid ColumnDefinitions="*, Auto, Auto">
                           <StackPanel VerticalAlignment="Center" Spacing="4">
                              <TextBlock Text="Lead Architect &amp; Developer: Sowmiyan S" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"/>
                              <TextBlock Text="Distributed System Design • Desktop UX Architecture • Network Protocols" FontSize="11" Foreground="#64748B"/>
                           </StackPanel>
                           <Button Grid.Column="1" Content="Open Downloads" Click="OpenDownloadFolder_Click" Classes="GhostBtn" Margin="0,0,10,0"/>
                           <Button Grid.Column="2" Content="View on GitHub →" Click="OpenGitHub_Click" Classes="PrimaryBtn"/>
                        </Grid>
                     </Border>

                  </StackPanel>
               </ScrollViewer>
            </Grid>

              </Grid>
          </Grid>
        </ScrollViewer>

        <!-- ========================================== -->
        <!-- FLOATING ACTIVE TRANSFER DOCK              -->
        <!-- ========================================== -->
        <Border x:Name="ActiveTransferDock" Grid.Row="1" IsVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="36,0,36,18" ZIndex="4500" Background="#F2111422" BorderBrush="#607C3AED" BorderThickness="1.5" CornerRadius="14" Padding="16,12" BoxShadow="0 14 40 0 #B0000000">
           <Grid ColumnDefinitions="Auto, *, 220, Auto, Auto">
              <!-- Direction Badge -->
              <Border Grid.Column="0" x:Name="ActiveDockBadge" Width="38" Height="38" CornerRadius="19" Background="#257C3AED" Margin="0,0,12,0" VerticalAlignment="Center">
                 <Path x:Name="ActiveDockIcon" Data="{StaticResource IconSend}" Fill="#A855F7" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              </Border>

              <!-- File & Target Info -->
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                 <Grid ColumnDefinitions="Auto, *">
                    <TextBlock x:Name="ActiveDockStatusLabel" Text="TRANSFERRING" FontSize="10" FontWeight="Bold" Foreground="#A855F7" LetterSpacing="0.8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="BottomPlayerFileName" Text="file.zip" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                 </Grid>
                 <TextBlock x:Name="BottomPlayerPeerName" Text="To: Device • Ready" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <!-- Progress & Telemetry -->
              <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4" Margin="0,0,16,0">
                 <Grid ColumnDefinitions="*, Auto">
                    <TextBlock x:Name="BottomPlayerSpeed" Text="0.0 MB/s" FontSize="11" FontWeight="SemiBold" Foreground="#06B6D4"/>
                    <TextBlock Grid.Column="1" x:Name="ActiveDockProgressPct" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                 </Grid>
                 <ProgressBar x:Name="BottomPlayerProgress" Height="5" CornerRadius="2.5" Foreground="#7C3AED" Background="#202538" Value="0"/>
              </StackPanel>

              <!-- Cancel / Abort Button -->
              <Button Grid.Column="3" x:Name="BottomPlayerCancelBtn" Content="Abort" Click="CancelActiveSend_Click" Classes="GhostBtn" Padding="12,6" FontSize="11" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>

              <!-- Optional History Shortcut -->
              <Button Grid.Column="4" Content="History →" Click="NavTransfers_Click" Classes="GhostBtn" Padding="12,6" FontSize="11" VerticalAlignment="Center"/>
           </Grid>
        </Border>
      </Grid>

    </Grid>

    <!-- Hidden compatibility anchors for legacy elements -->
    <Panel IsVisible="False">
       <ToggleSwitch x:Name="ThemeToggle" IsVisible="False"/>
    </Panel>

    <!-- ========================================== -->
    <!-- OVERLAYS & MODALS                          -->
    <!-- ========================================== -->

    <!-- Mutual Connection Request Modal -->
    <Grid x:Name="ConnectionRequestPanel" IsVisible="False" Background="#A0000000" ZIndex="5200">
       <Border Background="#11131C" BorderBrush="#23283E" BorderThickness="1" CornerRadius="16" Padding="32" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 20 60 0 #A0000000">
          <StackPanel Spacing="18">
             <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource BrandGradientHBrush}" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconSend}" Fill="#FFFFFF" Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
             </Border>
             
             <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="INCOMING CONNECTION REQUEST" FontSize="11" FontWeight="Bold" Foreground="#818CF8" LetterSpacing="1" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ConnectionRequestPeerName" Text="Device Name" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock x:Name="ConnectionRequestDetails" Text="PC • 192.168.1.100" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ConnectionRequestRoleDesc" Text="wants to connect with you to share files." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center"/>
             </StackPanel>

             <Grid ColumnDefinitions="*, 14, *">
                <Button Grid.Column="0" Content="Decline" Click="DeclineConnection_Click" Classes="GhostBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" TextElement.Foreground="#EF4444" Padding="14,10"/>
                <Button Grid.Column="2" Content="Accept &amp; Connect" Click="AcceptConnection_Click" Classes="PrimaryBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,10" FontWeight="Bold"/>
             </Grid>
          </StackPanel>
       </Border>
    </Grid>

    <!-- Incoming File Approval Modal -->
    <Grid x:Name="AcceptRejectPanel" IsVisible="False" Background="#A0000000" ZIndex="5000">
       <Border Background="#11131C" BorderBrush="#23283E" BorderThickness="1" CornerRadius="14" Padding="32" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 16 48 0 #80000000">
          <StackPanel Spacing="18">
             <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource BrandGradientHBrush}" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconReceive}" Fill="#FFFFFF" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
             </Border>
             
             <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="INCOMING FILE REQUEST" FontSize="10" FontWeight="Bold" Foreground="#818CF8" LetterSpacing="1" HorizontalAlignment="Center"/>
                <TextBlock x:Name="IncomingFileName" Text="file.zip" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="IncomingPeerName" Text="From: Nearby PC" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                <TextBlock x:Name="IncomingFileSize" Text="0 MB" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
             </StackPanel>

             <Grid ColumnDefinitions="*, 12, *">
                <Button Grid.Column="0" Content="Decline" Click="RejectTransfer_Click" Classes="GhostBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" TextElement.Foreground="#EF4444"/>
                <Button Grid.Column="2" Content="Accept" Click="AcceptTransfer_Click" Classes="PrimaryBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
             </Grid>
          </StackPanel>
       </Border>
    </Grid>

    <!-- 0.1 Batch Manifest Checklist Modal -->
    <Grid x:Name="BatchManifestModal" IsVisible="False" Background="#B0000000" ZIndex="5300">
       <Border Background="#11131C" BorderBrush="#23283E" BorderThickness="1" CornerRadius="16" Padding="28" Width="480" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 20 60 0 #A0000000">
          <Grid RowDefinitions="Auto, 14, Auto, 10, *, 18, Auto">
             <!-- Header with Icon -->
             <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource BrandGradientHBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                   <Path Data="{StaticResource IconReceive}" Fill="#FFFFFF" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                   <TextBlock x:Name="BatchManifestTitle" Text="Incoming Batch (0 Files)" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                   <TextBlock x:Name="BatchManifestSubtitle" Text="From: Device · Total: 0 MB" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
             </Grid>

             <Separator Grid.Row="1" Height="1" Background="#222638"/>

             <!-- Select All Bar -->
             <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" Background="#161824">
                <Border CornerRadius="8" Padding="10,6" Grid.ColumnSpan="3" Background="#161824">
                   <Grid ColumnDefinitions="Auto, *, Auto">
                      <CheckBox x:Name="BatchSelectAllCheckBox" Content="Select All Files" IsChecked="True" Click="BatchSelectAll_Click" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="2" x:Name="BatchManifestSelectedSummary" Text="0 files selected (0 MB)" FontSize="11" Foreground="#818CF8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                   </Grid>
                </Border>
             </Grid>

             <!-- Scrollable Checklist -->
             <Border Grid.Row="4" Background="#0D0F18" BorderBrush="#222638" BorderThickness="1" CornerRadius="8" Padding="6">
                <ScrollViewer MaxHeight="260">
                   <ItemsControl x:Name="BatchManifestList">
                      <ItemsControl.ItemTemplate>
                         <DataTemplate x:DataType="views:BatchCheckItem">
                            <Border Classes="TrackRow" Padding="10,8" Margin="0,2" Background="#141724" CornerRadius="6">
                               <Grid ColumnDefinitions="Auto, *, Auto">
                                  <CheckBox IsChecked="{Binding IsSelected}" Click="BatchItemCheck_Click" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                     <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                     <TextBlock Text="{Binding RelativePath}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                  </StackPanel>
                                  <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="8,0,4,0"/>
                               </Grid>
                            </Border>
                         </DataTemplate>
                      </ItemsControl.ItemTemplate>
                   </ItemsControl>
                </ScrollViewer>
             </Border>

             <!-- Actions -->
             <Grid Grid.Row="6" ColumnDefinitions="*, 14, *">
                <Button Grid.Column="0" Content="Decline All" Click="DeclineBatchManifest_Click" Classes="GhostBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" TextElement.Foreground="#EF4444" Padding="14,10"/>
                <Button Grid.Column="2" x:Name="BatchAcceptBtn" Content="Accept Selected" Click="AcceptBatchManifest_Click" Classes="PrimaryBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,10" FontWeight="Bold"/>
             </Grid>
          </Grid>
       </Border>
    </Grid>

    <!-- 0.2 Celebratory Transfer Success Modal -->
    <Grid x:Name="TransferSuccessModal" IsVisible="False" Background="#B0000000" ZIndex="5400">
       <Border Background="#11131C" BorderBrush="#23283E" BorderThickness="1" CornerRadius="16" Padding="32" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 20 60 0 #A0000000">
          <StackPanel Spacing="16">
             <Border Width="64" Height="64" CornerRadius="32" Background="#1810B981" BorderBrush="#4010B981" BorderThickness="1.5" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconCheck}" Fill="#10B981" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
             </Border>

             <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock x:Name="TransferSuccessTitle" Text="Transfer Completed" FontSize="18" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TransferSuccessSubtitle" Text="All files were delivered successfully." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
             </StackPanel>

             <!-- Transfer Stats Card -->
             <Border Background="#161824" BorderBrush="#222638" BorderThickness="1" CornerRadius="10" Padding="16,12">
                <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto">
                   <TextBlock Grid.Row="0" Grid.Column="0" Text="Transferred Files:" FontSize="12" Foreground="#64748B" Margin="0,3"/>
                   <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TransferSuccessFileCount" Text="0 files" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,3"/>

                   <TextBlock Grid.Row="1" Grid.Column="0" Text="Payload Size:" FontSize="12" Foreground="#64748B" Margin="0,3"/>
                   <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TransferSuccessTotalSize" Text="0 MB" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,3"/>

                   <TextBlock Grid.Row="2" Grid.Column="0" Text="Remote Device:" FontSize="12" Foreground="#64748B" Margin="0,3"/>
                   <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TransferSuccessPeerName" Text="Peer" FontSize="12" FontWeight="Bold" Foreground="#818CF8" Margin="0,3"/>
                </Grid>
             </Border>

             <Grid ColumnDefinitions="*, 12, *">
                <Button Grid.Column="0" Content="Open Downloads" Click="OpenDownloadFolder_Click" Classes="GhostBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,10"/>
                <Button Grid.Column="2" Content="Done" Click="CloseTransferSuccessModal_Click" Classes="PrimaryBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,10" FontWeight="Bold"/>
             </Grid>
          </StackPanel>
       </Border>
    </Grid>

    <!-- 0.3 Peer Resend Request Modal -->
    <Grid x:Name="ResendRequestModal" IsVisible="False" Background="#B0000000" ZIndex="5450">
       <Border Background="#11131C" BorderBrush="#23283E" BorderThickness="1" CornerRadius="16" Padding="28" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 20 60 0 #A0000000">
          <StackPanel Spacing="16">
             <Border Width="56" Height="56" CornerRadius="28" Background="#1806B6D4" BorderBrush="#4006B6D4" BorderThickness="1.5" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconHistory}" Fill="#06B6D4" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
             </Border>

             <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="RESEND REQUEST" FontSize="10" FontWeight="Bold" Foreground="#06B6D4" LetterSpacing="1" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ResendRequestMessage" Text="Peer requested to resend file." FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
             </StackPanel>

             <Grid ColumnDefinitions="*, 12, *">
                <Button Grid.Column="0" Content="Decline" Click="DeclineResendRequest_Click" Classes="GhostBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" TextElement.Foreground="#EF4444" Padding="12,9"/>
                <Button Grid.Column="2" Content="Accept &amp; Resend" Click="AcceptResendRequest_Click" Classes="PrimaryBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,9" FontWeight="Bold"/>
             </Grid>
          </StackPanel>
       </Border>
    </Grid>

    <!-- Manual IP Dialog -->
    <Grid x:Name="ManualIPDialog" IsVisible="False" Background="#A0000000" ZIndex="4500">
       <Border Background="#11131C" BorderBrush="#222638" BorderThickness="1" CornerRadius="12" Padding="24" Width="340" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="14">
             <TextBlock Text="Connect by IP" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
             <TextBox x:Name="ManualIPInput" Watermark="192.168.1.xxx"/>
             <Button Content="Connect" Classes="PrimaryBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
          </StackPanel>
       </Border>
    </Grid>

    <!-- 1. Send Quick Text / Clipboard Modal -->
    <Grid x:Name="QuickTextModal" IsVisible="False" Background="#B0000000" ZIndex="5500">
       <Border Background="#11131C" BorderBrush="#222638" BorderThickness="1" CornerRadius="14" Padding="28" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 16 48 0 #80000000">
          <StackPanel Spacing="16">
             <Grid ColumnDefinitions="*, Auto">
                <StackPanel Spacing="2">
                   <TextBlock Text="SEND QUICK NOTE / TEXT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandVioletBrush}" LetterSpacing="1"/>
                   <TextBlock Text="Send links, snippets, or passwords to nearby devices" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
                <Button Grid.Column="1" Click="CloseQuickText_Click" Background="Transparent" Padding="6,2">
                   <Path Data="{StaticResource IconClose}" Fill="#64748B" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
             </Grid>

             <TextBox x:Name="QuickTextInput" AcceptsReturn="True" TextWrapping="Wrap" Height="130" Watermark="Type or paste any text, URL, code snippet, or note here..."/>

             <Grid ColumnDefinitions="Auto, *, Auto">
                <Button Grid.Column="0" Content="Paste Clipboard" Click="PasteClipboardToText_Click" Classes="GhostBtn" Padding="12,7" FontSize="11"/>
                <Button Grid.Column="2" Content="Send Note →" Click="SendQuickText_Click" Classes="PrimaryBtn" Padding="18,7" FontSize="12" FontWeight="SemiBold"/>
             </Grid>
          </StackPanel>
       </Border>
    </Grid>

    <!-- 2. Received Quick Note / Text Modal -->
    <Grid x:Name="IncomingNoteModal" IsVisible="False" Background="#B0000000" ZIndex="5600">
       <Border Background="#11131C" BorderBrush="#222638" BorderThickness="1" CornerRadius="14" Padding="28" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 16 48 0 #80000000">
          <StackPanel Spacing="16">
             <Grid ColumnDefinitions="*, Auto">
                <StackPanel Spacing="2">
                   <TextBlock Text="QUICK NOTE RECEIVED" FontSize="11" FontWeight="Bold" Foreground="#10B981" LetterSpacing="1"/>
                   <TextBlock x:Name="IncomingNoteSenderText" Text="From: Nearby Device" FontSize="12" Foreground="#94A3B8"/>
                </StackPanel>
                <Button Grid.Column="1" Click="CloseIncomingNote_Click" Background="Transparent" Padding="6,2">
                   <Path Data="{StaticResource IconClose}" Fill="#64748B" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
             </Grid>

             <Border Background="#161824" BorderBrush="#222638" BorderThickness="1" CornerRadius="8" Padding="12" MaxHeight="200">
                <ScrollViewer>
                   <TextBox x:Name="IncomingNoteContentText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" FontSize="13"/>
                </ScrollViewer>
             </Border>

             <Grid ColumnDefinitions="*, 10, Auto">
                <Button Grid.Column="0" Content="Copy to Clipboard" Click="CopyIncomingNote_Click" Classes="PrimaryBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14,8" FontSize="12" FontWeight="SemiBold"/>
                <Button Grid.Column="2" x:Name="IncomingNoteOpenLinkBtn" Content="Open Link" Click="OpenIncomingNoteLink_Click" Classes="GhostBtn" Padding="14,8" FontSize="12" IsVisible="False"/>
             </Grid>
          </StackPanel>
       </Border>
    </Grid>

    <!-- 3. In-App Media & Image Preview Modal -->
    <Grid x:Name="MediaPreviewModal" IsVisible="False" Background="#D0000000" ZIndex="5700">
       <Border Background="#11131C" BorderBrush="#222638" BorderThickness="1" CornerRadius="14" Padding="24" MaxWidth="680" MaxHeight="540" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 16 48 0 #90000000">
          <Grid RowDefinitions="Auto, 14, *, 16, Auto">
             <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                <StackPanel Spacing="2">
                   <TextBlock x:Name="PreviewFileName" Text="image.png" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                   <TextBlock x:Name="PreviewFileSpecs" Text="1920x1080 · 2.4 MB" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
                <Button Grid.Column="1" Click="ClosePreviewModal_Click" Background="Transparent" Padding="6,2">
                   <Path Data="{StaticResource IconClose}" Fill="#64748B" Width="14" Height="14" Stretch="Uniform"/>
                </Button>
             </Grid>

             <!-- Preview Image Viewer -->
             <Border Grid.Row="2" Background="#0C0D14" CornerRadius="8" Padding="8" ClipToBounds="True">
                <Image x:Name="PreviewImageControl" Stretch="Uniform" MaxHeight="360"/>
             </Border>

             <!-- Preview Actions -->
             <Grid Grid.Row="4" ColumnDefinitions="Auto, *, Auto">
                <Button Grid.Column="0" Content="Copy Image to Clipboard" Click="CopyPreviewImage_Click" Classes="PrimaryBtn" Padding="14,8" FontSize="11" FontWeight="SemiBold"/>
                <Button Grid.Column="2" Content="Open in Default App" Click="OpenPreviewInApp_Click" Classes="GhostBtn" Padding="14,8" FontSize="11"/>
             </Grid>
          </Grid>
       </Border>
    </Grid>

    <!-- 4. Edit Device Nickname Modal -->
    <Grid x:Name="EditNicknameModal" IsVisible="False" Background="#B0000000" ZIndex="5800">
       <Border Background="#11131C" BorderBrush="#222638" BorderThickness="1" CornerRadius="12" Padding="24" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 16 48 0 #80000000">
          <StackPanel Spacing="14">
             <TextBlock Text="SET CUSTOM NICKNAME" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrandVioletBrush}" LetterSpacing="1"/>
             <TextBlock Text="Assign a friendly name for this device on your PC:" FontSize="12" Foreground="#94A3B8"/>
             <TextBox x:Name="NicknameInput" Watermark="e.g. Living Room PC, My Phone..."/>
             <Grid ColumnDefinitions="*, 10, *">
                <Button Grid.Column="0" Content="Cancel" Click="CloseNicknameModal_Click" Classes="GhostBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="Save Name" Click="SaveNickname_Click" Classes="PrimaryBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
             </Grid>
          </StackPanel>
       </Border>
    </Grid>

    <!-- 5. First-Run Welcome Device Name Onboarding Modal -->
    <Grid x:Name="FirstRunWelcomeModal" IsVisible="False" Background="#D806080E" ZIndex="5900">
       <Border Background="#11131C" BorderBrush="#23283E" BorderThickness="1" CornerRadius="16" Padding="32" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 24 64 0 #90000000">
          <StackPanel Spacing="18" HorizontalAlignment="Stretch">
             <Border Width="68" Height="68" CornerRadius="34" Background="#161928" BorderBrush="#242B45" BorderThickness="1" HorizontalAlignment="Center" BoxShadow="0 8 28 0 #304F46E5">
                <Image Source="avares://WeShare.UI/Assets/app_logo.png" Width="42" Height="42" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
             </Border>
             <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="Welcome to We Share" FontSize="21" FontWeight="ExtraBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="Instant, high-speed local file sharing with nearby devices." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
             </StackPanel>
             <Border Background="#161928" BorderBrush="#242B45" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,4,0,0">
                <StackPanel Spacing="8">
                   <TextBlock Text="SET YOUR DEVICE NAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandCyanBrush}" LetterSpacing="0.8"/>
                   <TextBlock Text="How your PC will appear to nearby phones, laptops, and web portal users:" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                   <TextBox x:Name="WelcomeDeviceNameInput" MaxLength="32" Watermark="e.g. My PC, Living Room Laptop..." Background="#0C0D15" Foreground="#FFFFFF" BorderBrush="#242B45" BorderThickness="1" CornerRadius="8" Padding="12,10" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
             </Border>
             <Button Content="Continue to We Share →" Click="CompleteOnboarding_Click" Classes="PrimaryBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="44" FontWeight="Bold" FontSize="13" Margin="0,6,0,0"/>
          </StackPanel>
       </Border>
    </Grid>

    <!-- Drag Overlay -->
    <Panel x:Name="DragOverlay" IsVisible="False" Background="#E0090A0F" ZIndex="6000">
       <Border BorderBrush="#3B4261" BorderThickness="2" CornerRadius="16" Margin="28" BoxShadow="0 16 48 0 #60000000">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18">
             <Border Width="90" Height="90" CornerRadius="45" Background="Transparent" HorizontalAlignment="Center" BoxShadow="0 10 32 0 #40000000">
                <Image Source="avares://WeShare.UI/Assets/send.png" Width="90" Height="90" Stretch="Uniform"/>
             </Border>
             <TextBlock Text="Drop files anywhere to send" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
             <TextBlock Text="Supports multiple files and entire folders" FontSize="13" Foreground="#94A3B8"/>
          </StackPanel>
       </Border>
    </Panel>

    <!-- Toast Notification (Top Floating Pill) -->
    <Border x:Name="ToastBorder" IsVisible="False" Background="{StaticResource BrandGradientHBrush}" CornerRadius="20" Padding="18,8" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0" ZIndex="7000" BoxShadow="0 8 24 0 #40000000">
       <TextBlock x:Name="ToastMessage" Text="Action completed" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
    </Border>

    <!-- Hidden compatibility elements -->
    <Border x:Name="BottomNav" IsVisible="False"/>
    <Grid x:Name="SplashGrid" IsVisible="False"/>

  </Grid>
</UserControl>
