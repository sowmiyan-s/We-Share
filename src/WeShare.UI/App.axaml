<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WeShare.UI.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- DARK THEME — Purple/Violet brand palette -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="DeepSlate">#0E0618</Color>
                    <Color x:Key="ElectricIndigo">#9333EA</Color>
                    <Color x:Key="ElectricIndigoDim">#7C3AED</Color>
                    <Color x:Key="TealAccent">#C084FC</Color>
                    <Color x:Key="GlassFill">#120822</Color>
                    <Color x:Key="GlassStroke">#2A1050</Color>
                    <Color x:Key="TextPrimary">#FAF5FF</Color>
                    <Color x:Key="TextSecondary">#B09CC8</Color>
                    <SolidColorBrush x:Key="BaseBackgroundBrush"  Color="#0E0618"/>
                    <SolidColorBrush x:Key="GlassBorderBrush"     Color="#2A1050"/>
                    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#18092E"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush"  Color="#160828"/>
                    <SolidColorBrush x:Key="RadarRingBrush"        Color="#309333EA"/>
                </ResourceDictionary>

                <!-- LIGHT THEME — soft lavender/lilac -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="DeepSlate">#FAF5FF</Color>
                    <Color x:Key="ElectricIndigo">#7C3AED</Color>
                    <Color x:Key="ElectricIndigoDim">#6D28D9</Color>
                    <Color x:Key="TealAccent">#A855F7</Color>
                    <Color x:Key="GlassFill">#F3E8FF</Color>
                    <Color x:Key="GlassStroke">#DDD6FE</Color>
                    <Color x:Key="TextPrimary">#1E0A3C</Color>
                    <Color x:Key="TextSecondary">#6B4FA0</Color>
                    <SolidColorBrush x:Key="BaseBackgroundBrush"  Color="#FAF5FF"/>
                    <SolidColorBrush x:Key="GlassBorderBrush"     Color="#DDD6FE"/>
                    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#F3E8FF"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush"  Color="#EDE9FE"/>
                    <SolidColorBrush x:Key="RadarRingBrush"        Color="#307C3AED"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Color x:Key="ElectricIndigo">#9333EA</Color>
            <Color x:Key="ElectricIndigoDim">#7C3AED</Color>
            <Color x:Key="TealAccent">#C084FC</Color>
            
            <SolidColorBrush x:Key="ElectricIndigoBrush" Color="{DynamicResource ElectricIndigo}"/>
            <SolidColorBrush x:Key="ElectricIndigoDimBrush" Color="{DynamicResource ElectricIndigoDim}"/>
            <SolidColorBrush x:Key="TealSuccessBrush" Color="{DynamicResource TealAccent}"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Radar Pulse Animation -->
        <Style Selector="Ellipse.RadarPulse">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:3" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                        <Setter Property="Opacity"               Value="0.5"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.8"/>
                        <Setter Property="Opacity"               Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Radar Scan Sweep Animation -->
        <Style Selector="Border.RadarScan">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Radar Loader Animation (CSS radar81 equivalent) -->
        <Style Selector="Border.RadarLoader">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Device Node Pulse -->
        <Style Selector="Border.DeviceMarker">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
</Application>
