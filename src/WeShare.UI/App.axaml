<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WeShare.UI.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- PREMIUM DARK THEME — Sleek Charcoal/Indigo palette -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="DeepSlate">#0A0E17</Color>
                    <Color x:Key="ElectricIndigo">#6366F1</Color>
                    <Color x:Key="ElectricIndigoDim">#4F46E5</Color>
                    <Color x:Key="TealAccent">#10B981</Color>
                    <Color x:Key="GlassFill">#111827</Color>
                    <Color x:Key="GlassStroke">#1F2937</Color>
                    <Color x:Key="TextPrimary">#F9FAFB</Color>
                    <Color x:Key="TextSecondary">#9CA3AF</Color>
                    
                    <SolidColorBrush x:Key="BaseBackgroundBrush"  Color="#EB090D16"/> <!-- Translucent slate navy for Mica blur -->
                    <SolidColorBrush x:Key="GlassBorderBrush"     Color="#20FFFFFF"/> <!-- Soft glassy white line -->
                    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#181E293B"/> <!-- Translucent card fill -->
                    <SolidColorBrush x:Key="CardBackgroundBrush"  Color="#4D0F172A"/> <!-- Deeper translucent section fill -->
                    <SolidColorBrush x:Key="RadarRingBrush"        Color="#1A6366F1"/>
                </ResourceDictionary>

                <!-- PREMIUM LIGHT THEME — Elegant Lavender/Indigo palette -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="DeepSlate">#F8FAFC</Color>
                    <Color x:Key="ElectricIndigo">#4F46E5</Color>
                    <Color x:Key="ElectricIndigoDim">#4338CA</Color>
                    <Color x:Key="TealAccent">#0D9488</Color>
                    <Color x:Key="GlassFill">#F1F5F9</Color>
                    <Color x:Key="GlassStroke">#E2E8F0</Color>
                    <Color x:Key="TextPrimary">#0F172A</Color>
                    <Color x:Key="TextSecondary">#64748B</Color>
                    
                    <SolidColorBrush x:Key="BaseBackgroundBrush"  Color="#E6F8FAFC"/> <!-- Translucent cool light slate for Mica blur -->
                    <SolidColorBrush x:Key="GlassBorderBrush"     Color="#120F172A"/> <!-- Soft dark divider line -->
                    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#B3FFFFFF"/> <!-- Translucent light white card fill -->
                    <SolidColorBrush x:Key="CardBackgroundBrush"  Color="#80E2E8F0"/> <!-- Soft gray card fill -->
                    <SolidColorBrush x:Key="RadarRingBrush"        Color="#154F46E5"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Color x:Key="ElectricIndigo">#6366F1</Color>
            <Color x:Key="ElectricIndigoDim">#4F46E5</Color>
            <Color x:Key="TealAccent">#10B981</Color>
            
            <SolidColorBrush x:Key="ElectricIndigoBrush" Color="{DynamicResource ElectricIndigo}"/>
            <SolidColorBrush x:Key="ElectricIndigoDimBrush" Color="{DynamicResource ElectricIndigoDim}"/>
            <SolidColorBrush x:Key="TealSuccessBrush" Color="{DynamicResource TealAccent}"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Concentric Radar Ripple Animation (Wave 1) -->
        <Style Selector="Ellipse.RadarPulse">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:3.5" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                        <Setter Property="Opacity"               Value="0.6"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.8"/>
                        <Setter Property="Opacity"               Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Concentric Radar Ripple Animation (Wave 2 - offset) -->
        <Style Selector="Ellipse.RadarPulseInner">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:3.5" Delay="0:0:1.75" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                        <Setter Property="Opacity"               Value="0.6"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.8"/>
                        <Setter Property="Opacity"               Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Radar Scan Sweep Animation -->
        <Style Selector="Border.RadarScan">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:4" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Active Network Signal Pulse -->
        <Style Selector="Border.NetworkSignalPulse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                        <Setter Property="Opacity"               Value="0.5"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.3"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.3"/>
                        <Setter Property="Opacity"               Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                        <Setter Property="Opacity"               Value="0.5"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Active Web Portal Pulse -->
        <Style Selector="Border.WebPortalPulse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                        <Setter Property="Opacity"               Value="0.5"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.3"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.3"/>
                        <Setter Property="Opacity"               Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                        <Setter Property="Opacity"               Value="0.5"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Device Node Pulse -->
        <Style Selector="Border.DeviceMarker">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:3" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.95"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.95"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.05"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.05"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.95"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.95"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Rounded Global TextBox Styling -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource ElectricIndigoBrush}"/>
            <Setter Property="Background" Value="#086366F1"/>
        </Style>
        
        <!-- ToggleSwitch Modern styling -->
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
        </Style>

        <!-- Rounded ProgressBar styling -->
        <Style Selector="ProgressBar">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#15FFFFFF"/>
        </Style>
    </Application.Styles>
</Application>
