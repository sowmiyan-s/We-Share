<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WeShare.UI.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- DARK THEME -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="DeepSlate">#0f0f15</Color>
                    <Color x:Key="ElectricIndigo">#6366f1</Color>
                    <Color x:Key="ElectricIndigoDim">#4338ca</Color>
                    <Color x:Key="TealAccent">#4fdbc8</Color>
                    <Color x:Key="GlassFill">#0AFFFFFF</Color>
                    <Color x:Key="GlassStroke">#15FFFFFF</Color>
                    <Color x:Key="TextPrimary">#F8FAFC</Color>
                    <Color x:Key="TextSecondary">#94A3B8</Color>
                    <SolidColorBrush x:Key="BaseBackgroundBrush"  Color="#0f0f15"/>
                    <SolidColorBrush x:Key="GlassBorderBrush"     Color="#15FFFFFF"/>
                    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#0AFFFFFF"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush"  Color="#16161e"/>
                    <SolidColorBrush x:Key="RadarRingBrush"        Color="#156366f1"/>
                </ResourceDictionary>

                <!-- LIGHT THEME -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="DeepSlate">#f8fafc</Color>
                    <Color x:Key="ElectricIndigo">#4f46e5</Color>
                    <Color x:Key="ElectricIndigoDim">#3730a3</Color>
                    <Color x:Key="TealAccent">#0d9488</Color>
                    <Color x:Key="GlassFill">#FFFFFF</Color>
                    <Color x:Key="GlassStroke">#E2E8F0</Color>
                    <Color x:Key="TextPrimary">#0F172A</Color>
                    <Color x:Key="TextSecondary">#64748B</Color>
                    <SolidColorBrush x:Key="BaseBackgroundBrush"  Color="#f8fafc"/>
                    <SolidColorBrush x:Key="GlassBorderBrush"     Color="#CBD5E1"/>
                    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush"  Color="#f1f5f9"/>
                    <SolidColorBrush x:Key="RadarRingBrush"        Color="#154f46e5"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Color x:Key="ElectricIndigo">#6366f1</Color>
            <Color x:Key="ElectricIndigoDim">#4338ca</Color>
            <Color x:Key="TealAccent">#4fdbc8</Color>
            
            <SolidColorBrush x:Key="ElectricIndigoBrush" Color="{DynamicResource ElectricIndigo}"/>
            <SolidColorBrush x:Key="ElectricIndigoDimBrush" Color="{DynamicResource ElectricIndigoDim}"/>
            <SolidColorBrush x:Key="TealSuccessBrush" Color="{DynamicResource TealAccent}"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Radar Pulse Animation -->
        <Style Selector="Ellipse.RadarPulse">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:3" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                        <Setter Property="Opacity"               Value="0.5"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.8"/>
                        <Setter Property="Opacity"               Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Radar Scan Sweep Animation -->
        <Style Selector="Border.RadarScan">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Radar Loader Animation (CSS radar81 equivalent) -->
        <Style Selector="Border.RadarLoader">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="75"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Device Node Pulse -->
        <Style Selector="Border.DeviceMarker">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
</Application>
