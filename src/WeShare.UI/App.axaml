<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WeShare.UI.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- SPOTIFY IMMERSIVE DARK THEME -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Core Canvas & Surface -->
                    <Color x:Key="BaseBackground">#121212</Color>
                    <Color x:Key="SurfaceDark">#181818</Color>
                    <Color x:Key="CardDark">#242424</Color>
                    <Color x:Key="CardElevated">#282828</Color>
                    <Color x:Key="CardHover">#2e2e2e</Color>

                    <!-- Spotify Brand Green -->
                    <Color x:Key="SpotifyGreen">#1ED760</Color>
                    <Color x:Key="SpotifyGreenPressed">#1DB954</Color>
                    <Color x:Key="SpotifyGreenHover">#3BE477</Color>
                    <Color x:Key="SpotifyGreenDim">#169C46</Color>

                    <!-- Backward Compatibility Mapping -->
                    <Color x:Key="ElectricIndigo">#1ED760</Color>
                    <Color x:Key="ElectricIndigoDim">#1DB954</Color>
                    <Color x:Key="TealAccent">#1ED760</Color>
                    <Color x:Key="DeepSlate">#121212</Color>
                    <Color x:Key="GlassFill">#181818</Color>
                    <Color x:Key="GlassStroke">#282828</Color>

                    <!-- Typography Palette -->
                    <Color x:Key="TextPrimary">#FFFFFF</Color>
                    <Color x:Key="TextSecondary">#B3B3B3</Color>
                    <Color x:Key="TextMuted">#7C7C7C</Color>
                    <Color x:Key="TextNegative">#F3727F</Color>
                    <Color x:Key="TextWarning">#FFA42B</Color>
                    <Color x:Key="TextAnnouncement">#539DF5</Color>

                    <!-- Brushes -->
                    <SolidColorBrush x:Key="BaseBackgroundBrush"        Color="#121212"/>
                    <SolidColorBrush x:Key="SurfaceBackgroundBrush"     Color="#181818"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush"        Color="#242424"/>
                    <SolidColorBrush x:Key="CardElevatedBrush"          Color="#282828"/>
                    <SolidColorBrush x:Key="CardHoverBrush"             Color="#2E2E2E"/>
                    <SolidColorBrush x:Key="GlassBackgroundBrush"       Color="#181818"/>
                    <SolidColorBrush x:Key="GlassBorderBrush"           Color="#282828"/>
                    <SolidColorBrush x:Key="SolidPanelBackgroundBrush"  Color="#121212"/>
                    <SolidColorBrush x:Key="RadarRingBrush"             Color="#261ED760"/>
                    <SolidColorBrush x:Key="SpotifyGreenBrush"          Color="#1ED760"/>
                    <SolidColorBrush x:Key="SpotifyGreenPressedBrush"   Color="#1DB954"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush"           Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush"         Color="#B3B3B3"/>
                    <SolidColorBrush x:Key="TextMutedBrush"             Color="#7C7C7C"/>
                </ResourceDictionary>

                <!-- SPOTIFY CONTRAST LIGHT THEME -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="BaseBackground">#F4F4F5</Color>
                    <Color x:Key="SurfaceDark">#FFFFFF</Color>
                    <Color x:Key="CardDark">#EAEAEA</Color>
                    <Color x:Key="CardElevated">#DFDFDF</Color>
                    <Color x:Key="CardHover">#D5D5D5</Color>

                    <Color x:Key="SpotifyGreen">#169C46</Color>
                    <Color x:Key="SpotifyGreenPressed">#12823A</Color>
                    <Color x:Key="SpotifyGreenHover">#1ED760</Color>
                    <Color x:Key="SpotifyGreenDim">#0E662C</Color>

                    <Color x:Key="ElectricIndigo">#169C46</Color>
                    <Color x:Key="ElectricIndigoDim">#12823A</Color>
                    <Color x:Key="TealAccent">#169C46</Color>
                    <Color x:Key="DeepSlate">#F4F4F5</Color>
                    <Color x:Key="GlassFill">#FFFFFF</Color>
                    <Color x:Key="GlassStroke">#E0E0E0</Color>

                    <Color x:Key="TextPrimary">#121212</Color>
                    <Color x:Key="TextSecondary">#535353</Color>
                    <Color x:Key="TextMuted">#7C7C7C</Color>
                    <Color x:Key="TextNegative">#D32F2F</Color>
                    <Color x:Key="TextWarning">#ED6C02</Color>
                    <Color x:Key="TextAnnouncement">#0288D1</Color>

                    <SolidColorBrush x:Key="BaseBackgroundBrush"        Color="#F4F4F5"/>
                    <SolidColorBrush x:Key="SurfaceBackgroundBrush"     Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush"        Color="#EAEAEA"/>
                    <SolidColorBrush x:Key="CardElevatedBrush"          Color="#DFDFDF"/>
                    <SolidColorBrush x:Key="CardHoverBrush"             Color="#D5D5D5"/>
                    <SolidColorBrush x:Key="GlassBackgroundBrush"       Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="GlassBorderBrush"           Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="SolidPanelBackgroundBrush"  Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="RadarRingBrush"             Color="#20169C46"/>
                    <SolidColorBrush x:Key="SpotifyGreenBrush"          Color="#169C46"/>
                    <SolidColorBrush x:Key="SpotifyGreenPressedBrush"   Color="#12823A"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush"           Color="#121212"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush"         Color="#535353"/>
                    <SolidColorBrush x:Key="TextMutedBrush"             Color="#7C7C7C"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Global Named Brushes -->
            <SolidColorBrush x:Key="ElectricIndigoBrush" Color="{DynamicResource ElectricIndigo}"/>
            <SolidColorBrush x:Key="ElectricIndigoDimBrush" Color="{DynamicResource ElectricIndigoDim}"/>
            <SolidColorBrush x:Key="TealSuccessBrush" Color="{DynamicResource SpotifyGreen}"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Spotify Radar Concentric Ripple Wave 1 -->
        <Style Selector="Ellipse.RadarPulse">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:3.2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                        <Setter Property="Opacity"               Value="0.45"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.8"/>
                        <Setter Property="Opacity"               Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Spotify Radar Concentric Ripple Wave 2 -->
        <Style Selector="Ellipse.RadarPulseInner">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:3.2" Delay="0:0:1.6" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.9"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.9"/>
                        <Setter Property="Opacity"               Value="0.45"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.8"/>
                        <Setter Property="Opacity"               Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Spotify Radar Scanner Sweep -->
        <Style Selector="Border.RadarScan">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:3.6" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Spotify Active Pulse -->
        <Style Selector="Border.NetworkSignalPulse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#1ED760"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                        <Setter Property="Opacity"               Value="0.5"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.3"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.3"/>
                        <Setter Property="Opacity"               Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                        <Setter Property="Opacity"               Value="0.5"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Web Portal Pulse Indicator -->
        <Style Selector="Border.WebPortalPulse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#1ED760"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                        <Setter Property="Opacity"               Value="0.5"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.3"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.3"/>
                        <Setter Property="Opacity"               Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.8"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.8"/>
                        <Setter Property="Opacity"               Value="0.5"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Spotify Device Marker Node -->
        <Style Selector="Border.DeviceMarker">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:3" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.97"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.97"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.03"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.03"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.97"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.97"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Spotify Pill TextBox Styling -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="9999"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="#1F1F1F"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#242424"/>
        </Style>
        
        <!-- ToggleSwitch Spotify Styling -->
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
        </Style>

        <!-- Spotify Green ProgressBar Styling -->
        <Style Selector="ProgressBar">
            <Setter Property="CornerRadius" Value="9999"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#1ED760"/>
        </Style>

        <!-- Toast Notification Notification -->
        <Style Selector="Border.ToastVisible">
            <Style.Animations>
                <Animation Duration="0:0:0.25" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="-12"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Splash Orbital Dot Animations -->
        <Style Selector="Panel.SplashOrbit1">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:1.8" IterationCount="Infinite" Easing="LinearEasing">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Panel.SplashOrbit2">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:2.8" IterationCount="Infinite" Easing="LinearEasing">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.SplashLogoPulse">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.94"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.94"/>
                        <Setter Property="Opacity" Value="0.85"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.06"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.06"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.94"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.94"/>
                        <Setter Property="Opacity" Value="0.85"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
</Application>
